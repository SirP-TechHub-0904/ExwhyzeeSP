<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - ExwhyzeeSP Master" : "Authentication - ExwhyzeeSP Master Platform")</title>
    
    <!-- Favicon & Touch Icons -->
    <link rel="shortcut icon" type="image/x-icon" href="/img/icon-exwhyzeesp.jpg?v=2" />
    <link rel="icon" type="image/jpeg" href="/img/icon-exwhyzeesp.jpg?v=2" />
    <link rel="apple-touch-icon" href="/img/icon-exwhyzeesp.jpg?v=2" />

    <!-- Google Fonts & Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #0b2239 0%, #173b61 50%, #0369a1 100%);
            --accent-glow: rgba(56, 189, 248, 0.25);
        }
        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background: #070d19;
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow-x: hidden;
            padding: 24px 16px;
            margin: 0;
        }

        /* Ambient Glow Backgrounds */
        .ambient-glow-1 {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(14, 165, 233, 0.15) 0%, rgba(0,0,0,0) 70%);
            top: -100px;
            left: -100px;
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }
        .ambient-glow-2 {
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, rgba(0,0,0,0) 70%);
            bottom: -150px;
            right: -100px;
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
        }

        .auth-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
            padding: 40px 32px;
        }

        .form-control-custom {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #ffffff !important;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }
        .form-control-custom:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
        }
        .form-control-custom::placeholder {
            color: #64748b;
        }

        .input-icon-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 0;
            z-index: 5;
        }
        .input-icon-btn:hover {
            color: #38bdf8;
        }

        .btn-submit-glow {
            background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
            color: #ffffff;
            font-weight: 700;
            padding: 14px;
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.35);
            transition: all 0.2s ease;
        }
        .btn-submit-glow:hover {
            background: linear-gradient(135deg, #0369a1 0%, #1d4ed8 100%);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.5);
            transform: translateY(-1px);
            color: #ffffff;
        }

        .link-custom {
            color: #38bdf8;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .link-custom:hover {
            color: #7dd3fc;
            text-decoration: underline;
        }

        .otp-input {
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: 12px;
            text-align: center;
            border-radius: 14px;
            padding: 14px;
        }
        .otp-input:focus {
            background: #1e293b;
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.25);
            outline: none;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <div class="auth-container">
        <!-- Brand Logo Header -->
        <div class="text-center mb-4">
            <a href="/" class="d-inline-block text-decoration-none">
                <img src="/img/exwhyzeesp-logo.jpg" alt="ExwhyzeeSP Logo" class="img-fluid" style="max-height: 54px; object-fit: contain; border-radius: 8px; box-shadow: 0 8px 25px rgba(0,0,0,0.35);" />
            </a>
        </div>

        @RenderBody()
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
