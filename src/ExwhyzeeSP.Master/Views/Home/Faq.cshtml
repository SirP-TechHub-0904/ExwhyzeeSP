@{
    ViewData["Title"] = "Frequently Asked Questions (FAQs)";
    ViewData["MetaDescription"] = "Find answers to frequently asked questions about Exwhyzee SP features, deployment, pricing models, CBT exams, and technical support.";
    Layout = "_PublicLayout";
}

<!-- Page Header Start -->
<div class="sisf-page-header position-relative">
   <div class="sisf-page-header-image">
      <figure>
         <img src="/assets/images/page-banner.png" alt="Exwhyzee SP FAQs">
      </figure>
   </div>
   <div class="container">
      <div class="row align-items-center">
         <div class="col-lg-12">
            <div class="sisf-page-header-content text-center">
               <h1 class="text-white" data-aos="fade-up">Frequently Asked Questions</h1>
               <ul class="list-unstyled d-flex align-items-center justify-content-center gap-2 m-0" data-aos="fade-up" data-aos-delay="200">
                  <li><a href="/" class="text-white">Home</a></li>
                  <li><span class="text-white">/</span></li>
                  <li class="text-white">FAQs</li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Page Header End -->

<div class="py-5">
   <div class="container py-4">
      <div class="text-center mb-5" data-aos="fade-up">
         <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Got Questions?</span>
         <h2 class="display-6 fw-bold">Everything You Need to Know</h2>
         <p class="text-muted mx-auto" style="max-width: 650px;">Clear answers to common questions about setting up, administering, and billing Exwhyzee SP.</p>
      </div>

      <div class="row justify-content-center">
         <div class="col-lg-10">
            <div class="accordion shadow-sm rounded-4" id="mainFaq">
               <!-- FAQ 1 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq1">
                     <button class="accordion-button fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq1" aria-expanded="true">
                        How long does it take to deploy Exwhyzee SP for our school?
                     </button>
                  </h2>
                  <div id="collapseFaq1" class="accordion-collapse collapse show" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        Initial setup takes less than 24 to 48 hours. Our deployment specialists help import your existing student bio-data, class lists, and fee structures from Excel or legacy systems, ensuring zero downtime.
                     </div>
                  </div>
               </div>

               <!-- FAQ 2 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq2">
                     <button class="accordion-button collapsed fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq2">
                        Can we customize the grading scale and report card format?
                     </button>
                  </h2>
                  <div id="collapseFaq2" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        Yes. Exwhyzee SP is fully configurable for Nigerian (WAEC/NECO/Universal Basic Education), British, Montessori, and international dual curriculums. You can set custom CA weights (e.g. 20% + 20% + 60% or 30% + 70%), grading remarks, principal signatures, and school stamps.
                     </div>
                  </div>
               </div>

               <!-- FAQ 3 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq3">
                     <button class="accordion-button collapsed fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq3">
                        How does the Online Admission &amp; Screening Portal work?
                     </button>
                  </h2>
                  <div id="collapseFaq3" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        Prospective students and parents can visit your portal, fill out online application forms, upload credentials, take an online CBT screening exam, pay application/acceptance fees, and print official admission offer letters with auto-assigned matriculation IDs.
                     </div>
                  </div>
               </div>

               <!-- FAQ 4 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq4">
                     <button class="accordion-button collapsed fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq4">
                        What pricing models are available?
                     </button>
                  </h2>
                  <div id="collapseFaq4" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        We offer <strong>Pay Per Student / Term</strong>, <strong>Pay Per Class / Term</strong>, <strong>Pay Per Student / Year</strong>, <strong>Pay Per Class / Year</strong>, and <strong>Digital Scratch Card / PIN Result Checking</strong> revenue-sharing models. All packages are customizable based on your school's unique student population and feature needs.
                     </div>
                  </div>
               </div>

               <!-- FAQ 5 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq5">
                     <button class="accordion-button collapsed fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq5">
                        Is our school's data safe and backed up?
                     </button>
                  </h2>
                  <div id="collapseFaq5" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        Yes! Exwhyzee SP uses enterprise-grade cloud database hosting with automated daily snapshots, bank-level SSL encryption, device IP authorization, and strict role-based access control.
                     </div>
                  </div>
               </div>

               <!-- FAQ 6 -->
               <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                  <h2 class="accordion-header" id="faq6">
                     <button class="accordion-button collapsed fw-bold fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq6">
                        Do you provide teacher and staff training?
                     </button>
                  </h2>
                  <div id="collapseFaq6" class="accordion-collapse collapse" data-bs-parent="#mainFaq">
                     <div class="accordion-body text-muted">
                        Yes. We provide comprehensive hands-on training sessions (virtual or on-site) for your administrators, class teachers, subject teachers, and bursars, alongside 24/7 technical help desk support.
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>

      <div class="text-center mt-5" data-aos="fade-up">
         <p class="text-muted">Have a question not answered here?</p>
         <a href="/Contact" class="sis-btn-default shadow-none">Contact Our Support Team <i class="fa-solid fa-arrow-right-long"></i></a>
      </div>
   </div>
</div>
