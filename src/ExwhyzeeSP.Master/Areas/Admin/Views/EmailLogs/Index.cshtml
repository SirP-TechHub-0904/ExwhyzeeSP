@model List<ExwhyzeeSP.Core.Models.MasterEmailLog>
@{
    ViewData["Title"] = "Email Logs & Outbox Dump";
    var categories = ViewBag.AvailableCategories as List<string> ?? new List<string>();
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Email Delivery Logs &amp; Outbox Dump</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Inspect all outgoing platform notifications, school onboarding invitations, billing receipts, and password reset dispatches.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <button type="button" class="btn btn-outline border-rose-500/30 text-rose-600 hover:bg-rose-500/10 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#purgeEmailsModal">
                <i class="icon-trash-2 text-[14px]"></i>
                <span>Clear Old Emails</span>
            </button>
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-4 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            <div class="lg:col-span-4">
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-1.5 text-xs text-[var(--text-primary)]" placeholder="Search recipient, subject, sender..." />
            </div>
            <div class="lg:col-span-3">
                <select name="categoryFilter" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-1.5 text-xs text-[var(--text-primary)]">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(ViewBag.CategoryFilter == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="lg:col-span-2">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-1.5 text-xs text-[var(--text-primary)]" title="From Date" />
            </div>
            <div class="lg:col-span-2">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-1.5 text-xs text-[var(--text-primary)]" title="To Date" />
            </div>
            <div class="lg:col-span-1 flex items-center gap-1">
                <button type="submit" class="btn btn-primary text-xs font-semibold px-3 py-1.5 rounded-lg w-full">Filter</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchString) || !string.IsNullOrWhiteSpace(ViewBag.CategoryFilter))
                {
                    <a asp-action="Index" class="btn btn-outline border-secondary text-xs px-2 py-1.5 rounded-lg text-decoration-none" title="Reset">✕</a>
                }
            </div>
        </form>
    </div>

    <!-- Email Logs Table -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
            <h3 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                <i class="icon-mail text-[16px] text-[var(--color-primary-600)]"></i>
                <span>Email Outbox Records (@totalCount.ToString("N0") Total)</span>
            </h3>
            <span class="text-xs text-[var(--text-tertiary)]">Page @currentPage of @totalPages</span>
        </div>

        <div class="overflow-x-auto">
            <table class="table table-hover align-middle mb-0 w-full text-xs">
                <thead>
                    <tr class="border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-tertiary)] uppercase font-semibold text-[11px] tracking-wider">
                        <th class="px-4 py-3 text-start">Date &amp; Time</th>
                        <th class="px-4 py-3 text-start">Recipient</th>
                        <th class="px-4 py-3 text-start">Subject</th>
                        <th class="px-4 py-3 text-start">Category</th>
                        <th class="px-4 py-3 text-start">Status</th>
                        <th class="px-4 py-3 text-start">Triggered By</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-subtle)]">
                    @if (Model.Any())
                    {
                        @foreach (var email in Model)
                        {
                            <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors">
                                <td class="px-4 py-3 font-mono text-[var(--text-tertiary)]">@email.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-4 py-3">
                                    <div class="font-bold text-[var(--text-primary)]">@email.RecipientEmail</div>
                                    @if (!string.IsNullOrWhiteSpace(email.RecipientName))
                                    {
                                        <span class="text-[11px] text-[var(--text-tertiary)] block">@email.RecipientName</span>
                                    }
                                </td>
                                <td class="px-4 py-3 font-medium text-[var(--text-primary)] max-w-sm">
                                    <span>@email.Subject</span>
                                    @if (!string.IsNullOrWhiteSpace(email.TenantSubDomain))
                                    {
                                        <span class="inline-block px-1.5 py-0.5 rounded text-[10.5px] font-mono bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--color-primary-600)] ms-1">@email.TenantSubDomain</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
                                        @email.EmailCategory
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                                        <i class="icon-check text-[11px]"></i> @email.Status
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-[var(--text-secondary)]">@(email.TriggeredBy ?? "Automated System")</td>
                                <td class="px-4 py-3 text-end">
                                    <button type="button" class="btn btn-outline border-secondary text-xs px-2.5 py-1 rounded-lg inline-flex items-center gap-1" onclick="previewEmail(@email.Id, '@email.Subject')">
                                        <i class="icon-eye text-[13px]"></i>
                                        <span>Preview</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-8 text-[var(--text-tertiary)]">No emails recorded in the outbox dump yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (totalPages > 1 || totalCount > 0)
        {
            var searchStr = ViewBag.SearchString as string;
            var catFilter = ViewBag.CategoryFilter as string;
            var fDate = ViewBag.FromDate as string;
            var tDate = ViewBag.ToDate as string;
            var startItem = totalCount == 0 ? 0 : (currentPage - 1) * 50 + 1;
            var endItem = Math.Min(currentPage * 50, totalCount);

            <div class="p-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/50 dark:bg-slate-900/50">
                <div class="text-xs text-[var(--text-secondary)]">
                    Showing <strong class="text-[var(--text-primary)] font-semibold">@startItem</strong> to <strong class="text-[var(--text-primary)] font-semibold">@endItem</strong> of <strong class="text-[var(--text-primary)] font-semibold">@totalCount</strong> email records
                </div>

                @if (totalPages > 1)
                {
                    <div class="flex items-center gap-1.5">
                        <!-- First Page -->
                        <a asp-action="Index" asp-route-page="1" asp-route-searchString="@searchStr" asp-route-categoryFilter="@catFilter" asp-route-fromDate="@fDate" asp-route-toDate="@tDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="First Page">
                            <i class="icon-chevrons-left text-[14px]"></i>
                        </a>

                        <!-- Previous Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@searchStr" asp-route-categoryFilter="@catFilter" asp-route-fromDate="@fDate" asp-route-toDate="@tDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="Previous Page">
                            <i class="icon-chevron-left text-[14px]"></i>
                        </a>

                        <!-- Page Number Range -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a asp-action="Index" asp-route-page="@p" asp-route-searchString="@searchStr" asp-route-categoryFilter="@catFilter" asp-route-fromDate="@fDate" asp-route-toDate="@tDate" class="grid place-items-center min-w-8 h-8 px-2 rounded-lg text-xs font-semibold text-decoration-none transition-colors @(p == currentPage ? "bg-sky-600 text-white shadow-sm" : "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700")">
                                @p
                            </a>
                        }

                        <!-- Next Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@searchStr" asp-route-categoryFilter="@catFilter" asp-route-fromDate="@fDate" asp-route-toDate="@tDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Next Page">
                            <i class="icon-chevron-right text-[14px]"></i>
                        </a>

                        <!-- Last Page -->
                        <a asp-action="Index" asp-route-page="@totalPages" asp-route-searchString="@searchStr" asp-route-categoryFilter="@catFilter" asp-route-fromDate="@fDate" asp-route-toDate="@tDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Last Page">
                            <i class="icon-chevrons-right text-[14px]"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Email Preview Modal -->
<div class="modal fade" id="emailPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-2xl overflow-hidden">
            <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <h5 class="text-sm font-bold text-[var(--text-primary)]" id="emailModalTitle">Email Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="p-0 bg-slate-100 dark:bg-slate-900">
                <iframe id="emailPreviewFrame" src="" style="width: 100%; height: 550px; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Purge Emails Modal -->
<div class="modal fade" id="purgeEmailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-2xl overflow-hidden">
            <form asp-action="Purge" method="post">
                @Html.AntiForgeryToken()
                <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                    <h5 class="text-sm font-bold text-rose-600 flex items-center gap-1.5">
                        <i class="icon-trash-2 text-[16px]"></i>
                        <span>Clear Old Email Outbox Logs</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="p-5 space-y-4">
                    <p class="text-xs text-[var(--text-secondary)]">
                        Purging will permanently clear email dump records older than the selected retention window.
                    </p>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Retention Cutoff</label>
                        <select name="daysOlderThan" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-2 text-xs">
                            <option value="30">Older than 30 Days</option>
                            <option value="60">Older than 60 Days</option>
                            <option value="90" selected>Older than 90 Days</option>
                            <option value="180">Older than 180 Days (6 Months)</option>
                            <option value="365">Older than 1 Year</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Type <span class="text-rose-600">PURGE</span> to confirm</label>
                        <input type="text" name="confirmText" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-2 text-xs" placeholder="PURGE" required />
                    </div>
                </div>
                <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex items-center justify-end gap-2.5">
                    <button type="button" class="btn btn-outline border-secondary text-xs px-3 py-1.5 rounded-lg" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger text-xs font-semibold px-4 py-1.5 rounded-lg">Permanently Purge Emails</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function previewEmail(id, subject) {
        document.getElementById('emailModalTitle').innerText = subject;
        document.getElementById('emailPreviewFrame').src = `/EmailLogs/Preview/${id}`;
        new bootstrap.Modal(document.getElementById('emailPreviewModal')).show();
    }
</script>
}
