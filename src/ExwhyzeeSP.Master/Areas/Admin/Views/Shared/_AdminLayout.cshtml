    <script src="https://cdn.jsdelivr.net/npm/preline@2.7.0/dist/preline.min.js"></script>

    <!-- Comprehensive UI Interaction Controller for Dreams Core -->
    <script>
        (function() {
            function initializeAppInteractions() {
                const shell = document.getElementById('appShell');
                const sidebar = document.getElementById('appSidebar');
                const collapseBtn = document.getElementById('sidebarCollapseBtn');
                const topbarToggleBtn = document.getElementById('topbarSidebarToggle');
                const mobileBtn = document.getElementById('mobileSidebarBtn');
                const backdrop = document.getElementById('sidebarMobileBackdrop');
                const storageKey = 'dreamscore-sidebar-collapsed';

                // 1. Sidebar Collapse (Desktop)
                function toggleDesktopSidebar() {
                    if (!shell) return;
                    shell.classList.toggle('is-collapsed');
                    const isCollapsed = shell.classList.contains('is-collapsed');
                    localStorage.setItem(storageKey, isCollapsed ? '1' : '0');
                }

                if (localStorage.getItem(storageKey) === '1' && shell) {
                    shell.classList.add('is-collapsed');
                }

                collapseBtn?.addEventListener('click', function(e) {
                    e.preventDefault();
                    toggleDesktopSidebar();
                });

                topbarToggleBtn?.addEventListener('click', function(e) {
                    e.preventDefault();
                    toggleDesktopSidebar();
                });

                // 2. Mobile Sidebar Drawer
                mobileBtn?.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    sidebar?.classList.toggle('is-mobile-open');
                    backdrop?.classList.toggle('is-active');
                });

                backdrop?.addEventListener('click', function() {
                    sidebar?.classList.remove('is-mobile-open');
                    backdrop?.classList.remove('is-active');
                });

                // 3. Universal Event Delegation for Submenus, Dropdowns, Theme, and Modals
                document.addEventListener('click', function(e) {
                    // A. Sidebar Submenu Toggle (Marketing Hub, etc.)
                    const submenuToggle = e.target.closest('[data-submenu-toggle], .has-submenu > .sidebar-link, .has-submenu > button');
                    if (submenuToggle) {
                        e.preventDefault();
                        e.stopPropagation();
                        const parentLi = submenuToggle.closest('li.has-submenu');
                        if (parentLi) {
                            parentLi.classList.toggle('is-open');
                            parentLi.classList.toggle('open');
                        }
                        return;
                    }

                    // B. Dropdown Toggle System (.hs-dropdown-toggle)
                    const dropdownToggle = e.target.closest('.hs-dropdown-toggle');
                    if (dropdownToggle) {
                        e.preventDefault();
                        e.stopPropagation();
                        const dropdown = dropdownToggle.closest('.hs-dropdown');
                        if (dropdown) {
                            const menu = dropdown.querySelector('.hs-dropdown-menu');
                            const isOpen = dropdown.classList.contains('open') || dropdown.classList.contains('is-open');

                            // Close all other dropdowns
                            document.querySelectorAll('.hs-dropdown').forEach(d => {
                                if (d !== dropdown) {
                                    d.classList.remove('open', 'is-open');
                                    const m = d.querySelector('.hs-dropdown-menu');
                                    if (m) {
                                        m.classList.add('hidden');
                                        m.style.display = 'none';
                                    }
                                }
                            });

                            if (isOpen) {
                                dropdown.classList.remove('open', 'is-open');
                                if (menu) {
                                    menu.classList.add('hidden');
                                    menu.style.display = 'none';
                                }
                            } else {
                                dropdown.classList.add('open', 'is-open');
                                if (menu) {
                                    menu.classList.remove('hidden');
                                    menu.style.display = 'block';
                                }
                            }
                        }
                        return;
                    }

                    // C. Theme Switcher Option
                    const themeBtn = e.target.closest('[data-theme-set]');
                    if (themeBtn) {
                        e.preventDefault();
                        e.stopPropagation();
                        const theme = themeBtn.getAttribute('data-theme-set');
                        localStorage.setItem('dreamscore-theme', theme);
                        applyTheme(theme);
                        const dropdown = themeBtn.closest('.hs-dropdown');
                        if (dropdown) {
                            dropdown.classList.remove('open', 'is-open');
                            const menu = dropdown.querySelector('.hs-dropdown-menu');
                            if (menu) {
                                menu.classList.add('hidden');
                                menu.style.display = 'none';
                            }
                        }
                        return;
                    }

                    // D. Click outside to close any open dropdown
                    if (!e.target.closest('.hs-dropdown')) {
                        document.querySelectorAll('.hs-dropdown').forEach(dropdown => {
                            dropdown.classList.remove('open', 'is-open');
                            const menu = dropdown.querySelector('.hs-dropdown-menu');
                            if (menu) {
                                menu.classList.add('hidden');
                                menu.style.display = 'none';
                            }
                        });
                    }
                });

                // 4. Theme Initialization
                const savedTheme = localStorage.getItem('dreamscore-theme') || 'system';
                applyTheme(savedTheme);

                function applyTheme(theme) {
                    const root = document.documentElement;
                    const themeIcon = document.getElementById('themeIcon');
                    if (theme === 'dark') {
                        root.classList.add('dark');
                        root.setAttribute('data-theme', 'dark');
                        if (themeIcon) {
                            themeIcon.className = 'icon-moon text-[14px]';
                        }
                    } else if (theme === 'light') {
                        root.classList.remove('dark');
                        root.setAttribute('data-theme', 'light');
                        if (themeIcon) {
                            themeIcon.className = 'icon-sun-medium text-[14px]';
                        }
                    } else {
                        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        if (prefersDark) {
                            root.classList.add('dark');
                            root.setAttribute('data-theme', 'dark');
                            if (themeIcon) themeIcon.className = 'icon-moon text-[14px]';
                        } else {
                            root.classList.remove('dark');
                            root.setAttribute('data-theme', 'light');
                            if (themeIcon) themeIcon.className = 'icon-sun-medium text-[14px]';
                        }
                    }
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializeAppInteractions);
            } else {
                initializeAppInteractions();
            }
        })();
    </script>

    <!-- Interactive Tour Guide Engine -->
    <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js"></script>
    <script src="/js/portal-tour.js?v=1"></script>

    @await RenderSectionAsync("Scripts", required: false)
