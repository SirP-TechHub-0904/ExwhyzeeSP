# ==============================================================================
# ExwhyzeeSP Master Admin Hub Configuration (.env)
# ==============================================================================

# Master Database Connection (Where TenantSchools table is stored)
MASTER_DB_CONNECTION="Server=JSS\SQLEXPRESS;Database=ExwhyzeeSP_MasterDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# Platform Root Domain for Subdomains
PLATFORM_ROOT_DOMAIN="exwhyzee.ng"

# SQL Server Auto-Provisioning Defaults (Used when creating new school databases & users)
SQL_SERVER_HOST="JSS\SQLEXPRESS"
SQL_SERVER_PORT="1433"
SQL_ADMIN_USER="sa"
SQL_ADMIN_PASSWORD=""
SQL_USE_INTEGRATED_SECURITY="true"

# Master Portal Superadmin
MASTER_ADMIN_EMAIL="superadmin@exwhyzee.ng"
MASTER_ADMIN_DEFAULT_PASSWORD="SuperSecretAdminPass123!"
