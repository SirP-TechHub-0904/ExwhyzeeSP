@using Microsoft.AspNetCore.Identity
@using ExwhyzeeSP.Core.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject UserManager<MasterAdminUser> UserManager
@{
    var routeArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    
    var userPrincipal = HttpContextAccessor.HttpContext?.User;
    var userEmail = userPrincipal?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? (userPrincipal?.Identity?.Name ?? "superadmin@exwhyzee.ng");
    
    var isSuperAdmin = userPrincipal?.IsInRole(MasterRoles.SuperAdmin) == true;
    var isAdmin = userPrincipal?.IsInRole(MasterRoles.Admin) == true;
    var isAccountant = userPrincipal?.IsInRole(MasterRoles.Accountant) == true;
    var isContentManager = userPrincipal?.IsInRole(MasterRoles.ContentManager) == true;
    var isReadOnly = userPrincipal?.IsInRole(MasterRoles.ReadOnly) == true;

    var userRole = isSuperAdmin ? MasterRoles.SuperAdmin :
                   isAdmin ? MasterRoles.Admin :
                   isAccountant ? MasterRoles.Accountant :
                   isContentManager ? MasterRoles.ContentManager :
                   isReadOnly ? MasterRoles.ReadOnly : "Staff";

    string firstName = "SuperAdmin";
    if (userPrincipal?.Identity?.IsAuthenticated == true)
    {
        var dbUser = await UserManager.GetUserAsync(userPrincipal);
        if (!string.IsNullOrWhiteSpace(dbUser?.FullName))
        {
            firstName = dbUser.FullName.Trim().Split(' ')[0];
        }
        else
        {
            var raw = userPrincipal.Identity?.Name ?? "Admin";
            firstName = raw.Contains('@') ? raw.Split('@')[0] : raw.Split(' ')[0];
        }
    }
    if (!string.IsNullOrEmpty(firstName))
    {
        firstName = char.ToUpper(firstName[0]) + firstName.Substring(1);
    }
}
