# ==============================================================================
# ExwhyzeeSP Web Portal (.env)
# ==============================================================================

# Master Database Connection (Used by Web middleware to resolve school subdomains)
MASTER_DB_CONNECTION="Server=JSS\SQLEXPRESS;Database=ExwhyzeeSP_MasterDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# Platform Root Domain for Subdomain Matching
PLATFORM_ROOT_DOMAIN="exwhyzee.ng"

# Storage Settings (Local or Cloud)
STORAGE_PROVIDER="Local"
LOCAL_STORAGE_PATH="wwwroot/uploads"

# Email Gateway / Notifications (Optional school-wide fallback)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="notifications@exwhyzee.ng"
