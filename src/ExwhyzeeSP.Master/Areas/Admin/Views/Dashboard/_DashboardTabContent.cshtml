                    <span>View More Guides (@Model.TotalKb)</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- Content Card 2: Blog News Posts -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 grid place-items-center text-xs font-bold">2</span>
                        Recent News Posts
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Published press and blog articles.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentBlogs.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No blog posts found.</div>
                }
                else
                {
                    @foreach (var b in Model.RecentBlogs)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Edit" asp-route-id="@b.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-indigo-600 truncate block text-decoration-none">
                                    @b.Title
                                </a>
                                <span class="text-[11px] text-[var(--text-tertiary)] block">@b.Date.ToString("MMM dd, yyyy")</span>
                            </div>
                            <i class="icon-newspaper text-[13px] text-[var(--text-tertiary)]"></i>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Articles (@Model.TotalBlogs)</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- Content Card 3: Recent Audit Logs -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center text-xs font-bold">3</span>
                        System Audit Activities
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Security and administrative actions.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentAudits.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No audit entries logged yet.</div>
                }
                else
                {
                    @foreach (var a in Model.RecentAudits)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <span class="text-xs font-semibold text-[var(--text-primary)] truncate block">@a.Action</span>
                                <span class="text-[11px] text-[var(--text-tertiary)] block">@a.UserName &bull; @a.TimestampUtc.ToString("HH:mm:ss")</span>
                            </div>
                            <span class="badge-soft badge-secondary text-[10px] shrink-0">@a.IpAddress</span>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-controller="Account" asp-action="ActivityLog" asp-area="" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Audit Logs</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>
    }

</div>

<!-- Hidden payload for chart rendering -->
<script id="chartConfigPayload" type="application/json">
{
    "labels": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
    "values1": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues1)),
    "values2": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues2)),
    "series1": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartSeriesName1)),
    "series2": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartSeriesName2)),
    "donutLabels": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DonutLabels)),
    "donutValues": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DonutValues))
}
</script>
