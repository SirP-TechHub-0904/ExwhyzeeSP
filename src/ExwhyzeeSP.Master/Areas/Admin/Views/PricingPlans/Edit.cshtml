@model ExwhyzeeSP.Core.Models.MasterPricingPlan
@{
    ViewData["Title"] = $"Edit Pricing Plan - {Model.Name}";
    Layout = "_AdminLayout";
}

<div class="space-y-4">

    <!-- ============ Hero Header (Dreams Core Profile Style) ============ -->
    <div class="surface-card p-5 lg:p-6 animate-rise-in">
        <div class="flex flex-wrap items-start justify-between gap-5 w-full">
            <div class="flex items-start gap-4">
                <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Pricing Plans">
                    <i class="icon-arrow-left text-[16px]"></i>
                </a>

                <div class="relative shrink-0 size-16 rounded-2xl bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center border border-[var(--color-primary-500)]/20 shadow-xs">
                    <i class="icon-tag text-[28px]"></i>
                </div>

                <div class="pt-0.5">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Edit: @Model.Name</h1>
                        @if (Model.IsActive)
                        {
                            <span class="badge-soft badge-success">
                                <i class="icon-circle-check text-[9px]"></i> Active
                            </span>
                        }
                        else
                        {
                            <span class="badge-soft badge-danger">
                                <i class="icon-circle-x text-[9px]"></i> Hidden
                            </span>
                        }
                    </div>
                    
                    <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1">
                        Modify subscription tier parameters, pricing rates, billing cadence, and bullet features.
                    </p>
                </div>
            </div>

            <!-- Action buttons on far right -->
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-arrow-left text-[14px]"></i>
                    <span>Back to Plans</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ============ Form ============ -->
    <form asp-action="Edit" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs font-medium text-rose-600 dark:text-rose-400"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Form Column -->
            <div class="lg:col-span-8 space-y-6">

                <!-- Plan Information -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-tag text-[15px] text-[var(--color-primary-500)]"></i>
                        Plan Configuration
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="sm:col-span-2">
                            <label asp-for="Name" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Plan Name *</label>
                            <input asp-for="Name" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" required />
                            <span asp-validation-for="Name" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="PriceText" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Price Display Text *</label>
                            <input asp-for="PriceText" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-bold text-[var(--color-primary-600)]" required />
                            <span asp-validation-for="PriceText" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="BillingCycle" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Billing Cycle *</label>
                            <input asp-for="BillingCycle" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" required />
                            <span asp-validation-for="BillingCycle" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Subtitle" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Subtitle / Tagline</label>
                            <input asp-for="Subtitle" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="Subtitle" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="BadgeText" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Badge Highlight (Optional)</label>
                            <input asp-for="BadgeText" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="BadgeText" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Description" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Plan Overview Description</label>
                            <textarea asp-for="Description" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Features" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Feature Bullet Points (One per line)</label>
                            <textarea asp-for="Features" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono text-[var(--text-primary)]" rows="6"></textarea>
                            <span class="text-[11px] text-[var(--text-tertiary)] block mt-1">Each row is automatically formatted with a checkmark on the public pricing cards.</span>
                            <span asp-validation-for="Features" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ButtonText" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Call to Action Button Text</label>
                            <input asp-for="ButtonText" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="ButtonText" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ButtonUrl" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Call to Action URL</label>
                            <input asp-for="ButtonUrl" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="ButtonUrl" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Settings & Submit -->
            <div class="lg:col-span-4 space-y-6">

                <!-- Display Settings -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-sliders text-[15px] text-[var(--color-primary-500)]"></i>
                        Display Settings
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="SortOrder" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Display Sort Order</label>
                            <input asp-for="SortOrder" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" type="number" />
                            <span asp-validation-for="SortOrder" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] space-y-3">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input asp-for="IsPopular" type="checkbox" class="form-checkbox rounded text-[var(--color-primary-500)] size-4" />
                                <span class="text-xs font-semibold text-[var(--text-primary)]">Featured "Most Popular"</span>
                            </label>
                            <p class="text-[11px] text-[var(--text-tertiary)] pl-6.5">Highlights this card with distinct border and special badge on the website.</p>
                        </div>

                        <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] space-y-3">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input asp-for="IsActive" type="checkbox" class="form-checkbox rounded text-[var(--color-primary-500)] size-4" />
                                <span class="text-xs font-semibold text-[var(--text-primary)]">Active &amp; Published</span>
                            </label>
                            <p class="text-[11px] text-[var(--text-tertiary)] pl-6.5">Controls public visibility on the pricing and plans page.</p>
                        </div>
                    </div>
                </div>

                <!-- Form Action Card -->
                <div class="surface-card p-5 space-y-3">
                    <button type="submit" class="btn btn-primary w-full py-2.5 text-xs font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                        <i class="icon-check text-[15px]"></i>
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline border-secondary w-full py-2 text-xs font-semibold rounded-lg text-center flex items-center justify-center gap-1.5 text-decoration-none">
                        <i class="icon-arrow-left text-[13px]"></i>
                        <span>Cancel</span>
                    </a>
                </div>

            </div>

        </div>
    </form>
</div>
