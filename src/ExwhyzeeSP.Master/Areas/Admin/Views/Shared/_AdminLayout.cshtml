                        <li>
                            <a asp-area="Admin" asp-controller="KnowledgeBaseAdmin" asp-action="Index" class="sidebar-link @(routeController == "KnowledgeBaseAdmin" ? "nav-item-active is-active" : "")">
                                <i class="icon-book-open text-[16px]"></i>
                                <span class="sidebar-label">Knowledge Guides</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="sidebar-link @(routeController == "BlogPosts" ? "nav-item-active is-active" : "")">
                                <i class="icon-newspaper text-[16px]"></i>
                                <span class="sidebar-label">News &amp; Blog Posts</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="Testimonies" asp-action="Index" class="sidebar-link @(routeController == "Testimonies" ? "nav-item-active is-active" : "")">
                                <i class="icon-message-square-quote text-[16px]"></i>
                                <span class="sidebar-label">Testimonials</span>
                            </a>
                        </li>

                        <li>
                            <a asp-area="Admin" asp-controller="CmsPages" asp-action="Index" class="sidebar-link @(routeController == "CmsPages" ? "nav-item-active is-active" : "")">
                                <i class="icon-file-text text-[16px]"></i>
                                <span class="sidebar-label">Policy &amp; Legal CMS</span>
                            </a>
                        </li>
                    }

                    <!-- SECURITY & AUDIT -->
                    @if (isSuperAdmin || isAdmin || isContentManager)
                    {
                        <li class="sidebar-group-title text-uppercase">Security &amp; System</li>

                        @if (isSuperAdmin || isAdmin)
                        {
                            <li>
                                <a asp-controller="Account" asp-action="ActivityLog" asp-area="" class="sidebar-link @(routeController == "Account" && routeAction == "ActivityLog" ? "nav-item-active is-active" : "")">
                                    <i class="icon-shield-check text-[16px]"></i>
                                    <span class="sidebar-label">Audit &amp; SSO Logs</span>
                                </a>
                            </li>
                        }

                        <li>
                            <a asp-area="Admin" asp-controller="EmailLogs" asp-action="Index" class="sidebar-link @(routeController == "EmailLogs" ? "nav-item-active is-active" : "")">
