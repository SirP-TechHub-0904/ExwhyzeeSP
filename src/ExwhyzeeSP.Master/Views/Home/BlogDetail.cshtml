@model ExwhyzeeSP.Core.Models.Blog
@{
    ViewData["Title"] = Model.Title;
    Layout = "_PublicLayout";
    var related = ViewBag.RelatedBlogs as IEnumerable<ExwhyzeeSP.Core.Models.Blog>;
    var categories = ViewBag.Categories as IEnumerable<ExwhyzeeSP.Core.Models.BlogCategory>;
    var currentUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path;
    var encodedUrl = System.Net.WebUtility.UrlEncode(currentUrl);
    var encodedTitle = System.Net.WebUtility.UrlEncode(Model.Title);
}

@section MetaTags {
    <!-- Open Graph / Social Sharing Meta -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@Model.Title | Exwhyzee SP" />
    <meta property="og:description" content="@Model.Description" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:image" content="@(Model.ImageUrl?.StartsWith("http") == true ? Model.ImageUrl : (Context.Request.Scheme + "://" + Context.Request.Host + (Model.ImageUrl ?? "/assets/images/hero-students.jpg")))" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="article:published_time" content="@Model.Date.ToString("yyyy-MM-ddTHH:mm:ssZ")" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Title | Exwhyzee SP" />
    <meta name="twitter:description" content="@Model.Description" />
    <meta name="twitter:image" content="@(Model.ImageUrl?.StartsWith("http") == true ? Model.ImageUrl : (Context.Request.Scheme + "://" + Context.Request.Host + (Model.ImageUrl ?? "/assets/images/hero-students.jpg")))" />
}

<!-- Page Banner -->
<section class="page-banner" style="background: linear-gradient(rgba(10, 24, 50, 0.88), rgba(10, 24, 50, 0.96)), url('/assets/images/page-banner.png') center/cover no-repeat; padding: 100px 0 60px;">
    <div class="container text-center text-white">
        <div class="d-inline-flex align-items-center mb-3">
            @if (Model.BlogCategory != null)
            {
                <span class="badge bg-primary px-3 py-2 rounded-pill me-2">@Model.BlogCategory.Title</span>
            }
            <span class="text-light small"><i class="bi bi-calendar3 me-1"></i> @Model.Date.ToString("MMMM dd, yyyy")</span>
        </div>
        <h1 class="display-5 fw-bold mb-3" style="max-width: 900px; margin: 0 auto; line-height: 1.3;">@Model.Title</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent p-0 m-0">
                <li class="breadcrumb-item"><a href="/" class="text-info text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="/Blog" class="text-info text-decoration-none">Blog</a></li>
                <li class="breadcrumb-item active text-light" aria-current="page">Article</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Blog Detail Content -->
<section class="py-5" style="background-color: #f8fafc;">
    <div class="container py-4">
        <div class="row justify-content-center">
            <!-- Main Article Column -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-5">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="rounded-4 overflow-hidden mb-4 shadow-sm" style="max-height: 440px;">
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100 h-100" style="object-fit: cover;" />
                        </div>
                    }

                    <!-- Article Lead Summary -->
                    <div class="p-4 rounded-3 mb-4" style="background-color: #f0f7ff; border-left: 4px solid #0066cc;">
                        <p class="lead mb-0 text-dark" style="font-size: 1.15rem; font-weight: 500; line-height: 1.6;">
                            @Model.Description
                        </p>
                    </div>

                    <!-- Article Full Body -->
                    <div class="blog-article-content text-dark" style="font-size: 1.05rem; line-height: 1.8;">
                        @Html.Raw(Model.FullDescription)
                    </div>

                    <hr class="my-5" />

                    <!-- Share on Social Media -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center bg-light p-4 rounded-4">
                        <div class="mb-3 mb-md-0">
                            <h6 class="fw-bold mb-1"><i class="bi bi-share-fill me-2 text-primary"></i> Share this article</h6>
                            <span class="text-muted small">Help colleagues and school administrators stay informed</span>
                        </div>
                        <div class="d-flex gap-2">
                            <!-- WhatsApp -->
                            <a href="https://api.whatsapp.com/send?text=@encodedTitle%20@encodedUrl" target="_blank" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm" title="Share on WhatsApp">
                                <i class="bi bi-whatsapp me-1"></i> WhatsApp
                            </a>
                            <!-- Twitter / X -->
                            <a href="https://twitter.com/intent/tweet?text=@encodedTitle&url=@encodedUrl&via=exwhyzee_tech" target="_blank" class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm" title="Share on X (Twitter)">
                                <i class="bi bi-twitter-x me-1"></i> X
                            </a>
                            <!-- Facebook -->
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" title="Share on Facebook">
                                <i class="bi bi-facebook me-1"></i> Facebook
                            </a>
                            <!-- LinkedIn -->
                            <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Share on LinkedIn">
                                <i class="bi bi-linkedin me-1"></i> LinkedIn
                            </a>
                        </div>
                    </div>

                    <!-- Author Box -->
                    <div class="d-flex align-items-center p-4 mt-4 rounded-4 border bg-white">
                        <div class="me-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px; font-size: 1.5rem; font-weight: bold;">
                                SP
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Exwhyzee Editorial &amp; EdTech Research Team</h6>
                            <p class="text-muted small mb-0">
                                Publishing verified technical guides, case studies, and compliance insights for academic leaders across Africa.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Related Articles -->
                @if (related != null && related.Any())
                {
                    <div class="mb-5">
                        <h4 class="fw-bold mb-4"><i class="bi bi-journal-text me-2 text-primary"></i> Related Articles</h4>
                        <div class="row g-4">
                            @foreach (var rel in related)
                            {
                                var relSlug = rel.Title.ToSlug();
                                var relUrl = $"/Blog/{rel.Id}/{relSlug}";
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                                        <a href="@relUrl">
                                            <img src="@(string.IsNullOrEmpty(rel.ImageUrl) ? "/assets/images/blog-image2.jpg" : rel.ImageUrl)" alt="@rel.Title" style="height: 140px; object-fit: cover; width: 100%;" />
                                        </a>
                                        <div class="card-body p-3">
                                            @if (rel.BlogCategory != null)
                                            {
                                                <a href="/Blog/Category/@rel.BlogCategory.Id/@rel.BlogCategory.Title.ToSlug()" class="badge text-bg-light text-primary mb-2 small text-decoration-none">@rel.BlogCategory.Title</a>
                                            }
                                            <h6 class="fw-bold mb-2" style="font-size: 0.95rem; line-height: 1.4;">
                                                <a href="@relUrl" class="text-dark text-decoration-none hover-primary">
                                                    @rel.Title
                                                </a>
                                            </h6>
                                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @rel.Date.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Search -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-search me-2 text-primary"></i> Search Articles</h5>
                    <form method="get" action="/Blog">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control rounded-start-pill ps-3" placeholder="Search..." />
                            <button class="btn btn-primary rounded-end-pill px-3" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Categories -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                    <h5 class="fw-bold mb-3"><i class="bi bi-folder2-open me-2 text-primary"></i> Browse Categories</h5>
                    <div class="list-group list-group-flush">
                        <a href="/Blog" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0 text-dark">
                            <span><i class="bi bi-chevron-right me-2 text-muted small"></i> All Categories</span>
                        </a>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                var catSlug = cat.Title.ToSlug();
                                <a href="/Blog/Category/@cat.Id/@catSlug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-2 border-0 @(Model.BlogCategoryId == cat.Id ? "fw-bold text-primary" : "text-dark")">
                                    <span><i class="bi bi-chevron-right me-2 text-muted small"></i> @cat.Title</span>
                                </a>
                            }
                        }
                    </div>
                </div>

                <!-- CTA Request Demo -->
                <div class="card border-0 rounded-4 p-4 text-white shadow-lg text-center" style="background: linear-gradient(135deg, #0d3b66, #001f3f);">
                    <i class="bi bi-mortarboard-fill display-4 text-warning mb-3"></i>
                    <h4 class="fw-bold mb-2">Ready to Upgrade Your School?</h4>
                    <p class="text-light small mb-4">
                        Schedule a live virtual walkthrough with our deployment team.
                    </p>
                    <a href="/Demo" class="btn btn-warning rounded-pill fw-bold px-4 py-2 text-dark shadow-sm">
                        Request Free Demo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
