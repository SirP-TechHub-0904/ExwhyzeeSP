@model IEnumerable<ExwhyzeeSP.Core.Models.Testimony>
@{
    ViewData["Title"] = "Testimonials Management";
    Layout = "_AdminLayout";
    var search = ViewBag.Search as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);

    var startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Website Testimonials &amp; Reviews</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                    @totalItems Endorsements
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)]">
                Manage client reviews, school endorsements, ratings, and quotes showcased on the public website.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Create" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none bg-sky-600 hover:bg-sky-700 text-white">
                <i class="icon-plus text-[14px]"></i>
                <span>Add Testimonial</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3 shadow-sm">
            <i class="icon-check-circle text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Search Bar -->
    <div class="surface-card rounded-xl border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
        <form method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none flex items-center justify-center z-10">
                    <i class="icon-search text-[14px]"></i>
                </span>
                <input type="text" name="search" value="@search" style="padding-left: 42px !important;" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 pr-3.5 py-2 text-xs text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition" placeholder="Search by author, school, designation, or quote text..." />
            </div>
            <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto">
                <button type="submit" class="btn btn-primary text-xs font-semibold py-2 px-4 rounded-lg shadow-sm bg-sky-600 hover:bg-sky-700 text-white">Filter</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/Testimonies" class="btn btn-outline border-secondary text-xs font-semibold py-2 px-3 rounded-lg text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Testimonials Table Card -->
    <div class="surface-card rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[var(--text-primary)]">
                <thead class="bg-slate-100/75 dark:bg-slate-800/60 text-[11px] font-bold uppercase tracking-wider text-[var(--text-secondary)] border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th scope="col" class="py-3 px-4 w-16 text-center">Order</th>
                        <th scope="col" class="py-3 px-4 w-48">Author &amp; School</th>
                        <th scope="col" class="py-3 px-4 w-40">Designation</th>
                        <th scope="col" class="py-3 px-4 w-32 text-center">Rating</th>
                        <th scope="col" class="py-3 px-4 min-w-[280px]">Quote / Review</th>
                        <th scope="col" class="py-3 px-4 w-28 text-center">Status</th>
                        <th scope="col" class="py-3 px-4 w-32 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Order -->
                                <td class="py-3.5 px-4 text-center font-mono font-bold text-slate-500 dark:text-slate-400">
                                    <span class="inline-block px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[11px]">
                                        #@(item.SortOrder ?? "0")
                                    </span>
                                </td>

                                <!-- Author & School -->
                                <td class="py-3.5 px-4">
                                    <strong class="text-sm font-bold text-[var(--text-primary)] block">@item.Title</strong>
                                    <span class="text-[11.5px] text-sky-600 dark:text-sky-400 font-medium block mt-0.5">@(item.SchoolName ?? "General")</span>
                                </td>

                                <!-- Designation -->
                                <td class="py-3.5 px-4 text-[var(--text-secondary)] font-medium">
                                    @(item.Position ?? "-")
                                </td>

                                <!-- Rating with Golden Stars -->
                                <td class="py-3.5 px-4 text-center">
                                    <div class="inline-flex flex-col items-center gap-0.5">
                                        <div class="flex items-center gap-0.5 text-amber-400 text-xs">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.Rating)
                                                {
                                                    <i class="icon-star text-[12px] fill-current text-amber-400"></i>
                                                }
                                                else
                                                {
                                                    <i class="icon-star text-[12px] text-slate-300 dark:text-slate-600"></i>
                                                }
                                            }
                                        </div>
                                        <span class="text-[10px] font-bold text-[var(--text-secondary)]">@item.Rating / 5</span>
                                    </div>
                                </td>

                                <!-- Quote / Review -->
                                <td class="py-3.5 px-4">
                                    <p class="text-[11.5px] text-[var(--text-secondary)] line-clamp-2 leading-relaxed italic">"@item.Description"</p>
                                </td>

                                <!-- Status Toggle -->
                                <td class="py-3.5 px-4 text-center">
                                    <form asp-action="ToggleShow" asp-route-id="@item.Id" method="post" class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border cursor-pointer transition-colors @(item.Show ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800/60 hover:bg-emerald-100" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700 hover:bg-slate-200")" title="Click to toggle visibility">
                                            <i class="@(item.Show ? "icon-check-circle" : "icon-eye-off") text-[11px]"></i>
                                            @(item.Show ? "Visible" : "Hidden")
                                        </button>
                                    </form>
                                </td>

                                <!-- Actions -->
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold text-decoration-none transition-colors" title="Edit Testimonial">
                                            <i class="icon-edit-3 text-[13px] text-sky-500"></i>
                                            <span>Edit</span>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this testimonial?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center w-7 h-7 rounded-lg border border-rose-200 dark:border-rose-900/40 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Testimonial">
                                                <i class="icon-trash-2 text-[13px]"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-[var(--text-secondary)]">
                                <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 grid place-items-center mx-auto mb-3 text-slate-400">
                                    <i class="icon-message-square text-[24px]"></i>
                                </div>
                                <p class="text-sm font-semibold text-[var(--text-primary)]">No Testimonials Found</p>
                                <p class="text-xs text-[var(--text-secondary)] mt-1">Click "Add Testimonial" to publish your first educator endorsement or clear active search filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (totalPages > 1 || totalItems > 0)
        {
            <div class="p-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/50 dark:bg-slate-900/50">
                <div class="text-xs text-[var(--text-secondary)]">
                    Showing <strong class="text-[var(--text-primary)] font-semibold">@startItem</strong> to <strong class="text-[var(--text-primary)] font-semibold">@endItem</strong> of <strong class="text-[var(--text-primary)] font-semibold">@totalItems</strong> endorsements
                </div>

                @if (totalPages > 1)
                {
                    <div class="flex items-center gap-1.5">
                        <!-- First Page -->
                        <a asp-action="Index" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="First Page">
                            <i class="icon-chevrons-left text-[14px]"></i>
                        </a>

                        <!-- Previous Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="Previous Page">
                            <i class="icon-chevron-left text-[14px]"></i>
                        </a>

                        <!-- Page Number Range -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a asp-action="Index" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-search="@search" class="grid place-items-center min-w-8 h-8 px-2 rounded-lg text-xs font-semibold text-decoration-none transition-colors @(p == currentPage ? "bg-sky-600 text-white shadow-sm" : "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700")">
                                @p
                            </a>
                        }

                        <!-- Next Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Next Page">
                            <i class="icon-chevron-right text-[14px]"></i>
                        </a>

                        <!-- Last Page -->
                        <a asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Last Page">
                            <i class="icon-chevrons-right text-[14px]"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>
