@model ExwhyzeeSP.Core.Models.MasterSchoolTransaction
@using ExwhyzeeSP.Core.Models
@{
    ViewData["Title"] = $"Invoice & Receipt - {Model.InvoiceNumber}";
    Layout = "_AdminLayout";
    
    var isPaid = Model.Status == SchoolPaymentStatus.Paid;
    var isPending = Model.Status == SchoolPaymentStatus.Pending;
    var isOverdue = Model.Status == SchoolPaymentStatus.Overdue;

    var statusClass = isPaid ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
                    : isPending ? "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20"
                    : "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20";
}

<div class="space-y-6 max-w-5xl mx-auto">
    <!-- Action Toolbar (Hidden on Print) -->
    <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex flex-wrap items-center justify-between gap-4 w-full d-print-none shadow-sm">
        <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3.5 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
            <i class="icon-arrow-left text-[14px]"></i>
            <span>Back to Ledger</span>
        </a>

        <div class="flex items-center gap-2 shrink-0 ms-auto">
            <button type="button" class="btn btn-outline border-secondary text-xs font-semibold px-3.5 py-2 flex items-center gap-1.5 rounded-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#emailDocModal">
                <i class="icon-mail text-[14px]"></i>
                <span>Send via Email</span>
            </button>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline border-secondary text-xs font-semibold px-3.5 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-edit text-[14px]"></i>
                <span>Edit Transaction</span>
            </a>
            <button type="button" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm" onclick="window.print();">
                <i class="icon-printer text-[14px]"></i>
                <span>Print / Save as PDF</span>
            </button>
        </div>
    </div>

    <!-- Printable Invoice & Receipt Document Sheet -->
    <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6 sm:p-10 shadow-lg receipt-sheet relative overflow-hidden">
        
        <!-- Subtle Decorative Background Glow -->
        <div class="absolute -right-24 -top-24 size-96 rounded-full bg-sky-500/5 blur-3xl pointer-events-none"></div>

        <!-- Document Header -->
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 pb-6 border-b border-[var(--border-subtle)]">
            <div class="flex items-start gap-4">
                <img src="/img/icon-exwhyzeesp.jpg?v=2" alt="Exwhyzee SP" class="size-14 rounded-xl border border-[var(--border-subtle)] object-contain p-1 shadow-sm shrink-0 bg-white" />
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)]">Exwhyzee SP</h2>
                    <p class="text-xs text-[var(--text-secondary)] font-medium mt-0.5">Unified Cloud School Management ERP Platform</p>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[var(--color-primary-600)] mt-1">
                        <i class="icon-shield-check text-[13px]"></i>
                        <span>Official Finance &amp; Enterprise Billing Desk</span>
                    </span>
                </div>
            </div>

            <div class="text-start sm:text-end shrink-0">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider @statusClass">
                    @(isPaid ? "Official Payment Receipt" : "Tax Invoice")
                </span>
                <div class="text-xl sm:text-2xl font-mono font-extrabold text-[var(--color-primary-600)] mt-2">
                    @Model.InvoiceNumber
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ReceiptNumber))
                {
                    <div class="text-xs font-mono text-[var(--text-tertiary)] mt-0.5 flex items-center sm:justify-end gap-1">
                        <i class="icon-check text-[12px] text-emerald-600"></i>
                        <span>Receipt Ref: <strong class="text-[var(--text-secondary)]">@Model.ReceiptNumber</strong></span>
                    </div>
                }
            </div>
        </div>

        <!-- Metadata & Client Information Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 py-6 border-b border-[var(--border-subtle)]">
            <!-- Billed To -->
            <div class="p-4 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)]">
                <div class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] mb-2 flex items-center gap-1.5">
                    <i class="icon-building text-[13px] text-[var(--color-primary-600)]"></i>
                    <span>Billed To (School Portal):</span>
                </div>
                <h3 class="text-base font-bold text-[var(--text-primary)]">
                    @(Model.TenantSchool?.SchoolName ?? "General School Portal")
                </h3>
                <div class="mt-2 space-y-1 text-xs text-[var(--text-secondary)]">
                    @if (!string.IsNullOrWhiteSpace(Model.TenantSchool?.SubDomain))
                    {
                        <div class="flex items-center gap-1.5 font-mono">
                            <i class="icon-globe text-[13px] text-[var(--text-tertiary)]"></i>
                            <span>Portal: <strong class="text-[var(--text-primary)]">@($"{Model.TenantSchool.SubDomain}.exwhyzee.ng")</strong></span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TenantSchool?.HostDomain))
                    {
                        <div class="flex items-center gap-1.5 font-mono">
                            <i class="icon-link text-[13px] text-[var(--text-tertiary)]"></i>
                            <span>Domain: <strong class="text-[var(--text-primary)]">@Model.TenantSchool.HostDomain</strong></span>
                        </div>
                    }
                </div>
            </div>

            <!-- Transaction Details -->
            <div class="p-4 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)]">
                <div class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] mb-2 flex items-center gap-1.5">
                    <i class="icon-file-text text-[13px] text-[var(--color-primary-600)]"></i>
                    <span>Transaction Metadata:</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <span class="text-[var(--text-tertiary)] block text-[11px]">Issue Date</span>
                        <strong class="text-[var(--text-primary)] font-medium">@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <div>
                        <span class="text-[var(--text-tertiary)] block text-[11px]">Payment Due Date</span>
                        <strong class="text-[var(--text-primary)] font-medium">@Model.DueDate.ToString("MMM dd, yyyy")</strong>
                    </div>
                    @if (Model.PaidDate.HasValue)
                    {
                        <div>
                            <span class="text-[var(--text-tertiary)] block text-[11px]">Payment Date</span>
                            <strong class="text-emerald-600 font-semibold">@Model.PaidDate.Value.ToString("MMM dd, yyyy")</strong>
                        </div>
                    }
                    <div>
                        <span class="text-[var(--text-tertiary)] block text-[11px]">Payment Channel</span>
                        <strong class="text-[var(--text-primary)] font-medium">@Model.PaymentChannel</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BankReference))
                    {
                        <div class="col-span-2 mt-1 pt-1 border-t border-[var(--border-subtle)]">
                            <span class="text-[var(--text-tertiary)] text-[11px]">Bank Ref:</span>
                            <span class="font-mono text-xs font-semibold text-[var(--text-primary)] ms-1">@Model.BankReference</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Ledger Line Items Table -->
        <div class="py-6">
            <div class="rounded-xl border border-[var(--border-subtle)] overflow-hidden">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-tertiary)] uppercase font-semibold text-[11px] tracking-wider">
                            <th class="px-4 py-3 text-start w-12">#</th>
                            <th class="px-4 py-3 text-start">Service Description</th>
                            <th class="px-4 py-3 text-start">Category</th>
                            <th class="px-4 py-3 text-end">Amount (&#8358;)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--border-subtle)]">
                        <tr class="hover:bg-[var(--surface-sunken)]/40 transition-colors">
                            <td class="px-4 py-3.5 font-bold text-[var(--text-tertiary)]">1</td>
                            <td class="px-4 py-3.5">
                                <div class="font-bold text-sm text-[var(--text-primary)]">@Model.Title</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <p class="text-xs text-[var(--text-secondary)] mt-0.5">@Model.Description</p>
                                }
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[var(--surface-card)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
                                    @Model.BillingType
                                </span>
                            </td>
                            <td class="px-4 py-3.5 text-end font-bold text-sm text-[var(--text-primary)]">
                                &#8358;@Model.Amount.ToString("N2")
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)]/50">
                            <td colspan="3" class="px-4 py-2.5 text-end text-xs font-semibold text-[var(--text-secondary)]">Total Invoiced Amount:</td>
                            <td class="px-4 py-2.5 text-end text-xs font-bold text-[var(--text-primary)]">&#8358;@Model.Amount.ToString("N2")</td>
                        </tr>
                        <tr class="border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)]/50">
                            <td colspan="3" class="px-4 py-2.5 text-end text-xs font-semibold text-emerald-600 dark:text-emerald-400">Total Amount Paid:</td>
                            <td class="px-4 py-2.5 text-end text-xs font-bold text-emerald-600 dark:text-emerald-400">&#8358;@Model.AmountPaid.ToString("N2")</td>
                        </tr>
                        <tr class="border-t-2 border-[var(--border-subtle)] bg-[var(--surface-sunken)] font-bold">
                            <td colspan="3" class="px-4 py-3 text-end text-sm text-[var(--text-primary)]">Balance Outstanding:</td>
                            <td class="px-4 py-3 text-end text-sm font-extrabold @(Model.BalanceDue > 0 ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400")">
                                &#8358;@Model.BalanceDue.ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Official Remittance & Verification Stamp -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-6 border-t border-[var(--border-subtle)]">
            <div class="space-y-1 text-xs text-[var(--text-secondary)] max-w-xl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)] mb-1">Official Remittance Details</h4>
                <p>
                    Payments can be made directly via bank wire/transfer to Exwhyzee Technologies official corporate accounts or via the automated school portal invoice gateway.
                </p>
                <p class="text-[11px] text-[var(--text-tertiary)] pt-1">
                    For billing support or receipts verification: <strong class="text-[var(--text-primary)]">finance@exwhyzee.ng</strong> &bull; Phone/WhatsApp: <strong class="text-[var(--text-primary)]">+234 816 568 0904</strong>
                </p>
            </div>

            <div class="shrink-0 text-center">
                <div class="px-5 py-3 rounded-xl border-2 @(isPaid ? "border-emerald-500/40 bg-emerald-500/5 text-emerald-600 dark:text-emerald-400" : "border-amber-500/40 bg-amber-500/5 text-amber-600 dark:text-amber-400") inline-block text-center shadow-sm">
                    <div class="text-[10.5px] font-black uppercase tracking-widest block">
                        @(isPaid ? "DIGITALLY VERIFIED" : "PAYMENT PENDING")
                    </div>
                    <div class="py-1">
                        <i class="@(isPaid ? "icon-check-circle text-[28px] text-emerald-600" : "icon-clock text-[28px] text-amber-600") inline-block"></i>
                    </div>
                    <div class="font-mono text-[10px] text-[var(--text-tertiary)] tracking-wider">
                        Exwhyzee SP Master Authority
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Send by Email Modal (Hidden on Print) -->
    <div class="modal fade d-print-none" id="emailDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered text-start">
            <div class="modal-content surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-2xl overflow-hidden">
                <form asp-action="@(Model.Status == SchoolPaymentStatus.Paid ? "SendReceiptEmail" : "SendInvoiceEmail")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                        <h6 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                            <i class="icon-mail text-[16px] text-[var(--color-primary-600)]"></i>
                            <span>@(Model.Status == SchoolPaymentStatus.Paid ? "Dispatch Official Payment Receipt" : "Dispatch Service Invoice")</span>
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="p-5 space-y-4">
                        <div class="text-xs text-[var(--text-secondary)]">
                            School: <strong class="text-[var(--text-primary)]">@(Model.TenantSchool?.SchoolName)</strong> &bull; Amount: <strong class="text-emerald-600">&#8358;@Model.Amount.ToString("N2")</strong>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Recipient Email Address *</label>
                            <input type="email" name="recipientEmail" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" required placeholder="e.g. bursary@school.edu.ng, principal@school.com" />
                            <small class="text-[11px] text-[var(--text-tertiary)] block mt-1">Enter the school administrator or bursar's email address.</small>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Custom Note from Accounts (Optional)</label>
                            <textarea name="customNote" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" rows="2" placeholder="e.g. Please find attached the receipt for your 2026/2027 1st term subscription."></textarea>
                        </div>
                        <div class="p-3 rounded-lg bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[11px] text-[var(--text-tertiary)] flex items-center gap-2">
                            <i class="icon-info text-[14px] text-[var(--color-primary-600)] shrink-0"></i>
                            <span>An official branded HTML copy will be delivered and logged in the platform's <strong>Email Outbox</strong>.</span>
                        </div>
                    </div>
                    <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex items-center justify-end gap-2.5 ms-auto">
                        <button type="button" class="btn btn-outline border-secondary text-xs font-semibold px-3.5 py-1.5 rounded-lg" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary text-xs font-semibold px-4 py-1.5 rounded-lg flex items-center gap-1.5">
                            <i class="icon-send text-[13px]"></i>
                            <span>Dispatch Email</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body { background: #fff !important; }
        .app-header, .app-sidebar, .app-content-header, .sis-back-to-top-button, #whatsappLiveChatWidget, .d-print-none { display: none !important; }
        .app-shell, .app-wrapper, .app-main { margin: 0 !important; padding: 0 !important; width: 100% !important; }
        .receipt-sheet { box-shadow: none !important; border: 1px solid #e2e8f0 !important; border-radius: 0 !important; padding: 20px !important; }
    }
</style>
