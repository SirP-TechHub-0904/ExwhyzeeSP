@{
    ViewBag.Title = "Confirm Mass User Deletion";
    var classLevel = ViewBag.ClassLevel as ExwhyzeeSP.Core.Entities.ClassLevel;
    int studentCount = ViewBag.StudentCount ?? 0;
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> DANGER: Mass Delete All Students In Class</h3>
            </div>

            <div class="box-body">
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                        @TempData["error"]
                    </div>
                }

                <div class="callout callout-danger">
                    <h4><i class="fa fa-warning"></i> Permanent Deletion Warning</h4>
                    <p>
                        This critical administrative action will <strong>permanently delete all @studentCount student(s)</strong> enrolled in this class and purge:
                    </p>
                    <ul>
                        <li>Student Login & Portal Accounts (AspNetUsers)</li>
                        <li>Student Profiles and Photos</li>
                        <li>All Term Enrollments & Enrolled Subject Scores</li>
                        <li>Attendance History & Records</li>
                        <li>Assignment Submissions & Fees Records</li>
                    </ul>
                    <p><strong>This action CANNOT be undone!</strong></p>
                </div>

                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <th style="width: 35%;">Target Class:</th>
                            <td><strong class="text-danger" style="font-size: 16px;">@(classLevel?.ClassName)</strong></td>
                        </tr>
                        <tr>
                            <th>Total Students Affected:</th>
                            <td><span class="badge bg-red" style="font-size: 14px;">@studentCount Student(s)</span></td>
                        </tr>
                    </tbody>
                </table>

                @using (Html.BeginForm("DeleteAllUser", "AdminUser", new { area = "SuperUser", id = ViewBag.ClassId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-top: 25px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve deleting all @studentCount students in this class, type <strong style="text-decoration: underline; letter-spacing: 1px;">CONFIRM</strong>:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>

                    <div class="box-footer" style="padding: 15px 0 0 0; background: transparent;">
                        <button type="submit" id="btnSubmitDelete" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                            <i class="fa fa-trash"></i> Approve & Mass Delete All Class Students
                        </button>
                        <a href="@Url.Action("Details", "ClassLevels", new { area = "Admin", id = ViewBag.ClassId })" class="btn btn-default btn-lg btn-flat pull-right">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitDelete');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
