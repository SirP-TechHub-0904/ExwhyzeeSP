@model ExwhyzeeSP.Core.Models.MarketingCampaign
@{
    ViewData["Title"] = "New Broadcast Campaign";
    Layout = "_AdminLayout";

    var templates = ViewBag.Templates as List<ExwhyzeeSP.Core.Models.MarketingTemplate> ?? new();
    var distinctTags = ViewBag.DistinctTags as List<string> ?? new();
    int totalContacts = ViewBag.TotalContacts;
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <a asp-action="Index" class="size-8 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center text-decoration-none transition-colors" title="Back to Hub">
                    <i class="icon-arrow-left text-[14px]"></i>
                </a>
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Broadcast Campaign Wizard</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] border border-[var(--color-primary-500)]/20">
                    Mass Dispatch
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5 ps-10">
                Compose, preview, test, and dispatch personalized marketing broadcasts to school leaders.
            </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Index" class="btn btn-outline border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none transition-colors">
                <i class="icon-arrow-left text-[14px]"></i>
                <span>Cancel &amp; Back</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs font-semibold">
                <i class="icon-alert-triangle text-[18px] shrink-0"></i>
                <div>@Html.Raw(TempData["ErrorMessage"])</div>
            </div>
            <button type="button" class="text-rose-600 dark:text-rose-400 hover:opacity-75" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }

    <form method="post" asp-action="CreateCampaign" id="campaignForm" class="space-y-6">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Form Area -->
            <div class="lg:col-span-7 space-y-6">

                <!-- 1. Campaign Settings & Audience -->
                <div class="surface-card p-5 lg:p-6 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-4">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-2 pb-3 border-b border-[var(--border-subtle)]">
                        <i class="icon-settings text-[15px] text-[var(--color-primary-600)]"></i>
                        <span>1. Campaign Settings &amp; Audience</span>
                    </h2>

                    <div class="space-y-4 text-xs">
                        <div>
                            <label asp-for="Title" class="block font-semibold text-[var(--text-primary)] mb-1">Internal Campaign Name *</label>
                            <input asp-for="Title" class="w-full h-10 px-3.5 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" placeholder="e.g. Q4 Admission System Promo" required value="@(Model?.Title ?? $"Marketing Broadcast - {DateTime.UtcNow:MMM d, yyyy}")" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="SenderName" class="block font-semibold text-[var(--text-primary)] mb-1">Sender Display Name</label>
                                <input asp-for="SenderName" class="w-full h-10 px-3.5 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" placeholder="Exwhyzee SP Admissions" value="@(Model?.SenderName ?? "Exwhyzee School Portal")" />
                            </div>
                            <div>
                                <label asp-for="SenderEmail" class="block font-semibold text-[var(--text-primary)] mb-1">Sender Email Address</label>
                                <input asp-for="SenderEmail" class="w-full h-10 px-3.5 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" placeholder="marketing@exwhyzee.ng" value="@(Model?.SenderEmail ?? "marketing@exwhyzee.ng")" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label asp-for="TargetTag" class="block font-semibold text-[var(--text-primary)] mb-1">Target Audience Segment</label>
                                <select asp-for="TargetTag" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" id="targetTagSelect">
                                    <option value="All">All Subscribed Contacts (@totalContacts contacts)</option>
                                    @foreach (var tag in distinctTags)
                                    {
                                        <option value="@tag">Tag: @tag</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block font-semibold text-[var(--text-primary)] mb-1">Choose Base Template</label>
                                <select asp-for="MarketingTemplateId" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" id="templateSelect" onchange="loadSelectedTemplate(this.value)">
                                    <option value="">-- Custom HTML / Empty Template --</option>
                                    @foreach (var t in templates)
                                    {
                                        <option value="@t.Id" selected="@(Model.MarketingTemplateId == t.Id)">@t.TemplateName (@t.Category)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Message Content & Dual-Mode Editor -->
                <div class="surface-card p-5 lg:p-6 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-[var(--border-subtle)]">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-2">
                            <i class="icon-edit-3 text-[15px] text-emerald-500"></i>
                            <span>2. Message Content &amp; Subject</span>
                        </h2>

                        <!-- Editor Mode Tabs Switcher -->
                        <div class="inline-flex items-center p-1 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)]">
                            <button type="button" id="tabBtnVisual" class="px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all bg-[var(--surface-raised)] text-[var(--color-primary-600)] shadow-xs" onclick="switchEditorMode('visual')">
                                <i class="icon-type text-[13px]"></i>
                                <span>Visual / Rich Text</span>
                            </button>
                            <button type="button" id="tabBtnHtml" class="px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]" onclick="switchEditorMode('html')">
                                <i class="icon-code text-[13px]"></i>
                                <span>HTML Source Code</span>
                            </button>
                        </div>
                    </div>

                    <div class="space-y-4 text-xs">
                        <div>
                            <label asp-for="Subject" class="block font-semibold text-[var(--text-primary)] mb-1">Subject Line *</label>
                            <input asp-for="Subject" id="campaignSubject" class="w-full h-10 px-3.5 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] text-xs transition-all" placeholder="e.g. Exclusive Educational Tech Upgrade for {{SchoolName}}" required />
                            <span class="text-[11px] text-[var(--text-tertiary)] block mt-1">Dynamic merge tags like <code>{{SchoolName}}</code> or <code>{{FirstName}}</code> work in the subject line.</span>
                        </div>

                        <!-- Editor Area Container -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block font-semibold text-[var(--text-primary)]">Email Body Content *</label>
                                <span class="text-[11px] text-[var(--text-tertiary)]" id="editorModeIndicator">Mode: Visual WYSIWYG</span>
                            </div>

                            <!-- VISUAL EDITOR MODE CONTAINER -->
                            <div id="visualEditorWrapper" class="space-y-2">
                                <!-- Rich Text Formatting Toolbar -->
                                <div class="p-2 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] flex flex-wrap items-center gap-1">
                                    
                                    <!-- Text Formats -->
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center font-bold text-xs" title="Bold (Ctrl+B)" onclick="execVisualCmd('bold')">B</button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center italic text-xs" title="Italic (Ctrl+I)" onclick="execVisualCmd('italic')">I</button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center underline text-xs" title="Underline (Ctrl+U)" onclick="execVisualCmd('underline')">U</button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center line-through text-xs" title="Strikethrough" onclick="execVisualCmd('strikeThrough')">S</button>
                                    
                                    <div class="w-px h-5 bg-[var(--border-subtle)] mx-1"></div>

                                    <!-- Headings Dropdown -->
                                    <select class="h-7 px-2 rounded-lg bg-[var(--surface-raised)] border border-[var(--border-subtle)] text-[11px] text-[var(--text-primary)] focus:outline-none" onchange="execVisualCmd('formatBlock', this.value); this.value='';">
                                        <option value="">Heading / Paragraph</option>
                                        <option value="<p>">Normal Paragraph</option>
                                        <option value="<h1>">Heading 1 (Main Title)</option>
                                        <option value="<h2>">Heading 2 (Subtitle)</option>
                                        <option value="<h3>">Heading 3 (Section)</option>
                                        <option value="<blockquote>">Quote Block</option>
                                    </select>

                                    <div class="w-px h-5 bg-[var(--border-subtle)] mx-1"></div>

                                    <!-- Alignment -->
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Align Left" onclick="execVisualCmd('justifyLeft')">
                                        <i class="icon-align-left text-[13px]"></i>
                                    </button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Align Center" onclick="execVisualCmd('justifyCenter')">
                                        <i class="icon-align-center text-[13px]"></i>
                                    </button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Align Right" onclick="execVisualCmd('justifyRight')">
                                        <i class="icon-align-right text-[13px]"></i>
                                    </button>

                                    <div class="w-px h-5 bg-[var(--border-subtle)] mx-1"></div>

                                    <!-- Lists -->
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Bullet List" onclick="execVisualCmd('insertUnorderedList')">
                                        <i class="icon-list text-[13px]"></i>
                                    </button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Numbered List" onclick="execVisualCmd('insertOrderedList')">
                                        <i class="icon-list-ordered text-[13px]"></i>
                                    </button>

                                    <div class="w-px h-5 bg-[var(--border-subtle)] mx-1"></div>

                                    <!-- Link -->
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Insert Link" onclick="insertLinkPrompt()">
                                        <i class="icon-link text-[13px]"></i>
                                    </button>
                                    <button type="button" class="size-7 rounded-lg hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] grid place-items-center" title="Remove Link" onclick="execVisualCmd('unlink')">
                                        <i class="icon-link-2-off text-[13px]"></i>
                                    </button>

                                    <div class="w-px h-5 bg-[var(--border-subtle)] mx-1"></div>

                                    <!-- Quick CTA Button Inserter -->
                                    <button type="button" class="px-2 h-7 rounded-lg bg-[var(--surface-raised)] border border-[var(--border-subtle)] hover:bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] text-[11px] font-semibold flex items-center gap-1" title="Insert Call to Action Button" onclick="insertCtaButtonPrompt()">
                                        <i class="icon-mouse-pointer-click text-[11px]"></i>
                                        <span>+ Button</span>
                                    </button>

                                    <!-- Quick Tag Dropdown -->
                                    <select class="h-7 px-2 rounded-lg bg-[var(--surface-raised)] border border-[var(--border-subtle)] text-[11px] font-semibold text-[var(--color-primary-600)] focus:outline-none ms-auto" onchange="if(this.value){ insertTagAtCursor(this.value); this.value=''; }">
                                        <option value="">Insert Tag &darr;</option>
                                        <option value="{{FullName}}">{{FullName}}</option>
                                        <option value="{{FirstName}}">{{FirstName}}</option>
                                        <option value="{{SchoolName}}">{{SchoolName}}</option>
                                        <option value="{{Role}}">{{Role}}</option>
                                        <option value="{{State}}">{{State}}</option>
                                        <option value="{{Email}}">{{Email}}</option>
                                        <option value="{{CurrentYear}}">{{CurrentYear}}</option>
                                    </select>
                                </div>

                                <!-- Visual Canvas -->
                                <div id="visualEditorContent" contenteditable="true" class="w-full min-h-[380px] p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] overflow-y-auto leading-relaxed shadow-inner" style="min-height: 380px;"></div>
                            </div>

                            <!-- RAW HTML SOURCE CODE MODE CONTAINER -->
                            <div id="htmlEditorWrapper" class="hidden space-y-2">
                                <textarea asp-for="BodyHtml" id="bodyHtmlInput" class="w-full h-[430px] p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-primary)] font-mono text-xs leading-relaxed focus:outline-none focus:border-[var(--color-primary-500)] transition-all" rows="18" spellcheck="false" required></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Dispatch Box -->
                <div class="surface-card p-5 lg:p-6 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-4">
                    <!-- Test Send Sub-section -->
                    <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div>
                            <h4 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                                <i class="icon-send text-[14px] text-sky-500"></i>
                                <span>Send Test Verification</span>
                            </h4>
                            <p class="text-[11px] text-[var(--text-tertiary)] mt-0.5">Deliver a test email to your inbox to inspect rendering before live broadcast.</p>
                        </div>
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <input type="email" name="testEmail" id="testEmailInput" class="h-9 px-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)]" placeholder="your-email@exwhyzee.ng" value="test@exwhyzee.ng" />
                            <button type="submit" name="submitAction" value="send_test" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold h-9 px-3.5 rounded-xl whitespace-nowrap hover:bg-[var(--surface-sunken)]">
                                Send Test
                            </button>
                        </div>
                    </div>

                    <!-- Main Dispatch Buttons -->
                    <div class="flex items-center justify-between pt-2">
                        <button type="submit" name="submitAction" value="save_draft" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-4 py-2.5 rounded-xl flex items-center gap-1.5 hover:bg-[var(--surface-sunken)]">
                            <i class="icon-bookmark text-[14px]"></i>
                            <span>Save as Draft</span>
                        </button>
                        <button type="button" class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-xl shadow-sm flex items-center gap-2" onclick="confirmBroadcastLaunch()">
                            <i class="icon-send text-[14px]"></i>
                            <span>Launch Broadcast Now</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- Right Preview & Personalization Helper Area -->
            <div class="lg:col-span-5 space-y-6">

                <!-- Tag Insertion Helper -->
                <div class="surface-card p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-3">
                    <h3 class="text-xs font-bold text-[var(--text-primary)] flex items-center gap-1.5">
                        <i class="icon-tag text-[14px] text-[var(--color-primary-600)]"></i>
                        <span>Click-to-Insert Personalization Tags</span>
                    </h3>
                    <p class="text-[11px] text-[var(--text-secondary)]">Click any tag below to insert it at your current cursor position:</p>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{FullName}}')">&#123;&#123;FullName&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{FirstName}}')">&#123;&#123;FirstName&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{SchoolName}}')">&#123;&#123;SchoolName&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{Role}}')">&#123;&#123;Role&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{State}}')">&#123;&#123;State&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{Email}}')">&#123;&#123;Email&#125;&#125;</button>
                        <button type="button" class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)] hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-600)] transition-all" onclick="insertTagAtCursor('{{CurrentYear}}')">&#123;&#123;CurrentYear&#125;&#125;</button>
                    </div>
                </div>

                <!-- Live Rendered Email Sandbox -->
                <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden sticky top-6">
                    <div class="px-5 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)]/40 flex items-center justify-between">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-2">
                            <i class="icon-monitor text-[14px] text-[var(--color-primary-600)]"></i>
                            <span>Rendered Email Sandbox</span>
                        </h3>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            Live Mock Preview
                        </span>
                    </div>
                    <div class="p-0 bg-slate-100 dark:bg-slate-900">
                        <iframe id="liveIframe" style="width: 100%; height: 550px; border: none;" sandbox="allow-same-origin"></iframe>
                    </div>
                </div>

            </div>

        </div>
    </form>
</div>

<!-- Modal: Broadcast Launch Confirmation -->
<div class="modal fade" id="launchConfirmModal" tabindex="-1" aria-labelledby="launchConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] shadow-2xl rounded-2xl overflow-hidden">
            <div class="modal-header px-5 py-4 bg-emerald-600 text-white flex items-center justify-between">
                <h5 class="modal-title font-bold text-sm flex items-center gap-2" id="launchConfirmModalLabel">
                    <i class="icon-send text-[16px]"></i>
                    <span>Launch Marketing Broadcast</span>
                </h5>
                <button type="button" class="text-white text-xl hover:opacity-75" data-bs-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body p-5 space-y-4 text-xs">
                <p class="text-[var(--text-secondary)]">Are you ready to execute this marketing broadcast?</p>
                <div class="p-4 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] space-y-2">
                    <div><span class="text-[var(--text-tertiary)]">Audience Target:</span> <strong class="text-[var(--text-primary)]" id="confirmAudience">All Contacts</strong></div>
                    <div><span class="text-[var(--text-tertiary)]">Subject:</span> <strong class="text-[var(--color-primary-600)]" id="confirmSubject"></strong></div>
                    <div><span class="text-[var(--text-tertiary)]">Audit Trail:</span> <span class="text-[var(--text-secondary)]">All dispatches will be recorded into Master Email Outbox &amp; Audit Logs.</span></div>
                </div>
                <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center gap-2">
                    <i class="icon-alert-circle text-[15px] shrink-0"></i>
                    <span>Dispatches are processed asynchronously and logged into the platform email repository.</span>
                </div>
            </div>
            <div class="modal-footer px-5 py-3.5 border-t border-[var(--border-subtle)] flex items-center justify-end gap-2">
                <button type="button" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-4 py-2 rounded-xl text-[var(--text-secondary)]" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary text-xs font-semibold px-5 py-2 rounded-xl shadow-sm" onclick="executeBroadcastSubmit()">Confirm &amp; Launch</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentEditorMode = 'visual';

    function switchEditorMode(mode) {
        currentEditorMode = mode;
        const visualWrapper = document.getElementById('visualEditorWrapper');
        const htmlWrapper = document.getElementById('htmlEditorWrapper');
        const tabBtnVisual = document.getElementById('tabBtnVisual');
        const tabBtnHtml = document.getElementById('tabBtnHtml');
        const indicator = document.getElementById('editorModeIndicator');
        const visualContent = document.getElementById('visualEditorContent');
        const htmlTextarea = document.getElementById('bodyHtmlInput');

        if (mode === 'visual') {
            // Sync HTML to Visual
            visualContent.innerHTML = htmlTextarea.value;
            visualWrapper.classList.remove('hidden');
            htmlWrapper.classList.add('hidden');

            tabBtnVisual.className = 'px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all bg-[var(--surface-raised)] text-[var(--color-primary-600)] shadow-xs';
            tabBtnHtml.className = 'px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
            indicator.innerText = 'Mode: Visual WYSIWYG';
        } else {
            // Sync Visual to HTML
            htmlTextarea.value = visualContent.innerHTML;
            visualWrapper.classList.add('hidden');
            htmlWrapper.classList.remove('hidden');

            tabBtnHtml.className = 'px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all bg-[var(--surface-raised)] text-[var(--color-primary-600)] shadow-xs';
            tabBtnVisual.className = 'px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
            indicator.innerText = 'Mode: Raw HTML Code';
        }
        updatePreview();
    }

    function execVisualCmd(command, value = null) {
        document.getElementById('visualEditorContent').focus();
        document.execCommand(command, false, value);
        syncVisualToHtml();
    }

    function insertLinkPrompt() {
        const url = prompt('Enter the destination URL (e.g. https://your-school-portal.com):');
        if (url) {
            execVisualCmd('createLink', url);
        }
    }

    function insertCtaButtonPrompt() {
        const text = prompt('Enter Button Label (e.g. Book Institutional Demo):', 'Book Free Institutional Demo');
        if (!text) return;
        const link = prompt('Enter Button Link URL:', 'https://exwhyzee.ng/Demo');
        if (!link) return;

        const btnHtml = `<div style="text-align: center; margin: 24px 0;"><a href="${link}" style="background-color: #0284c7; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px; display: inline-block;">${text}</a></div>`;
        if (currentEditorMode === 'visual') {
            document.getElementById('visualEditorContent').focus();
            document.execCommand('insertHTML', false, btnHtml);
            syncVisualToHtml();
        } else {
            insertTagAtCursor(btnHtml);
        }
    }

    function insertTagAtCursor(tag) {
        if (currentEditorMode === 'visual') {
            const visualEditor = document.getElementById('visualEditorContent');
            visualEditor.focus();
            document.execCommand('insertHTML', false, tag);
            syncVisualToHtml();
        } else {
            const textarea = document.getElementById('bodyHtmlInput');
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;
            textarea.value = text.substring(0, start) + tag + text.substring(end);
            textarea.focus();
            textarea.selectionEnd = start + tag.length;
            syncHtmlToVisual();
        }
    }

    function syncVisualToHtml() {
        const visualContent = document.getElementById('visualEditorContent');
        const htmlTextarea = document.getElementById('bodyHtmlInput');
        htmlTextarea.value = visualContent.innerHTML;
        updatePreview();
    }

    function syncHtmlToVisual() {
        const visualContent = document.getElementById('visualEditorContent');
        const htmlTextarea = document.getElementById('bodyHtmlInput');
        visualContent.innerHTML = htmlTextarea.value;
        updatePreview();
    }

    function updatePreview() {
        const rawHtml = document.getElementById('bodyHtmlInput').value || "<p style='color:#666;text-align:center;padding:40px;'>Enter HTML content to preview...</p>";
        let previewHtml = rawHtml
            .replaceAll('{{FullName}}', 'Dr. Anthony Uche')
            .replaceAll('{{FirstName}}', 'Anthony')
            .replaceAll('{{SchoolName}}', 'Premier International Academy')
            .replaceAll('{{Email}}', 'admin@premieracademy.edu.ng')
            .replaceAll('{{Role}}', 'Proprietor & Principal')
            .replaceAll('{{State}}', 'Lagos')
            .replaceAll('{{CurrentYear}}', new Date().getFullYear());

        const iframe = document.getElementById('liveIframe');
        iframe.srcdoc = previewHtml;
    }

    function loadSelectedTemplate(templateId) {
        if (!templateId) return;
        fetch(`/Admin/Marketing/GetTemplateJson/${templateId}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('campaignSubject').value = data.subject;
                document.getElementById('bodyHtmlInput').value = data.bodyHtml;
                document.getElementById('visualEditorContent').innerHTML = data.bodyHtml;
                updatePreview();
            })
            .catch(err => console.error("Error fetching template: ", err));
    }

    function confirmBroadcastLaunch() {
        // Sync before confirming
        if (currentEditorMode === 'visual') {
            syncVisualToHtml();
        }
        const subject = document.getElementById('campaignSubject').value;
        const targetTag = document.getElementById('targetTagSelect').value;
        document.getElementById('confirmSubject').innerText = subject || "(No Subject)";
        document.getElementById('confirmAudience').innerText = targetTag === "All" ? "All Subscribed Contacts" : "Tag: " + targetTag;

        const modal = new bootstrap.Modal(document.getElementById('launchConfirmModal'));
        modal.show();
    }

    function executeBroadcastSubmit() {
        if (currentEditorMode === 'visual') {
            syncVisualToHtml();
        }
        const form = document.getElementById('campaignForm');
        const hiddenAction = document.createElement('input');
        hiddenAction.type = 'hidden';
        hiddenAction.name = 'submitAction';
        hiddenAction.value = 'launch_now';
        form.appendChild(hiddenAction);
        form.submit();
    }

    // Event listeners
    document.getElementById('visualEditorContent').addEventListener('input', syncVisualToHtml);
    document.getElementById('bodyHtmlInput').addEventListener('input', syncHtmlToVisual);
    
    window.addEventListener('DOMContentLoaded', () => {
        const html = document.getElementById('bodyHtmlInput').value;
        if (html) {
            document.getElementById('visualEditorContent').innerHTML = html;
        }
        updatePreview();
    });
</script>
}
