@model List<ExwhyzeeSP.Core.Models.MasterSchoolTransaction>
@using ExwhyzeeSP.Core.Models
@{
    ViewData["Title"] = "School Billing & Financial Ledger";
    decimal totalCollected = ViewBag.TotalCollected ?? 0m;
    decimal totalPending = ViewBag.TotalPending ?? 0m;
    decimal totalOverdue = ViewBag.TotalOverdue ?? 0m;
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">School Billing &amp; Finance</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Track school invoices, manage subscription renewals, generate receipts, and monitor receivables.
            </p>
        </div>

        <div class="flex items-center gap-2.5 ms-auto shrink-0">
            <a asp-action="Create" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-plus text-[14px]"></i>
                <span>Generate Invoice</span>
            </a>
        </div>
    </div>

    <!-- Financial KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 shadow-sm">
            <div class="size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center shrink-0">
                <i class="icon-check-circle text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] block">Total Collected</span>
                <span class="text-xl font-bold text-emerald-600 dark:text-emerald-400 leading-tight block">&#8358;@totalCollected.ToString("N2")</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">@ViewBag.PaidInvoicesCount paid invoices</span>
            </div>
        </div>

        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 shadow-sm">
            <div class="size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 grid place-items-center shrink-0">
                <i class="icon-clock text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] block">Pending Receivables</span>
                <span class="text-xl font-bold text-amber-600 dark:text-amber-400 leading-tight block">&#8358;@totalPending.ToString("N2")</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">Awaiting school bank wire</span>
            </div>
        </div>

        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 shadow-sm">
            <div class="size-11 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 grid place-items-center shrink-0">
                <i class="icon-alert-circle text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] block">Overdue Invoices</span>
                <span class="text-xl font-bold text-rose-600 dark:text-rose-400 leading-tight block">&#8358;@totalOverdue.ToString("N2")</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">Past payment due date</span>
            </div>
        </div>

        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 shadow-sm">
            <div class="size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center shrink-0">
                <i class="icon-file-text text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] block">Total Issued</span>
                <span class="text-xl font-bold text-[var(--text-primary)] leading-tight block">@ViewBag.TotalInvoicesCount</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">Lifetime transaction ledger</span>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-4 shadow-sm">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            <div class="col-span-1 sm:col-span-2 lg:col-span-4">
                <div class="relative flex items-center">
                    <i class="icon-search absolute left-3.5 text-[14px] text-[var(--text-tertiary)] pointer-events-none flex items-center justify-center z-10"></i>
                    <input type="text" name="search" style="padding-left: 42px !important;" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] pr-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" placeholder="Search invoice, ref, school..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-span-1 lg:col-span-3">
                <select name="schoolId" data-no-choices asp-items="ViewBag.Schools" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none">
                    <option value="">All Schools</option>
                </select>
            </div>
            <div class="col-span-1 lg:col-span-2">
                <select name="status" data-no-choices class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none">
                    <option value="">All Statuses</option>
                    @foreach (SchoolPaymentStatus s in Enum.GetValues(typeof(SchoolPaymentStatus)))
                    {
                        <option value="@s" selected="@(ViewBag.SelectedStatus?.ToString() == s.ToString())">@s</option>
                    }
                </select>
            </div>
            <div class="col-span-1 sm:col-span-2 lg:col-span-3 flex items-center justify-end gap-2 ms-auto w-full">
                <button type="submit" class="btn btn-primary text-xs font-semibold px-4 py-2 rounded-lg flex-1 sm:flex-initial flex items-center justify-center gap-1.5">
                    <i class="icon-filter text-[13px]"></i>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 rounded-lg text-decoration-none">
                    Reset
                </a>
            </div>
            <div class="col-span-1 sm:col-span-2 lg:col-span-12 pt-1 border-t border-[var(--border-subtle)] flex items-center justify-between flex-wrap gap-2">
                <label class="inline-flex items-center gap-2 text-xs text-[var(--text-secondary)] cursor-pointer select-none">
                    <input type="checkbox" name="includeArchived" value="true" @(ViewBag.IncludeArchived == true ? "checked" : "") onchange="this.form.submit()" class="size-3.5 rounded border-[var(--border-subtle)] text-[var(--color-primary-600)] focus:ring-0" />
                    <span>Include Decommissioned / Archived Schools</span>
                </label>
                @if (ViewBag.IncludeArchived == true)
                {
                    <span class="text-[11.5px] text-amber-600 dark:text-amber-400 font-medium flex items-center gap-1">
                        <i class="icon-info text-[13px]"></i> Showing historical records for archived institutions
                    </span>
                }
            </div>
        </form>
    </div>

    <!-- Ledger Table Card -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between flex-wrap gap-3">
            <h3 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                <i class="icon-file-text text-[16px] text-[var(--color-primary-600)]"></i>
                <span>Transactions &amp; Invoices Ledger (@Model.Count)</span>
            </h3>

            @if (User.IsInRole(MasterRoles.SuperAdmin) && (ViewBag.IncludeArchived == true || Model.Any(m => m.TenantSchool == null || m.TenantSchool.IsDeleted)))
            {
                <form asp-action="PurgeDecommissionedInvoices" method="post" onsubmit="return confirm('Are you sure you want to permanently delete all orphaned invoices belonging to decommissioned schools? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline text-xs text-rose-600 border-rose-500/30 hover:bg-rose-500/10 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                        <i class="icon-trash-2 text-[13px]"></i>
                        <span>Purge Decommissioned Invoices</span>
                    </button>
                </form>
            }
        </div>

        <div class="overflow-x-auto">
            <table class="table table-hover align-middle mb-0 w-full text-xs">
                <thead>
                    <tr class="border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-tertiary)] uppercase font-semibold text-[11px] tracking-wider">
                        <th class="px-4 py-3 text-start">Invoice #</th>
                        <th class="px-4 py-3 text-start">School Name</th>
                        <th class="px-4 py-3 text-start">Service / Description</th>
                        <th class="px-4 py-3 text-start">Amount</th>
                        <th class="px-4 py-3 text-start">Status</th>
                        <th class="px-4 py-3 text-start">Channel</th>
                        <th class="px-4 py-3 text-start">Due Date</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-subtle)]">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var isArchivedSchool = item.TenantSchool == null || item.TenantSchool.IsDeleted;
                            var statusBadge = item.Status switch
                            {
                                SchoolPaymentStatus.Paid => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20",
                                SchoolPaymentStatus.Pending => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20",
                                SchoolPaymentStatus.Overdue => "bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20",
                                SchoolPaymentStatus.PartiallyPaid => "bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20",
                                _ => "bg-gray-500/10 text-gray-600 border border-gray-500/20"
                            };

                            <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors @(isArchivedSchool ? "opacity-75" : "")">
                                <td class="px-4 py-3 font-mono font-bold text-[var(--color-primary-600)]">
                                    @item.InvoiceNumber
                                    @if (!string.IsNullOrWhiteSpace(item.ReceiptNumber))
                                    {
                                        <div class="text-[11px] text-[var(--text-tertiary)] font-mono"><i class="icon-check text-[11px]"></i> @item.ReceiptNumber</div>
                                    }
                                </td>
                                <td class="px-4 py-3 font-medium text-[var(--text-primary)]">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span>@(item.TenantSchool?.SchoolName ?? "General / Unassigned Invoice")</span>
                                        @if (isArchivedSchool)
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-600 border border-rose-500/20">Archived School</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.TenantSchool?.SubDomain))
                                    {
                                        <span class="block text-[11px] font-mono text-[var(--text-tertiary)]">@($"{item.TenantSchool.SubDomain}.exwhyzee.ng")</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-[var(--text-primary)] max-w-xs truncate" title="@item.Title">@item.Title</div>
                                    <span class="text-[11px] text-[var(--text-tertiary)]">@item.BillingType</span>
                                </td>
                                <td class="px-4 py-3 font-bold text-[var(--text-primary)]">
                                    &#8358;@item.Amount.ToString("N2")
                                    @if (item.Status == SchoolPaymentStatus.Paid)
                                    {
                                        <span class="block text-[11px] font-normal text-emerald-600 dark:text-emerald-400">Fully Paid</span>
                                    }
                                    else if (item.AmountPaid > 0)
                                    {
                                        <span class="block text-[11px] font-normal text-sky-600">Paid: &#8358;@item.AmountPaid.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="block text-[11px] font-normal text-rose-600">Due: &#8358;@item.BalanceDue.ToString("N2")</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold @statusBadge">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-[var(--text-secondary)]">
                                    <div>@item.PaymentChannel</div>
                                    @if (!string.IsNullOrWhiteSpace(item.BankReference))
                                    {
                                        <div class="font-mono text-[10.5px] text-[var(--text-tertiary)]">@item.BankReference</div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-[var(--text-secondary)]">
                                    @item.DueDate.ToString("MMM dd, yyyy")
                                    @if (item.PaidDate.HasValue)
                                    {
                                        <div class="text-emerald-600 text-[10.5px]">Paid: @item.PaidDate.Value.ToString("MMM dd")</div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <a asp-action="Receipt" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] transition-colors" title="View / Print Official Receipt &amp; Invoice">
                                            <i class="icon-printer text-[14px]"></i>
                                        </a>
                                        <button type="button" class="p-1.5 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] transition-colors" title="Dispatch Invoice / Receipt by Email" data-bs-toggle="modal" data-bs-target="#emailModal_@item.Id">
                                            <i class="icon-mail text-[14px]"></i>
                                        </button>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] transition-colors" title="Edit Transaction Details">
                                            <i class="icon-edit text-[14px]"></i>
                                        </a>
                                        @if (item.Status != SchoolPaymentStatus.Paid)
                                        {
                                            <button type="button" class="p-1.5 rounded-lg text-emerald-600 hover:bg-emerald-500/10 transition-colors" title="Mark as Paid" data-bs-toggle="modal" data-bs-target="#markPaidModal_@item.Id">
                                                <i class="icon-check text-[14px]"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole(MasterRoles.SuperAdmin) || User.IsInRole(MasterRoles.Admin))
                                        {
                                            <form asp-action="DeleteInvoice" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete invoice #@item.InvoiceNumber?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-500/10 transition-colors" title="Delete Invoice">
                                                    <i class="icon-trash-2 text-[14px]"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-8 text-[var(--text-tertiary)]">No billing transactions or invoices found matching criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modals rendered outside table to prevent DOM blowout -->
@if (Model.Any())
{
    @foreach (var item in Model)
    {
        <!-- Send Email Modal -->
        <div class="modal fade" id="emailModal_@item.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered text-start">
                <div class="modal-content surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-2xl overflow-hidden">
                    <form asp-action="@(item.Status == SchoolPaymentStatus.Paid ? "SendReceiptEmail" : "SendInvoiceEmail")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                            <h6 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                                <i class="icon-mail text-[16px] text-[var(--color-primary-600)]"></i>
                                <span>@(item.Status == SchoolPaymentStatus.Paid ? $"Email Receipt: {item.ReceiptNumber ?? item.InvoiceNumber}" : $"Email Invoice: {item.InvoiceNumber}")</span>
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="p-5 space-y-4">
                            <div class="text-xs text-[var(--text-secondary)]">
                                School: <strong class="text-[var(--text-primary)]">@(item.TenantSchool?.SchoolName)</strong> &bull; Amount: <strong class="text-emerald-600">&#8358;@item.Amount.ToString("N2")</strong>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Recipient Email Address *</label>
                                <input type="email" name="recipientEmail" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" required placeholder="e.g. bursary@school.edu.ng, principal@school.com" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Custom Note from Accounts (Optional)</label>
                                <textarea name="customNote" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" rows="2" placeholder="e.g. Please find attached the billing breakdown for your school portal."></textarea>
                            </div>
                        </div>
                        <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex items-center justify-end gap-2.5 ms-auto">
                            <button type="button" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-1.5 rounded-lg" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary text-xs font-semibold px-4 py-1.5 rounded-lg flex items-center gap-1.5">
                                <i class="icon-send text-[13px]"></i>
                                <span>Send Email</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Mark Paid Modal -->
        @if (item.Status != SchoolPaymentStatus.Paid)
        {
            <div class="modal fade" id="markPaidModal_@item.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered text-start">
                    <div class="modal-content surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-2xl overflow-hidden">
                        <form asp-action="MarkAsPaid" asp-route-id="@item.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                                <h6 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                                    <i class="icon-check-circle text-[16px] text-emerald-600"></i>
                                    <span>Confirm Payment: @item.InvoiceNumber</span>
                                </h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="p-5 space-y-4">
                                <div class="text-xs text-[var(--text-secondary)]">
                                    School: <strong class="text-[var(--text-primary)]">@(item.TenantSchool?.SchoolName)</strong> &bull; Confirm: <strong class="text-emerald-600 text-sm">&#8358;@item.Amount.ToString("N2")</strong>
                                </div>
                                
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Payment Channel</label>
                                    <select name="channel" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none">
                                        <option value="1">Direct Bank Transfer / Wire</option>
                                        <option value="2">Paystack Online</option>
                                        <option value="3">Flutterwave Online</option>
                                        <option value="4">Cash Payment</option>
                                        <option value="5">POS / Card</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Bank / Transaction Reference</label>
                                    <input type="text" name="reference" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-[var(--color-primary-500)] outline-none" placeholder="e.g. GTB/TRF/9834710..." />
                                </div>
                            </div>
                            <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex items-center justify-end gap-2.5 ms-auto">
                                <button type="button" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-1.5 rounded-lg" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success text-xs font-semibold px-4 py-1.5 rounded-lg flex items-center gap-1.5">
                                    <i class="icon-check text-[13px]"></i>
                                    <span>Confirm &amp; Save</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}
