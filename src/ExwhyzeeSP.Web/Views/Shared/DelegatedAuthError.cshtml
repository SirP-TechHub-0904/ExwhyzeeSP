@model string
@{
    ViewData["Title"] = "Delegated SSO Authentication Error";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Authentication Error - Exwhyzee Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #0f172a; color: #f8fafc; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
        .card { background: #1e293b; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 20px; padding: 40px; max-width: 520px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
        .icon { width: 64px; height: 64px; border-radius: 16px; background: rgba(239, 68, 68, 0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: #f87171; font-size: 28px; }
        h1 { font-size: 22px; margin-bottom: 12px; }
        p { color: #94a3b8; font-size: 14px; line-height: 1.5; margin-bottom: 24px; }
        .error-box { background: rgba(15, 23, 42, 0.8); border-left: 4px solid #ef4444; padding: 12px 16px; border-radius: 8px; text-align: left; font-size: 13px; color: #fca5a5; margin-bottom: 24px; }
        .btn { display: inline-block; padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; text-decoration: none; background: #2563eb; color: #fff; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">⚠️</div>
        <h1>Delegated SSO Handshake Failed</h1>
        <p>The single-use support authentication token could not be verified by this school tenant.</p>
        <div class="error-box">
            <strong>Reason:</strong> @Model
        </div>
        <a href="/" class="btn">Return to School Portal</a>
    </div>
</body>
</html>
