                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No staff data recorded.</div>
                }
                else
                {
                    int rank = 1;
                    @foreach (var s in Model.TopStaffSchools)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="size-5 rounded-full bg-[var(--surface-sunken)] border text-[10.5px] font-bold text-indigo-600 grid place-items-center shrink-0">
                                    @rank
