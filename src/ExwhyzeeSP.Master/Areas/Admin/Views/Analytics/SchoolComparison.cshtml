@model List<MasterTenantMetricSnapshot>
@{
    ViewData["Title"] = "School Performance & Capacity Comparisons";
}

<!-- Page Header & Action Toolbar -->
<div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Cross-School Benchmarking &amp; Comparison</h1>
        <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
            Compare enrollment metrics, financial collections, staff ratios, and portal activity across schools.
        </p>
    </div>

    <div class="flex items-center gap-2.5 shrink-0 ms-auto">
        <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
            <i class="icon-arrow-left text-[14px]"></i>
            <span>Analytics Hub</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Student vs Staff Comparison -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Enrollment vs Faculty Capacity</h5>
                <span class="text-muted small">Student count compared with educator workforce</span>
            </div>
            <div class="card-body p-3">
                <div id="capacityBarChart" style="min-height: 340px;"></div>
            </div>
        </div>
    </div>

    <!-- Fee Collection Efficiency Bar -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-cash-stack text-success me-2"></i>Fee Collection Efficiency Comparison (%)</h5>
                <span class="text-muted small">Percentage of billed tuition collected per institution</span>
            </div>
            <div class="card-body p-3">
                <div id="feeEfficiencyChart" style="min-height: 340px;"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Academic Radar Matrix -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-radar text-info me-2"></i>Institutional Operational Radar</h5>
                <span class="text-muted small">Attendance, Result publishing rate, and CBT engagement</span>
            </div>
            <div class="card-body p-3">
                <div id="radarComparisonChart" style="min-height: 340px;"></div>
            </div>
        </div>
    </div>

    <!-- CBT & PIN Verification Throughput -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-check text-warning me-2"></i>Scratch PINs &amp; Result Checker Volume</h5>
                <span class="text-muted small">Total PIN verifications and published result cards</span>
            </div>
            <div class="card-body p-3">
                <div id="pinVolumeChart" style="min-height: 340px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", async function () {
        const resp = await fetch('/api/v1/telemetry/chart-data');
        const data = await resp.json();

        // 1. Capacity Bar Chart
        new ApexCharts(document.querySelector("#capacityBarChart"), {
            series: [
                { name: 'Students', data: data.comparison.students },
                { name: 'Faculty Staff', data: data.comparison.staff }
            ],
            chart: { type: 'bar', height: 320, toolbar: { show: false } },
            colors: ['#2563eb', '#10b981'],
            plotOptions: { bar: { horizontal: true, barHeight: '50%', borderRadius: 4 } },
            xaxis: { categories: data.comparison.labels }
        }).render();

        // 2. Fee Efficiency Bar
        new ApexCharts(document.querySelector("#feeEfficiencyChart"), {
            series: [{ name: 'Recovery Rate (%)', data: data.comparison.feeEfficiency }],
            chart: { type: 'bar', height: 320, toolbar: { show: false } },
            colors: ['#059669'],
            plotOptions: { bar: { borderRadius: 6, columnWidth: '40%' } },
            xaxis: { categories: data.comparison.labels },
            yaxis: { max: 100, title: { text: 'Percentage (%)' } }
        }).render();

        // 3. Radar Chart
        new ApexCharts(document.querySelector("#radarComparisonChart"), {
            series: [
                { name: 'Average Performance Score', data: [94, 88, 92, 85, 90] }
            ],
            chart: { height: 320, type: 'radar', toolbar: { show: false } },
            colors: ['#0284c7'],
            xaxis: { categories: ['Daily Attendance', 'Fee Recovery', 'Result Publishing', 'CBT Exams', 'System Uptime'] }
        }).render();

        // 4. PIN Volume Chart
        new ApexCharts(document.querySelector("#pinVolumeChart"), {
            series: [
                { name: 'Result PINs Verified', data: data.comparison.students.map(s => Math.round(s * 1.3)) },
                { name: 'Terminal Results Published', data: data.comparison.students.map(s => Math.round(s * 0.96)) }
            ],
            chart: { type: 'bar', height: 320, toolbar: { show: false } },
            colors: ['#f59e0b', '#8b5cf6'],
            plotOptions: { bar: { borderRadius: 4, columnWidth: '45%' } },
            xaxis: { categories: data.comparison.labels }
        }).render();
    });
</script>
}
