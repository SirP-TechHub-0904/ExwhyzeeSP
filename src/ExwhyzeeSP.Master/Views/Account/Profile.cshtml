@model ExwhyzeeSP.Master.Models.AdminProfileViewModel
@{
    ViewData["Title"] = "Administrator Profile";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">

    <!-- Page Header & Action Controls -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Master Administrator Profile</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                    Security Verified
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)]">
                Manage your operator identity, contact details, and platform security credentials.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="ChangePassword" class="btn btn-outline border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none transition-colors">
                <i class="icon-key text-[14px] text-amber-500"></i>
                <span>Change Password</span>
            </a>
            <a asp-action="TwoFactor" class="btn btn-outline border-emerald-200 dark:border-emerald-900/40 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none transition-colors">
                <i class="icon-shield-check text-[14px]"></i>
                <span>2FA Security</span>
            </a>
            <a href="/Admin/Account/ActivityLog" class="btn btn-outline border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none transition-colors">
                <i class="icon-clock text-[14px] text-sky-500"></i>
                <span>Audit Trail</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3 shadow-sm">
            <i class="icon-check-circle text-[18px]"></i>
            <span class="text-xs font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Left Profile Badge Card (4 cols) -->
        <div class="lg:col-span-4 space-y-4">
            <div class="surface-card rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm text-center relative overflow-hidden">
                <div class="absolute top-0 inset-x-0 h-20 bg-gradient-to-r from-sky-500/20 via-primary-500/15 to-indigo-500/20"></div>

                <!-- Avatar with Status Pill -->
                <div class="relative inline-block mt-4 mb-3">
                    <img src="/img/icon-exwhyzeesp.jpg?v=2"
                         alt="@Model.FullName"
                         class="w-24 h-24 rounded-2xl object-cover shadow-md border-4 border-white dark:border-slate-900 bg-white dark:bg-slate-800 relative z-10" />
                    <span class="absolute -bottom-1 -end-1 z-20 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-slate-900" title="Active Administrator Session"></span>
                </div>

                <!-- Name & Role -->
                <h3 class="text-lg font-bold text-[var(--text-primary)]">@Model.FullName</h3>
                <p class="text-xs font-mono text-[var(--text-secondary)] mt-0.5">@Model.Email</p>

                <div class="mt-3">
                    @if (Model.RoleTitle == "SuperAdmin")
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60">
                            <i class="icon-shield-check text-xs"></i> SuperAdmin (Root Owner)
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                            <i class="icon-shield text-xs"></i> @Model.RoleTitle
                        </span>
                    }
                </div>

                <!-- Account Meta Breakdown -->
                <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-left text-xs space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-[var(--text-secondary)]">Account Created:</span>
                        <span class="font-semibold text-[var(--text-primary)]">@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-[var(--text-secondary)]">Last Authenticated:</span>
                        <span class="font-semibold text-[var(--text-primary)]">@(Model.LastLoginUtc?.ToString("MMM dd, yyyy HH:mm") ?? "Active Now")</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-[var(--text-secondary)]" title="Network IP address of your device/gateway when signing in">Client IP / Origin:</span>
                        <div class="flex items-center gap-1.5">
                            <code class="font-mono text-[11px] font-semibold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">@(Model.LastLoginIp ?? "127.0.0.1")</code>
                            @if (Model.LastLoginIp == "::1" || Model.LastLoginIp == "127.0.0.1" || string.IsNullOrEmpty(Model.LastLoginIp))
                            {
                                <span class="text-[10px] text-slate-400 font-mono" title="Localhost Loopback Network Address">(Localhost)</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-3">
                    <a asp-action="ActivityLog" asp-controller="Account" asp-area="" asp-route-search="@Model.Email" class="btn btn-outline border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold w-full py-2.5 rounded-xl flex items-center justify-center gap-2 transition-colors text-decoration-none shadow-xs cursor-pointer" title="Inspect Security Logs for @Model.Email">
                        <i class="bi bi-clock-history text-sm text-sky-500"></i>
                        <span>Inspect Security Activity Log</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Profile Form Card (8 cols) -->
        <div class="lg:col-span-8">
            <div class="surface-card rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm">
                <div class="border-b border-slate-100 dark:border-slate-800/80 pb-4 mb-5">
                    <h2 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                        <i class="icon-user text-[18px] text-sky-500"></i>
                        <span>Edit Administrator Information</span>
                    </h2>
                    <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                        Update your administrator legal display name and contact phone number.
                    </p>
                </div>

                <form asp-action="Profile" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="RoleTitle" />

                    <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 text-xs" role="alert"></div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="FullName" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                                Full Legal Name <span class="text-rose-500">*</span>
                            </label>
                            <input asp-for="FullName" class="w-full h-11 px-4 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[var(--text-primary)] font-semibold placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition shadow-xs" placeholder="e.g. Master Super Administrator" required />
                            <span asp-validation-for="FullName" class="text-xs text-rose-600 mt-1.5 block font-medium"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                                Official Admin Email
                            </label>
                            <input asp-for="Email" class="w-full h-11 px-4 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono text-slate-500 dark:text-slate-400 cursor-not-allowed outline-none shadow-xs" readonly disabled />
                            <span class="text-[11px] text-[var(--text-secondary)] mt-1.5 block">Email is locked to your identity root configuration.</span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="PhoneNumber" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                            Phone / WhatsApp Number
                        </label>
                        <input asp-for="PhoneNumber" class="w-full h-11 px-4 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[var(--text-primary)] font-mono placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition shadow-xs" placeholder="+234 800 000 0000" />
                        <span asp-validation-for="PhoneNumber" class="text-xs text-rose-600 mt-1.5 block font-medium"></span>
                    </div>

                    <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 dark:border-slate-800/80">
                        <button type="submit" class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-xl flex items-center gap-1.5 shadow-sm bg-sky-600 hover:bg-sky-700 text-white transition-colors cursor-pointer">
                            <i class="bi bi-check-lg text-[15px]"></i>
                            <span>Save Profile Details</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>

</div>
