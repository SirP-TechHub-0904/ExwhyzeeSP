@{
    ViewData["Title"] = "About Us";
    ViewData["MetaDescription"] = "Learn about Exwhyzee SP - our mission, school portal cloud architecture, and commitment to transforming educational management across Africa and beyond.";
    Layout = "_PublicLayout";
}

<!-- Page Header Start -->
<div class="sisf-page-header position-relative">
   <div class="sisf-page-header-image">
      <figure>
         <img src="/assets/images/page-banner.png" alt="About Exwhyzee SP">
      </figure>
   </div>
   <div class="container">
      <div class="row align-items-center">
         <div class="col-lg-12">
            <div class="sisf-page-header-content text-center">
               <h1 class="text-white" data-aos="fade-up">About Exwhyzee SP</h1>
               <ul class="list-unstyled d-flex align-items-center justify-content-center gap-2 m-0" data-aos="fade-up" data-aos-delay="200">
                  <li><a href="/" class="text-white">Home</a></li>
                  <li><span class="text-white">/</span></li>
                  <li class="text-white">About Us</li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Page Header End -->

<!-- About Story Section -->
<div class="py-5">
   <div class="container py-4">
      <div class="row align-items-center g-5">
         <div class="col-lg-6" data-aos="fade-right">
            <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Our Mission &amp; Purpose</span>
            <h2 class="display-6 fw-bold">Digitizing School Management with Precision, Security &amp; Speed</h2>
            <p class="lead text-muted mt-3">
               Exwhyzee SP was engineered by <strong>Exwhyzee Technologies</strong> to eliminate the administrative bottlenecks, paperwork fatigue, and revenue leaks faced by modern educational institutions.
            </p>
            <p class="text-secondary">
               From Nursery, Primary, and Secondary Schools to Polytechnics and Colleges of Education, our school portal cloud platform provides a turnkey digital infrastructure. Each school operates in complete security with its own custom branding, unique domain/subdomain, and isolated student records.
            </p>
            <div class="row g-3 mt-3">
               <div class="col-sm-6">
                  <div class="p-3 border rounded-3 bg-light">
                     <h4 class="fw-bold text-primary mb-1">99.9%</h4>
                     <p class="small text-muted mb-0">Platform Uptime &amp; Cloud Availability</p>
                  </div>
               </div>
               <div class="col-sm-6">
                  <div class="p-3 border rounded-3 bg-light">
                     <h4 class="fw-bold text-success mb-1">Zero</h4>
                     <p class="small text-muted mb-0">Computational Errors in Report Cards</p>
                  </div>
               </div>
            </div>
         </div>
         <div class="col-lg-6 text-center" data-aos="zoom-in">
            <div class="p-4 bg-light rounded-4 border shadow">
               <img src="/assets/images/teacher-grading.jpg" alt="Educators using Exwhyzee SP" class="img-fluid rounded-3 shadow mb-3" style="max-height: 320px; width:100%; object-fit:cover;">
               <h5 class="fw-bold text-dark mt-2">Next-Generation School ERP</h5>
               <p class="small text-muted mb-0">Designed for African &amp; Global Institutional Curriculums</p>
            </div>
         </div>
      </div>
   </div>
</div>

<!-- Core Values Section -->
<div class="py-5 bg-light">
   <div class="container py-4">
      <div class="text-center mb-5" data-aos="fade-up">
         <span class="badge bg-secondary px-3 py-2 text-uppercase mb-2">Why Schools Choose Us</span>
         <h2 class="display-6 fw-bold">The Core Pillars of Exwhyzee SP</h2>
      </div>
      <div class="row g-4">
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
            <div class="card h-100 border-0 shadow-sm p-4 bg-white rounded-4">
               <i class="fa-solid fa-lock text-primary fs-2 mb-3"></i>
               <h4 class="fw-bold">Enterprise Security &amp; Privacy</h4>
               <p class="text-muted small">Independent school accounts ensure complete separation of records, strict role-based access, device verification, and automated encrypted backups.</p>
            </div>
         </div>
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
            <div class="card h-100 border-0 shadow-sm p-4 bg-white rounded-4">
               <i class="fa-solid fa-sliders text-success fs-2 mb-3"></i>
               <h4 class="fw-bold">100% Customizable Workflows</h4>
               <p class="text-muted small">Configure custom grading scales (WAEC, NECO, IGCSE, British, Montessori), flexible school fee installments, and custom domain names.</p>
            </div>
         </div>
         <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
            <div class="card h-100 border-0 shadow-sm p-4 bg-white rounded-4">
               <i class="fa-solid fa-headset text-warning fs-2 mb-3"></i>
               <h4 class="fw-bold">Dedicated Onboarding &amp; Support</h4>
               <p class="text-muted small">Our educational technology consultants handle full data migration from your legacy sheets, conduct staff training, and provide prompt phone/WhatsApp support.</p>
            </div>
         </div>
      </div>
   </div>
</div>

<!-- CTA -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, #071e3d 0%, #1f4287 100%);">
   <div class="container py-4 text-center">
      <h2 class="display-6 fw-bold mb-3">Ready to Partner with Exwhyzee SP?</h2>
      <p class="lead mb-4 mx-auto" style="max-width: 650px;">Get your school portal up and running in less than 48 hours with full data onboarding.</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
         <a href="/Demo" class="sis-btn-default shadow-none bg-white text-dark fw-bold">Request Live Demo <i class="fa-solid fa-arrow-right-long"></i></a>
         <a href="/Contact" class="btn btn-outline-light px-4 py-3 rounded-pill fw-bold">Contact Our Team</a>
      </div>
   </div>
</div>
