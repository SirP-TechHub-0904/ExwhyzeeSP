@{
    ViewBag.Title = "Card Batch Delete";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> DANGER: Mass Delete Scratch Card Batch</h3>
            </div>

            <div class="box-body">
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                        @TempData["error"]
                    </div>
                }
                @if (TempData["msg"] != null)
                {
                    <div class="alert alert-success alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-check"></i> Success!</h4>
                        @TempData["msg"]
                    </div>
                }

                <div class="callout callout-danger">
                    <h4><i class="fa fa-warning"></i> Permanent Deletion Warning</h4>
                    <p>
                        Entering a batch number below will <strong>permanently purge all scratch card PINs</strong> generated in that batch.
                    </p>
                </div>

                @using (Html.BeginForm("DeleteCard", "ImportFromExcel", new { area = "SuperUser" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="batchnumber">Batch Number <span class="text-danger">*</span></label>
                        <input id="batchnumber" name="batchnumber" type="text" placeholder="Enter batch number (e.g. BATCH-001)" class="form-control input-lg" required="required" />
                    </div>

                    <div class="form-group" style="margin-top: 25px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve deleting all cards in this batch, type <strong style="text-decoration: underline; letter-spacing: 1px;">CONFIRM</strong>:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>

                    <div class="box-footer" style="padding: 15px 0 0 0; background: transparent;">
                        <button type="submit" id="btnSubmitDelete" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                            <i class="fa fa-trash"></i> Approve & Delete Batch PINs
                        </button>
                        <a href="@Url.Action("UploadCard", "ImportFromExcel", new { area = "SuperUser" })" class="btn btn-default btn-lg btn-flat pull-right">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitDelete');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
