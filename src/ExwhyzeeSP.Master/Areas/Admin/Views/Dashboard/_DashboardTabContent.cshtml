@model ExwhyzeeSP.Master.Models.DashboardTabViewModel

<!-- ================= 1. 4 MASTER CLICKABLE KPI STAT CARDS ================= -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

    @if (Model.ActiveTab == "schools")
    {
        <!-- Schools Card 1: Total Schools -->
        <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-[var(--color-primary-500)] hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-[var(--color-primary-600)] transition-colors">Total Schools</span>
                    <h3 class="text-3xl font-display font-bold mt-1 text-[var(--text-primary)]">@Model.TotalSchools</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Enrolled Institutions</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                    <i class="icon-school text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-[var(--color-primary-600)] font-medium">Click to view all schools</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Schools Card 2: Active Schools -->
        <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" asp-route-statusFilter="active" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Active Schools</span>
                    <h3 class="text-3xl font-display font-bold mt-1 text-emerald-600 dark:text-emerald-400">@Model.ActiveSchools</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Live &amp; Operational Sites</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-check-circle text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">Click to filter active</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Schools Card 3: Inactive Schools -->
        <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" asp-route-statusFilter="inactive" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-amber-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-amber-600 transition-colors">Inactive / On Hold</span>
                    <h3 class="text-3xl font-display font-bold mt-1 text-amber-600 dark:text-amber-400">@Model.InactiveSchools</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Suspended or Pending</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
                    <i class="icon-alert-triangle text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-amber-600 font-medium">Click to view inactive</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Schools Card 4: Detailed School Statistics -->
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-indigo-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-indigo-600 transition-colors">School Matrix</span>
                    <h3 class="text-3xl font-display font-bold mt-1 text-indigo-600 dark:text-indigo-400">100%</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Multi-School Comparison</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                    <i class="icon-bar-chart-4 text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-indigo-600 font-medium">Open performance matrix</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    }
    else if (Model.ActiveTab == "finance")
    {
        <!-- Finance Card 1: Revenue Collected -->
        <a asp-area="Admin" asp-controller="Billing" asp-action="Index" asp-route-status="Paid" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Total Revenue</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-emerald-600 dark:text-emerald-400">₦@Model.TotalRevenue.ToString("N0")</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">@Model.PaidInvoicesCount Invoices Paid</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-wallet text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">View paid transactions</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Finance Card 2: Pending Invoices -->
        <a asp-area="Admin" asp-controller="Billing" asp-action="Index" asp-route-status="Pending" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-amber-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-amber-600 transition-colors">Pending Invoices</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-amber-600 dark:text-amber-400">@Model.PendingInvoicesCount</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">₦@Model.TotalPendingRevenue.ToString("N0") outstanding</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
                    <i class="icon-clock text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-amber-600 font-medium">View pending bills</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Finance Card 3: Overdue Invoices -->
        <a asp-area="Admin" asp-controller="Billing" asp-action="Index" asp-route-status="Overdue" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-rose-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-rose-600 transition-colors">Overdue Invoices</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-rose-600 dark:text-rose-400">@Model.OverdueInvoicesCount</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Requires follow-up</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 group-hover:scale-110 transition-transform">
                    <i class="icon-alert-circle text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-rose-600 font-medium">View overdue list</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Finance Card 4: Subscription Plans -->
        <a asp-area="Admin" asp-controller="PricingPlans" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Subscription Tiers</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-[var(--text-primary)]">@Model.ActivePlansCount</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Active Pricing Packages</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-tag text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">Manage pricing plans</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    }
    else if (Model.ActiveTab == "academics")
    {
        <!-- Academics Card 1: Total Students -->
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Demographics" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-sky-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-sky-600 transition-colors">Total Students</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-sky-600 dark:text-sky-400">@Model.TotalStudents.ToString("N0")</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Enrolled across schools</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                    <i class="icon-users text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-sky-600 font-medium">View demographics</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Academics Card 2: Total Staff -->
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-indigo-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-indigo-600 transition-colors">Total Staff</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-indigo-600 dark:text-indigo-400">@Model.TotalStaff.ToString("N0")</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Teachers &amp; Admin</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                    <i class="icon-user-check text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-indigo-600 font-medium">View staff statistics</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Academics Card 3: Attendance Rate -->
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Avg Attendance</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-emerald-600 dark:text-emerald-400">@Model.AvgAttendance%</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Daily Platform Benchmark</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-calendar text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">View attendance analytics</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Academics Card 4: PINs & Assessments -->
        <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-purple-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-purple-600 transition-colors">PINs &amp; Results</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-purple-600 dark:text-purple-400">@Model.TotalPinsVerified</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">@Model.TotalCbtExams CBT Exams Run</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 group-hover:scale-110 transition-transform">
                    <i class="icon-award text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-purple-600 font-medium">View assessment activity</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    }
    else if (Model.ActiveTab == "marketing")
    {
        <!-- Marketing Card 1: Verified Leads -->
        <a asp-area="Admin" asp-controller="Marketing" asp-action="Contacts" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Audience Contacts</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-emerald-600 dark:text-emerald-400">@Model.TotalContacts</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Verified School Leads</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-contact text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">Manage CRM leads</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Marketing Card 2: Broadcasts Sent -->
        <a asp-area="Admin" asp-controller="Marketing" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-amber-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-amber-600 transition-colors">Broadcasts Sent</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-amber-600 dark:text-amber-400">@Model.TotalCampaigns</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Email Campaigns</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
                    <i class="icon-send text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-amber-600 font-medium">View all campaigns</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Marketing Card 3: Delivered Emails -->
        <a asp-area="Admin" asp-controller="Marketing" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-sky-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-sky-600 transition-colors">Emails Delivered</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-sky-600 dark:text-sky-400">@Model.TotalDelivered</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Recipient Inboxes</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                    <i class="icon-mail text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-sky-600 font-medium">Check delivery logs</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Marketing Card 4: Templates -->
        <a asp-area="Admin" asp-controller="Marketing" asp-action="Templates" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-purple-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-purple-600 transition-colors">Email Templates</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-purple-600 dark:text-purple-400">@Model.TotalTemplates</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Pre-built Designs</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 group-hover:scale-110 transition-transform">
                    <i class="icon-layout text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-purple-600 font-medium">Manage templates</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    }
    else if (Model.ActiveTab == "content")
    {
        <!-- Content Card 1: Knowledge Guides -->
        <a asp-area="Admin" asp-controller="KnowledgeBaseAdmin" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-sky-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-sky-600 transition-colors">Knowledge Guides</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-sky-600 dark:text-sky-400">@Model.TotalKb</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Tutorials &amp; Articles</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 group-hover:scale-110 transition-transform">
                    <i class="icon-book-open text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-sky-600 font-medium">Manage guides</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Content Card 2: Blog News -->
        <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-indigo-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-indigo-600 transition-colors">News &amp; Articles</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-indigo-600 dark:text-indigo-400">@Model.TotalBlogs</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Published Blog Posts</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                    <i class="icon-newspaper text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-indigo-600 font-medium">Manage news posts</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Content Card 3: Testimonials -->
        <a asp-area="Admin" asp-controller="Testimonies" asp-action="Index" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-amber-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-amber-600 transition-colors">Client Reviews</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-amber-600 dark:text-amber-400">@Model.TotalTestimonies</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Approved Testimonials</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform">
                    <i class="icon-message-square-quote text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-amber-600 font-medium">Manage reviews</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>

        <!-- Content Card 4: Audit Logs -->
        <a asp-controller="Account" asp-action="ActivityLog" asp-area="" class="surface-card rounded-2xl p-4 border border-[var(--border-subtle)] bg-[var(--surface-raised)] hover:border-emerald-500 hover:shadow-md transition-all text-decoration-none block group">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-[11.5px] font-semibold uppercase tracking-wider text-[var(--text-tertiary)] group-hover:text-emerald-600 transition-colors">Audit &amp; Security</span>
                    <h3 class="text-2xl font-display font-bold mt-1 text-emerald-600 dark:text-emerald-400">@Model.TotalAuditLogs</h3>
                    <p class="text-[12px] text-[var(--text-secondary)] mt-1">Logged Actions</p>
                </div>
                <div class="grid place-items-center size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">
                    <i class="icon-shield-check text-xl"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11.5px]">
                <span class="text-[var(--text-tertiary)] group-hover:text-emerald-600 font-medium">View audit history</span>
                <i class="icon-arrow-right text-[11px] text-[var(--text-tertiary)] group-hover:translate-x-1 transition-transform"></i>
            </div>
        </a>
    }

</div>

<!-- ================= 2. GRAPHICAL VISUALIZATION WITH 3-WAY MULTI-VIEW SWITCHER ================= -->
<div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm p-4 sm:p-5 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
        <div>
            <h3 class="font-display font-bold text-base text-[var(--text-primary)] flex items-center gap-2">
                <i class="icon-bar-chart-2 text-[16px] text-[var(--color-primary-600)]"></i>
                <span>@Model.ChartTitle</span>
            </h3>
            <p class="text-[12px] text-[var(--text-tertiary)] mt-0.5">Statistical breakdown and performance distribution for the selected date range.</p>
        </div>

        <!-- 3-Way Graph Type Switcher Controls -->
        <div class="inline-flex items-center p-1 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] self-start sm:self-auto" id="chartViewControls">
            <button type="button" class="chart-mode-btn active px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-[var(--surface-raised)] text-[var(--text-primary)] shadow-sm" data-chart-type="bar">
                <i class="icon-bar-chart text-[12px] me-1"></i> Bar Chart
            </button>
            <button type="button" class="chart-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-all" data-chart-type="area">
                <i class="icon-trending-up text-[12px] me-1"></i> Trend Area
            </button>
            <button type="button" class="chart-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-all" data-chart-type="donut">
                <i class="icon-pie-chart text-[12px] me-1"></i> Distribution
            </button>
        </div>
    </div>

    <!-- Canvas Container (Decent compact height) -->
    <div class="relative mt-3 w-full" style="height: 220px; max-height: 230px; position: relative;">
        <canvas id="dashboardActiveChart" style="max-height: 220px; width: 100%;"></canvas>
    </div>
</div>

<!-- ================= 3. THREE TOP-10 / BREAKDOWN RANKING CARDS WITH "VIEW MORE" BUTTONS ================= -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    @if (Model.ActiveTab == "schools")
    {
        <!-- List Card 1: Top 10 Schools by Student Population -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center text-xs font-bold">1</span>
                        Top Schools by Students
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Ranked by enrolled student population.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.TopSchoolsByStudents.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No student records found.</div>
                }
                else
                {
                    int rank = 1;
                    @foreach (var s in Model.TopSchoolsByStudents)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="size-5 rounded-full bg-[var(--surface-sunken)] border text-[10.5px] font-bold grid place-items-center shrink-0 @(rank <= 3 ? "text-amber-600 border-amber-500/30" : "text-[var(--text-tertiary)]")">
                                    @rank
                                </span>
                                <div class="min-w-0">
                                    <a asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@s.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-[var(--color-primary-600)] truncate block text-decoration-none">
                                        @s.SchoolName
                                    </a>
                                    <span class="text-[11px] text-[var(--text-tertiary)] block truncate">@@@s.SubDomain &bull; @s.StaffCount staff</span>
                                </div>
                            </div>
                            <span class="badge-soft badge-primary text-[11px] font-bold shrink-0">
                                @s.StudentCount.ToString("N0") pupils
                            </span>
                        </div>
                        rank++;
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Analytics" asp-action="Demographics" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Demographics</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- List Card 2: Top 10 Recently Enrolled Schools -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center text-xs font-bold">2</span>
                        Recently Enrolled Schools
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Newest school additions on the portal.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentSchools.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No recent schools found.</div>
                }
                else
                {
                    int rank = 1;
                    @foreach (var s in Model.RecentSchools)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="size-5 rounded-full bg-[var(--surface-sunken)] border text-[10.5px] font-bold text-[var(--text-tertiary)] grid place-items-center shrink-0">
                                    @rank
                                </span>
                                <div class="min-w-0">
                                    <a asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@s.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-[var(--color-primary-600)] truncate block text-decoration-none">
                                        @s.SchoolName
                                    </a>
                                    <span class="text-[11px] text-[var(--text-tertiary)] block truncate">Added @s.DateCreated.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            @if (s.IsActive)
                            {
                                <span class="badge-soft badge-success text-[10.5px] shrink-0">Active</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-danger text-[10.5px] shrink-0">Inactive</span>
                            }
                        </div>
                        rank++;
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More in School Directory (@Model.TotalSchools)</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- List Card 3: Inactive / Suspended Schools -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 grid place-items-center text-xs font-bold">3</span>
                        Inactive / Suspended Schools
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Portals requiring administrative action.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.InactiveSchoolList.Any())
                {
                    <div class="py-12 text-center text-xs text-[var(--text-tertiary)]">
                        <i class="icon-check-circle text-emerald-500 text-2xl mb-1 block"></i>
                        All @Model.TotalSchools schools are operational &amp; active!
                    </div>
                }
                else
                {
                    @foreach (var s in Model.InactiveSchoolList)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <a asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@s.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-amber-600 truncate block text-decoration-none">
                                    @s.SchoolName
                                </a>
                                <span class="text-[11px] text-[var(--text-tertiary)] block truncate">@@@s.SubDomain</span>
                            </div>
                            <a asp-area="Admin" asp-controller="Tenants" asp-action="AccessControl" asp-route-id="@s.Id" class="btn btn-outline border-amber-500/30 text-amber-600 hover:bg-amber-500/10 text-[11px] font-semibold px-2 py-1 rounded">
                                Resolve
                            </a>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Tenants" asp-action="Index" asp-route-statusFilter="inactive" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Inactive Schools</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "finance")
    {
        <!-- List Card 1: Top 10 Revenue Contributing Schools -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center text-xs font-bold">1</span>
                        Top Revenue Schools
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Highest subscription payers.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.TopRevenueSchools.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No paid transactions recorded.</div>
                }
                else
                {
                    int rank = 1;
                    @foreach (var s in Model.TopRevenueSchools)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="size-5 rounded-full bg-[var(--surface-sunken)] border text-[10.5px] font-bold text-emerald-600 grid place-items-center shrink-0">
                                    @rank
                                </span>
                                <div class="min-w-0">
                                    <span class="text-xs font-semibold text-[var(--text-primary)] truncate block">@s.SchoolName</span>
                                    <span class="text-[11px] text-[var(--text-tertiary)] block">@s.InvoicesCount invoice(s) paid</span>
                                </div>
                            </div>
                            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 shrink-0">
                                ₦@s.TotalPaid.ToString("N0")
                            </span>
                        </div>
                        rank++;
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Billing" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More in Financial Ledger</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- List Card 2: Recent Transactions -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center text-xs font-bold">2</span>
                        Recent Invoices
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Latest generated school invoices.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentTransactions.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No invoices found.</div>
                }
                else
                {
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <a asp-area="Admin" asp-controller="Billing" asp-action="Details" asp-route-id="@tx.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-[var(--color-primary-600)] truncate block text-decoration-none">
                                    @(tx.TenantSchool?.SchoolName ?? "School #" + tx.TenantSchoolId)
                                </a>
                                <span class="text-[11px] text-[var(--text-tertiary)] block">@tx.InvoiceNumber &bull; @tx.CreatedAt.ToString("MMM dd")</span>
                            </div>
                            <div class="text-end shrink-0">
                                <span class="text-xs font-bold text-[var(--text-primary)] block">₦@tx.Amount.ToString("N0")</span>
                                @if (tx.Status == SchoolPaymentStatus.Paid)
                                {
                                    <span class="badge-soft badge-success text-[10px]">Paid</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-warning text-[10px]">@tx.Status</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Billing" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Invoices</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- List Card 3: Pending / Overdue Invoices -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-rose-500/10 text-rose-600 dark:text-rose-400 grid place-items-center text-xs font-bold">3</span>
                        Pending / Overdue Invoices
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Bills requiring immediate collection.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.PendingTransactions.Any())
                {
                    <div class="py-12 text-center text-xs text-[var(--text-tertiary)]">
                        <i class="icon-check-circle text-emerald-500 text-2xl mb-1 block"></i>
                        No overdue or pending invoices!
                    </div>
                }
                else
                {
                    @foreach (var tx in Model.PendingTransactions)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <a asp-area="Admin" asp-controller="Billing" asp-action="Details" asp-route-id="@tx.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-rose-600 truncate block text-decoration-none">
                                    @(tx.TenantSchool?.SchoolName ?? "School #" + tx.TenantSchoolId)
                                </a>
                                <span class="text-[11px] text-rose-500 block">Due: @tx.DueDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <span class="text-xs font-bold text-rose-600 dark:text-rose-400 shrink-0">
                                ₦@tx.Amount.ToString("N0")
                            </span>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Billing" asp-action="Index" asp-route-status="Pending" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Pending Bills</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "academics")
    {
        <!-- Academics Card 1: Top Attendance Schools -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center text-xs font-bold">1</span>
                        Top Schools by Attendance
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Highest average daily attendance.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
