                    <!-- Right Header Action Controls -->
                    <div class="ms-auto flex items-center gap-2.5 lg:gap-3">

                        <!-- Quick Create -->
                        <div class="hs-dropdown relative hidden sm:block">
                            <button type="button" class="hs-dropdown-toggle inline-flex items-center gap-2 h-10 ps-3.5 pe-3 rounded-full text-[12.5px] font-semibold text-white transition-all bg-[var(--color-primary-600)] hover:bg-[var(--color-primary-700)] shadow-sm" aria-haspopup="menu" aria-expanded="false">
                                <i class="icon-plus text-[13px]"></i>
                                <span>Quick Action</span>
                                <i class="icon-chevron-down text-[9px] opacity-80"></i>
