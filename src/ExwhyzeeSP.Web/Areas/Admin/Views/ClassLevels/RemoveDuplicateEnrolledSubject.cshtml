@model ExwhyzeeSP.Core.Entities.ClassLevel

@{
    ViewBag.Title = "Remove Duplicate Enrolled Subjects";
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> Mass Clean: Remove Duplicate Enrolled Subjects</h3>
            </div>
            
            <div class="box-body">
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                        @TempData["error"]
                    </div>
                }

                <div class="callout callout-warning">
                    <h4><i class="fa fa-info-circle"></i> Clean-up Duplicate Enrollments</h4>
                    <p>
                        This will scan the active academic session for <strong>@Model.ClassName</strong> and permanently remove redundant duplicate enrolled subject entries while keeping the primary record intact.
                    </p>
                </div>

                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <th style="width: 35%;">Class Level:</th>
                            <td><strong class="text-primary" style="font-size: 16px;">@Model.ClassName</strong></td>
                        </tr>
                    </tbody>
                </table>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-top: 25px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve removing duplicate enrolled subjects, type <strong style="text-decoration: underline; letter-spacing: 1px;">CONFIRM</strong>:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>

                    <div class="box-footer" style="padding: 15px 0 0 0; background: transparent;">
                        <button type="submit" id="btnSubmitRemove" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                            <i class="fa fa-trash"></i> Approve & Remove Duplicates
                        </button>
                        <a href="@Url.Action("Details", "ClassLevels", new { area = "Admin", id = Model.Id })" class="btn btn-default btn-lg btn-flat pull-right">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitRemove');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
