@{
    ViewData["Title"] = "Contact Us";
    ViewData["MetaDescription"] = "Get in touch with Exwhyzee SP technical support, sales, and educational consulting team.";
    Layout = "_PublicLayout";
}

<!-- Page Header Start -->
<div class="sisf-page-header position-relative">
   <div class="sisf-page-header-image">
      <figure>
         <img src="/assets/images/page-banner.png" alt="Contact Exwhyzee SP">
      </figure>
   </div>
   <div class="container">
      <div class="row align-items-center">
         <div class="col-lg-12">
            <div class="sisf-page-header-content text-center">
               <h1 class="text-white" data-aos="fade-up">Contact Exwhyzee SP</h1>
               <ul class="list-unstyled d-flex align-items-center justify-content-center gap-2 m-0" data-aos="fade-up" data-aos-delay="200">
                  <li><a href="/" class="text-white">Home</a></li>
                  <li><span class="text-white">/</span></li>
                  <li class="text-white">Contact Us</li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Page Header End -->

<div class="py-5">
   <div class="container py-4">
      <div class="row g-5">
         <!-- Contact Information Column -->
         <div class="col-lg-5" data-aos="fade-right">
            <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">We Are Here For You</span>
            <h2 class="display-6 fw-bold mb-4">Let's Discuss Your School's Digital Transformation</h2>
            <p class="text-muted mb-4">
               Have questions regarding portal school portaling, custom feature requests, or pricing? Reach out to our dedicated educational technology consultants.
            </p>

            <div class="d-flex flex-column gap-4">
               <div class="d-flex align-items-start gap-3 p-3 border rounded-3 bg-white shadow-sm">
                  <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-4"><i class="fa-solid fa-phone"></i></div>
                  <div>
                     <strong class="d-block text-dark">Phone / WhatsApp Helpline</strong>
                     <a href="tel:+2348000000000" class="text-primary text-decoration-none">+234 (0) 800-EXWHYZEE</a>
                     <span class="d-block small text-muted">Mon - Fri: 8:00 AM - 6:00 PM</span>
                  </div>
               </div>

               <div class="d-flex align-items-start gap-3 p-3 border rounded-3 bg-white shadow-sm">
                  <div class="rounded-circle bg-success-subtle text-success p-3 fs-4"><i class="fa-solid fa-envelope"></i></div>
                  <div>
                     <strong class="d-block text-dark">Official Email</strong>
                     <a href="mailto:info@exwhyzee.ng" class="text-success text-decoration-none">info@exwhyzee.ng</a>
                     <span class="d-block small text-muted">24/7 fast ticket &amp; email responses</span>
                  </div>
               </div>

               <div class="d-flex align-items-start gap-3 p-3 border rounded-3 bg-white shadow-sm">
                  <div class="rounded-circle bg-warning-subtle text-warning p-3 fs-4"><i class="fa-solid fa-location-dot"></i></div>
                  <div>
                     <strong class="d-block text-dark">Technology Headquarters</strong>
                     <span class="text-secondary">Exwhyzee Technologies, Nigeria</span>
                  </div>
               </div>
            </div>
         </div>

         <!-- Contact Form Column -->
         <div class="col-lg-7" data-aos="fade-left">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
               <h3 class="fw-bold mb-2">Send Us a Direct Message</h3>
               <p class="text-muted small mb-4">Fill out the inquiry form below and we'll reply within a few hours.</p>

               <form action="/Contact" method="post">
                  <div class="row g-3">
                     <div class="col-md-6">
                        <label class="form-label fw-semibold">Your Name *</label>
                        <input type="text" class="form-control" name="Name" placeholder="e.g. Samuel Okon" required>
                     </div>
                     <div class="col-md-6">
                        <label class="form-label fw-semibold">School Name *</label>
                        <input type="text" class="form-control" name="SchoolName" placeholder="e.g. Grace International College" required>
                     </div>
                     <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Address *</label>
                        <input type="email" class="form-control" name="Email" placeholder="samuel@graceschool.com" required>
                     </div>
                     <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone / WhatsApp Number *</label>
                        <input type="tel" class="form-control" name="Phone" placeholder="+234 801 234 5678" required>
                     </div>
                     <div class="col-12">
                        <label class="form-label fw-semibold">Subject *</label>
                        <input type="text" class="form-control" name="Subject" placeholder="Inquiry regarding portal setup / pricing" required>
                     </div>
                     <div class="col-12">
                        <label class="form-label fw-semibold">Message *</label>
                        <textarea class="form-control" rows="4" name="Message" placeholder="Tell us about your school, student population, and what you'd like to achieve..." required></textarea>
                     </div>
                     <div class="col-12 mt-4">
                        <button type="submit" class="sis-btn-default w-100 shadow text-center justify-content-center py-3">
                           Send Message <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>
                     </div>
                  </div>
               </form>
            </div>
         </div>
      </div>
   </div>
</div>
