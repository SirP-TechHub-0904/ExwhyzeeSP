                                <a asp-area="Admin" asp-controller="KnowledgeBaseAdmin" asp-action="Edit" asp-route-id="@kb.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-sky-600 truncate block text-decoration-none">
