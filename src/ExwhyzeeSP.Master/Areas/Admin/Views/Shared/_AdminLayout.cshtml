                                <a asp-area="Admin" asp-controller="Tenants" asp-action="Create" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-decoration-none text-[var(--text-primary)]"><i class="icon-school text-[15px] text-[var(--color-primary-600)]"></i>Add New School</a>
                                <a asp-area="Admin" asp-controller="AdminUsers" asp-action="Create" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-decoration-none text-[var(--text-primary)]"><i class="icon-user-plus text-[15px] text-[var(--color-primary-600)]"></i>Add Platform User</a>
                                <a asp-area="Admin" asp-controller="Marketing" asp-action="CreateCampaign" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-decoration-none text-[var(--text-primary)]"><i class="icon-send text-[15px] text-[var(--color-primary-600)]"></i>Send Broadcast</a>
                                <a asp-area="Admin" asp-controller="Billing" asp-action="Create" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-decoration-none text-[var(--text-primary)]"><i class="icon-wallet text-[15px] text-[var(--color-primary-600)]"></i>Create Invoice</a>
                            </div>
                        </div>

                        <!-- Public Website Link -->
                        <a href="/" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[12.5px] font-semibold bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors text-decoration-none" title="Visit Public Landing Page">
                            <i class="icon-globe text-[14px]"></i>
                            <span>Public Site</span>
                        </a>

                        <!-- Interactive Page Tour Guide Trigger -->
                        <button type="button" id="pageTourTriggerBtn" onclick="window.startPortalTour(true)" class="relative grid place-items-center size-8 rounded-full transition-all hover:scale-105 bg-sky-500/10 hover:bg-sky-500/20 text-sky-600 dark:text-sky-400 border border-sky-500/20 shadow-sm" title="Start Interactive Page Tour Guide" aria-label="Start Page Tour">
                            <i class="icon-help-circle text-[15px]"></i>
                            <span class="tour-pulse-badge"></span>
                        </button>

                        <!-- Theme switcher -->
                        <div class="hs-dropdown relative">
                            <button type="button" class="hs-dropdown-toggle grid place-items-center size-8 rounded-full transition-transform hover:scale-105 bg-[color-mix(in_oklab,var(--color-warning-500)_16%,transparent)] text-[var(--color-warning-600)]" aria-haspopup="menu" aria-expanded="false" aria-label="Theme">
                                <i class="icon-sun-medium text-[14px]" id="themeIcon"></i>
                            </button>
                            <div class="hs-dropdown-menu hidden transition-all duration-200 absolute end-0 top-full mt-2 w-40 p-1.5 z-50 rounded-xl shadow-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)]" role="menu">
                                <button type="button" data-theme-set="light" class="theme-option w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-start"><i class="icon-sun-medium text-[15px]"></i>Light</button>
                                <button type="button" data-theme-set="dark" class="theme-option w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-start"><i class="icon-moon text-[15px]"></i>Dark</button>
                                <button type="button" data-theme-set="system" class="theme-option w-full flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-start"><i class="icon-monitor text-[15px]"></i>System</button>
                            </div>
                        </div>

                        <!-- User profile Dropdown -->
                        <div class="hs-dropdown relative">
                            <button type="button" class="hs-dropdown-toggle flex items-center gap-2 h-10 ps-1 pe-2.5 rounded-full transition-colors hover:bg-[var(--surface-sunken)] border border-[var(--border-subtle)]" aria-haspopup="menu" aria-expanded="false">
                                <span class="relative shrink-0 rounded-full p-[2px] [background:conic-gradient(from_180deg,var(--color-primary-500),var(--color-accent-500),var(--color-primary-500))]">
                                    <img src="/img/icon-exwhyzeesp.jpg?v=2" alt="Avatar" class="size-7 rounded-full object-cover block border-2 border-[var(--surface-base)]">
                                </span>
                                <span class="hidden lg:flex flex-col items-start leading-none text-left">
                                    <span class="text-[12px] font-semibold text-[var(--text-primary)]">@firstName</span>
                                    <span class="text-[10px] text-[var(--text-tertiary)]">@userRole</span>
                                </span>
                                <i class="hidden lg:block icon-chevron-down text-[10px] text-[var(--text-tertiary)]"></i>
                            </button>
                            <div class="hs-dropdown-menu hidden transition-all duration-200 absolute end-0 top-full mt-2 w-64 !p-0 overflow-hidden z-50 rounded-2xl shadow-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)]" role="menu">
                                <div class="px-4 py-3 bg-[var(--surface-sunken)] border-b border-[var(--border-subtle)]">
                                    <p class="text-[13px] font-bold text-[var(--text-primary)]">@firstName</p>
                                    <p class="text-[11px] text-[var(--text-tertiary)] truncate">@userEmail</p>
                                </div>
                                <div class="p-1.5">
                                    <a asp-controller="Account" asp-action="Profile" asp-area="" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-decoration-none"><i class="icon-user text-[15px] text-[var(--color-primary-600)]"></i>My Profile</a>
                                    <a asp-area="Admin" asp-controller="AdminUsers" asp-action="Index" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-decoration-none"><i class="icon-user-cog text-[15px] text-[var(--color-primary-600)]"></i>Platform Users &amp; Roles</a>
                                    <a asp-controller="Account" asp-action="ChangePassword" asp-area="" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-decoration-none"><i class="icon-key text-[15px] text-[var(--color-primary-600)]"></i>Change Password</a>
                                    <a asp-controller="Account" asp-action="TwoFactor" asp-area="" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-decoration-none"><i class="icon-shield-check text-[15px] text-[var(--color-success-600)]"></i>Two-Factor (2FA)</a>
                                    <a asp-controller="Account" asp-action="ActivityLog" asp-area="" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] text-decoration-none"><i class="icon-history text-[15px] text-[var(--color-warning-600)]"></i>Activity &amp; Audit Log</a>
                                    <button type="button" onclick="window.startPortalTour(true)" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] font-medium hover:bg-[var(--surface-sunken)] text-[var(--text-primary)] border-0 bg-transparent text-start"><i class="icon-compass text-[15px] text-[var(--color-primary-600)]"></i>Interactive Page Tour</button>
