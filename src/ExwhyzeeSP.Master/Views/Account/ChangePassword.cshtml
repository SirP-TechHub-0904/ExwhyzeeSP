@model ExwhyzeeSP.Master.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">

    <!-- Page Header & Action Controls -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Change Account Password</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-200 dark:border-amber-800/60">
                    Security Credentials
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)]">
                Update your Master portal authentication password to keep your administrator account safe.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="TwoFactor" class="btn btn-outline border-emerald-200 dark:border-emerald-900/40 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none transition-colors">
                <i class="bi bi-shield-check text-[14px]"></i>
                <span>2FA Security</span>
            </a>
            <a asp-action="Profile" class="btn btn-outline border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none transition-colors">
                <i class="bi bi-arrow-left text-[14px]"></i>
                <span>Back to Profile</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Main Form Card (8 cols) -->
        <div class="lg:col-span-8">
            <div class="surface-card rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
                <div class="border-b border-slate-100 dark:border-slate-800/80 pb-4 mb-6">
                    <h2 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                        <i class="bi bi-key-fill text-[18px] text-amber-500"></i>
                        <span>Update Authentication Password</span>
                    </h2>
                    <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                        Choose a strong, unique password with mixed letters, digits, and special characters.
                    </p>
                </div>

                <form asp-action="ChangePassword" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 text-xs font-medium" role="alert"></div>

                    <!-- Current Password -->
                    <div>
                        <label asp-for="OldPassword" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                            Current Master Password <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <input asp-for="OldPassword" type="password" id="oldPwd" class="w-full h-11 pl-4 pr-11 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition shadow-xs" placeholder="Enter your current password" required />
                            <button type="button" onclick="togglePasswordVisibility('oldPwd', 'oldEye')" class="absolute end-0 inset-y-0 px-3.5 flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors focus:outline-none cursor-pointer" tabindex="-1" title="Toggle visibility">
                                <i id="oldEye" class="bi bi-eye text-[16px]"></i>
                            </button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-xs text-rose-600 mt-1.5 block font-medium"></span>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label asp-for="NewPassword" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                            New Secure Password <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <input asp-for="NewPassword" type="password" id="newPwd" class="w-full h-11 pl-4 pr-11 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition shadow-xs" placeholder="Minimum 6 characters with mixed characters" required oninput="evaluatePasswordStrength(this.value)" />
                            <button type="button" onclick="togglePasswordVisibility('newPwd', 'newEye')" class="absolute end-0 inset-y-0 px-3.5 flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors focus:outline-none cursor-pointer" tabindex="-1" title="Toggle visibility">
                                <i id="newEye" class="bi bi-eye text-[16px]"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-xs text-rose-600 mt-1.5 block font-medium"></span>

                        <!-- Real-time Strength Meter -->
                        <div class="mt-3 space-y-1.5">
                            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
                                <div id="strengthBar" class="h-full bg-slate-300 rounded-full transition-all duration-300 w-0"></div>
                            </div>
                            <div class="flex items-center justify-between text-[11px] pt-0.5">
                                <span id="strengthText" class="font-semibold text-slate-400">Password complexity</span>
                                <span id="strengthHint" class="text-[var(--text-secondary)]">Use 8+ chars, uppercase, lowercase, numbers &amp; symbols</span>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm New Password -->
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2">
                            Confirm New Password <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <input asp-for="ConfirmPassword" type="password" id="confirmPwd" class="w-full h-11 pl-4 pr-11 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 focus:outline-none transition shadow-xs" placeholder="Re-enter your new password" required />
                            <button type="button" onclick="togglePasswordVisibility('confirmPwd', 'confirmEye')" class="absolute end-0 inset-y-0 px-3.5 flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors focus:outline-none cursor-pointer" tabindex="-1" title="Toggle visibility">
                                <i id="confirmEye" class="bi bi-eye text-[16px]"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600 mt-1.5 block font-medium"></span>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100 dark:border-slate-800/80">
                        <a asp-action="Profile" class="btn btn-outline border-slate-200 dark:border-slate-700 text-xs font-semibold px-4 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors text-decoration-none">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary text-xs font-semibold px-6 py-2.5 rounded-xl flex items-center gap-1.5 shadow-sm bg-sky-600 hover:bg-sky-700 text-white transition-colors cursor-pointer">
                            <i class="bi bi-check-lg text-[15px]"></i>
                            <span>Update Password Now</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Side Password Guidelines (4 cols) -->
        <div class="lg:col-span-4 space-y-4">
            <div class="surface-card rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm space-y-4">
                <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-3">
                    <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 grid place-items-center border border-amber-200 dark:border-amber-800/60">
                        <i class="bi bi-lock-fill text-base"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-[var(--text-primary)]">Password Security Rules</h3>
                        <p class="text-[11px] text-[var(--text-secondary)]">Master operator standards</p>
                    </div>
                </div>

                <div class="space-y-3.5 text-xs text-[var(--text-secondary)]">
                    <div class="flex items-start gap-2.5">
                        <i class="bi bi-check-circle-fill text-emerald-500 text-sm mt-0.5 shrink-0"></i>
                        <div>
                            <strong class="text-[var(--text-primary)] block">Length Requirement</strong>
                            <span>At least 6 characters (10+ characters strongly advised for root access).</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-2.5">
                        <i class="bi bi-check-circle-fill text-emerald-500 text-sm mt-0.5 shrink-0"></i>
                        <div>
                            <strong class="text-[var(--text-primary)] block">Character Diversity</strong>
                            <span>Mix uppercase letters (A-Z), lowercase letters (a-z), digits (0-9), and punctuation.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-2.5">
                        <i class="bi bi-check-circle-fill text-emerald-500 text-sm mt-0.5 shrink-0"></i>
                        <div>
                            <strong class="text-[var(--text-primary)] block">Session Refresh</strong>
                            <span>Changing your password automatically updates your credentials across all active sessions.</span>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80">
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] text-[var(--text-secondary)]">
                        <span class="font-bold text-[var(--text-primary)] block mb-1">Recommended Next Step</span>
                        Enable <a asp-action="TwoFactor" class="text-sky-600 hover:underline font-semibold">Two-Factor Authentication (2FA)</a> for multi-factor security.
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
<script>
    function togglePasswordVisibility(inputId, eyeId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(eyeId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash text-[16px] text-sky-600';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye text-[16px] text-slate-400';
        }
    }

    function evaluatePasswordStrength(val) {
        const bar = document.getElementById('strengthBar');
        const text = document.getElementById('strengthText');
        if (!val) {
            bar.style.width = '0%';
            bar.className = 'h-full bg-slate-300 rounded-full transition-all duration-300 w-0';
            text.innerText = 'Password complexity';
            text.className = 'font-semibold text-slate-400';
            return;
        }

        let score = 0;
        if (val.length >= 6) score += 20;
        if (val.length >= 10) score += 20;
        if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score += 25;
        if (/[0-9]/.test(val)) score += 20;
        if (/[^A-Za-z0-9]/.test(val)) score += 15;

        bar.style.width = score + '%';
        if (score <= 35) {
            bar.className = 'h-full bg-rose-500 rounded-full transition-all duration-300';
            text.innerText = 'Weak password';
            text.className = 'font-semibold text-rose-500';
        } else if (score <= 65) {
            bar.className = 'h-full bg-amber-500 rounded-full transition-all duration-300';
            text.innerText = 'Moderate strength';
            text.className = 'font-semibold text-amber-500';
        } else if (score <= 85) {
            bar.className = 'h-full bg-sky-500 rounded-full transition-all duration-300';
            text.innerText = 'Strong password';
            text.className = 'font-semibold text-sky-500';
        } else {
            bar.className = 'h-full bg-emerald-500 rounded-full transition-all duration-300';
            text.innerText = 'Excellent password';
            text.className = 'font-semibold text-emerald-500';
        }
    }
</script>
}
