@model ExwhyzeeSP.Master.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!-- Auth Card -->
<div class="auth-card">
    <h4 class="fw-bold text-white mb-1">Sign In</h4>
    <p class="text-secondary small mb-4">Enter your credentials to access the central console.</p>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 border-0 bg-success-subtle text-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" id="loginForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger"></div>

        <!-- Email Input -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label text-light small fw-semibold">Email or Username</label>
            <div class="position-relative">
                <input asp-for="Email" type="text" class="form-control form-control-custom pe-5" placeholder="admin@exwhyzee.ng" autocomplete="username" autofocus required />
                <span class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary">
                    <i class="bi bi-envelope"></i>
                </span>
            </div>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- Password Input -->
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="Password" class="form-label text-light small fw-semibold mb-0">Password</label>
                <a asp-action="ForgotPassword" class="link-custom small">Forgot Password?</a>
            </div>
            <div class="position-relative">
                <input asp-for="Password" type="password" id="passwordInput" class="form-control form-control-custom pe-5" placeholder="••••••••••••" autocomplete="current-password" required />
                <button type="button" class="input-icon-btn" onclick="togglePasswordVisibility()" title="Toggle visibility">
                    <i class="bi bi-eye" id="toggleIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- Remember Me -->
        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" type="checkbox" id="rememberMeCheck" />
            <label asp-for="RememberMe" class="form-check-label text-secondary small" for="rememberMeCheck">
                Keep me signed in for 30 days
            </label>
        </div>

        <!-- Submit Button -->
        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-submit-glow d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-shield-lock-fill"></i>
                <span>Sign In to Master</span>
            </button>
        </div>
    </form>
</div>

<!-- Footer Link -->
<div class="text-center mt-4">
    <a href="/" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-text-white">
        <i class="bi bi-arrow-left"></i>
        <span>Return to ExwhyzeeSP Website</span>
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility() {
            const pwd = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                pwd.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
