                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3">
                        <i class="icon-check-circle text-[18px]"></i>
                        <span class="text-sm font-semibold">@TempData["SuccessMessage"]</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="mb-4 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center gap-3">
                        <i class="icon-alert-triangle text-[18px]"></i>
                        <span class="text-sm font-semibold">@TempData["ErrorMessage"]</span>
                    </div>
                }

                @RenderBody()
