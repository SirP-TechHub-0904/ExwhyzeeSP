      <!-- WhatsApp Live Chat Script -->
      <script>
         document.addEventListener("DOMContentLoaded", function() {
            var whatsappNumber = "2348165680904";
            var triggerBtn = document.getElementById("whatsappTriggerBtn");
            var chatWindow = document.getElementById("whatsappChatWindow");
            var closeBtn = document.getElementById("closeWhatsAppChat");
            var chatForm = document.getElementById("whatsappChatForm");
            var chatInput = document.getElementById("whatsappChatInput");
            var quickChips = document.querySelectorAll(".quick-chip");

            function openWhatsApp(message) {
               var text = encodeURIComponent(message || "Hello Exwhyzee SP, I would like to inquire about your school management portal.");
               var url = "https://wa.me/" + whatsappNumber + "?text=" + text;
               window.open(url, "_blank");
            }

            if (triggerBtn && chatWindow) {
               triggerBtn.addEventListener("click", function(e) {
                  e.stopPropagation();
                  chatWindow.classList.toggle("active");
                  if (chatWindow.classList.contains("active") && chatInput) {
                     setTimeout(function() { chatInput.focus(); }, 200);
                  }
               });
            }

            if (closeBtn && chatWindow) {
               closeBtn.addEventListener("click", function(e) {
                  e.stopPropagation();
                  chatWindow.classList.remove("active");
               });
            }

            // Close when clicking outside
            document.addEventListener("click", function(e) {
               var widget = document.getElementById("whatsappLiveChatWidget");
               if (widget && !widget.contains(e.target) && chatWindow && chatWindow.classList.contains("active")) {
                  chatWindow.classList.remove("active");
               }
            });

            if (chatForm && chatInput) {
               chatForm.addEventListener("submit", function(e) {
                  e.preventDefault();
                  var msg = chatInput.value.trim();
                  if (msg.length > 0) {
                     openWhatsApp(msg);
                     chatInput.value = "";
                     if (chatWindow) chatWindow.classList.remove("active");
                  }
               });
            }

            quickChips.forEach(function(chip) {
               chip.addEventListener("click", function(e) {
                  e.preventDefault();
                  var msg = this.getAttribute("data-msg");
                  openWhatsApp(msg);
                  if (chatWindow) chatWindow.classList.remove("active");
               });
            });
         });
      </script>

      <script>
         // Preloader bulletproof dismissal
         function dismissPreloader() {
            var preloader = document.querySelector(".sis-preloader");
            if (preloader && preloader.style.display !== "none") {
               preloader.style.transition = "opacity 0.35s ease, visibility 0.35s ease";
               preloader.style.opacity = "0";
               preloader.style.visibility = "hidden";
               setTimeout(function() {
                  preloader.style.display = "none";
               }, 380);
            }
         }
         window.addEventListener("load", dismissPreloader);
         document.addEventListener("DOMContentLoaded", function() {
            setTimeout(dismissPreloader, 500);
         });
         setTimeout(dismissPreloader, 2000); // Safety fallback
      </script>

      <script>
         // Cookie Consent Logic for First-Time Visitors
         document.addEventListener("DOMContentLoaded", function() {
            var consent = localStorage.getItem("exwhyzee_cookie_consent");
            var banner = document.getElementById("cookieConsentBanner");
            if (!consent && banner) {
               banner.style.display = "block";
            }
            var btnAccept = document.getElementById("btnAcceptCookies");
            var btnEssential = document.getElementById("btnEssentialCookies");
            if (btnAccept) {
               btnAccept.addEventListener("click", function() {
                  localStorage.setItem("exwhyzee_cookie_consent", "accepted");
                  if (banner) banner.style.display = "none";
               });
            }
            if (btnEssential) {
               btnEssential.addEventListener("click", function() {
                  localStorage.setItem("exwhyzee_cookie_consent", "essential_only");
                  if (banner) banner.style.display = "none";
               });
            }
         });
      </script>
   @await RenderSectionAsync("Scripts", required: false)
