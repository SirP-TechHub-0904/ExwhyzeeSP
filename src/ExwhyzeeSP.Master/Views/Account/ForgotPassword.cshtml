@model ExwhyzeeSP.Master.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="p-2 rounded-3 bg-primary-subtle text-primary">
            <i class="bi bi-key-fill fs-5"></i>
        </div>
        <h4 class="fw-bold text-white mb-0">Forgot Password?</h4>
    </div>
    <p class="text-secondary small mb-4">Enter your registered administrator email address. We will dispatch a secure 6-digit verification OTP code.</p>

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label text-light small fw-semibold">Admin Email Address</label>
            <div class="position-relative">
                <input asp-for="Email" type="email" class="form-control form-control-custom pe-5" placeholder="superadmin@exwhyzeesp.com" autofocus required />
                <span class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary">
                    <i class="bi bi-envelope"></i>
                </span>
            </div>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-submit-glow d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-send-fill"></i>
                <span>Send 6-Digit OTP Code</span>
            </button>
        </div>
    </form>

    <div class="text-center mt-3">
        <a asp-action="Login" class="text-info text-decoration-none small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Sign In</span>
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
