@model IEnumerable<ExwhyzeeSP.Core.Models.MarketingTemplate>
@{
    ViewData["Title"] = "Marketing Email Templates";
    Layout = "_AdminLayout";
}

<div class="space-y-6">
    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Marketing Email Templates</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Responsive HTML email designs with dynamic personalization tags.
            </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 ms-auto flex-wrap">
            <a asp-action="Index" class="btn btn-outline border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none transition-colors">
                <i class="icon-arrow-left text-[14px]"></i>
                <span>Back to Hub</span>
            </a>
            <a asp-action="CreateCampaign" class="btn btn-outline border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none transition-colors">
                <i class="icon-send text-[14px]"></i>
                <span>Use in Broadcast</span>
            </a>
            <a asp-action="CreateTemplate" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none">
                <i class="icon-plus text-[14px]"></i>
                <span>Create New Template</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs font-semibold">
                <i class="icon-check-circle text-[18px] shrink-0"></i>
                <div>@Html.Raw(TempData["SuccessMessage"])</div>
            </div>
            <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs font-semibold">
                <i class="icon-alert-triangle text-[18px] shrink-0"></i>
                <div>@Html.Raw(TempData["ErrorMessage"])</div>
            </div>
            <button type="button" class="text-rose-600 dark:text-rose-400 hover:opacity-75" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }

    <!-- Dynamic Merge Tag Helper Bar -->
    <div class="surface-card p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <div class="size-7 rounded-lg bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center shrink-0">
                <i class="icon-code text-[14px]"></i>
            </div>
            <span class="text-xs font-bold text-[var(--text-primary)]">Supported Personalization Merge Tags:</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;FullName&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;FirstName&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;SchoolName&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;Role&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;State&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;Email&#125;&#125;</span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">&#123;&#123;CurrentYear&#125;&#125;</span>
        </div>
    </div>

    <!-- Template Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var t in Model)
        {
            <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm hover:shadow-md transition-all flex flex-col overflow-hidden">
                <div class="px-5 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)]/40 flex justify-between items-center">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
                        @t.Category
                    </span>
                    @if (t.IsDefault)
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            <i class="icon-star text-[11px]"></i> Default Pitch
                        </span>
                    }
                </div>
                <div class="p-5 flex-1 space-y-2">
                    <h3 class="font-bold text-base text-[var(--text-primary)]">@t.TemplateName</h3>
                    <div class="text-xs font-medium text-[var(--color-primary-600)] flex items-center gap-1.5 truncate" title="@t.Subject">
                        <i class="icon-mail text-[13px] opacity-75 shrink-0"></i>
                        <span class="truncate">@t.Subject</span>
                    </div>
                    <p class="text-xs text-[var(--text-secondary)] leading-relaxed line-clamp-2">
                        @(string.IsNullOrWhiteSpace(t.Description) ? "Standard customizable marketing email template." : t.Description)
                    </p>
                </div>
                <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)]/20 flex justify-between items-center gap-2">
                    <button type="button" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-3 py-1.5 rounded-xl inline-flex items-center gap-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] transition-colors" onclick="previewTemplate(@t.Id, '@Html.Raw(t.TemplateName.Replace("'", "\\'"))')">
                        <i class="icon-eye text-[13px]"></i>
                        <span>Preview</span>
                    </button>
                    <div class="flex items-center gap-2">
                        <a asp-action="EditTemplate" asp-route-id="@t.Id" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-3 py-1.5 rounded-xl inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-decoration-none transition-colors">
                            <i class="icon-edit-3 text-[13px]"></i>
                            <span>Edit</span>
                        </a>
                        <a asp-action="CreateCampaign" asp-route-templateId="@t.Id" class="btn btn-primary text-xs font-semibold px-3.5 py-1.5 rounded-xl inline-flex items-center gap-1 text-decoration-none shadow-sm">
                            <i class="icon-send text-[13px]"></i>
                            <span>Broadcast</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: HTML Template Preview Sandbox -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] shadow-2xl rounded-2xl overflow-hidden">
            <div class="modal-header px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h5 class="modal-title text-base font-bold text-[var(--text-primary)]" id="previewModalTitle">Template Preview</h5>
                    <p class="text-xs text-[var(--text-secondary)] mt-0.5" id="previewModalSubject"></p>
                </div>
                <button type="button" class="text-[var(--text-tertiary)] hover:text-[var(--text-primary)] text-xl" data-bs-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body p-0 bg-slate-100 dark:bg-slate-900">
                <iframe id="previewIframe" style="width: 100%; height: 500px; border: none;" sandbox="allow-same-origin"></iframe>
            </div>
            <div class="modal-footer px-5 py-3.5 border-t border-[var(--border-subtle)] flex items-center justify-end">
                <button type="button" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-4 py-2 rounded-xl text-[var(--text-secondary)]" data-bs-dismiss="modal">Close Preview</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function previewTemplate(id, name) {
        fetch(`/Admin/Marketing/GetTemplateJson/${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('previewModalTitle').innerText = data.templateName;
                document.getElementById('previewModalSubject').innerText = "Subject: " + data.subject;

                // Mock dynamic tags for live preview
                let html = data.bodyHtml
                    .replaceAll('{{FullName}}', 'Dr. Anthony Uche')
                    .replaceAll('{{FirstName}}', 'Anthony')
                    .replaceAll('{{SchoolName}}', 'Premier International Academy')
                    .replaceAll('{{Email}}', 'admin@premieracademy.edu.ng')
                    .replaceAll('{{Role}}', 'Proprietor / Director')
                    .replaceAll('{{State}}', 'Lagos')
                    .replaceAll('{{CurrentYear}}', new Date().getFullYear());

                const iframe = document.getElementById('previewIframe');
                iframe.srcdoc = html;

                const modal = new bootstrap.Modal(document.getElementById('previewModal'));
                modal.show();
            })
            .catch(err => {
                alert('Error loading template preview: ' + err);
            });
    }
</script>
}
