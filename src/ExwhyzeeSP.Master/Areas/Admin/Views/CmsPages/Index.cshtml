@model IEnumerable<ExwhyzeeSP.Core.Models.MasterCmsPage>
@{
    ViewData["Title"] = "Policy & Legal Pages";
    Layout = "_AdminLayout";
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Website Content Management (CMS)</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Create, edit, and publish static pages, policy documents, and terms of service.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Create" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-plus text-[14px]"></i>
                <span>Add Custom Page</span>
            </a>
        </div>
    </div>

    <!-- CMS Pages Table Card -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-[var(--surface-sunken)] border-b border-[var(--border-subtle)] text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)]">
                    <tr>
                        <th class="py-3 px-4">Page Title</th>
                        <th class="py-3 px-4">Slug / Route</th>
                        <th class="py-3 px-4">Summary</th>
                        <th class="py-3 px-4">Last Modified</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-subtle)]">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var pageItem in Model)
                        {
                            <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors">
                                <td class="py-3.5 px-4">
                                    <strong class="text-sm font-bold text-[var(--text-primary)] block">@pageItem.Title</strong>
                                </td>
                                <td class="py-3.5 px-4">
                                    <code class="font-mono text-[11px] text-[var(--color-primary-600)]">/@pageItem.Slug</code>
                                </td>
                                <td class="py-3.5 px-4">
                                    <p class="text-[11.5px] text-[var(--text-tertiary)] line-clamp-1 max-w-md">@pageItem.Summary</p>
                                </td>
                                <td class="py-3.5 px-4 text-[var(--text-secondary)]">
                                    @pageItem.LastUpdated.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (pageItem.IsPublished)
                                    {
                                        <span class="badge-soft badge-success">
                                            <i class="icon-circle-check text-[9px]"></i> Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-danger">
                                            <i class="icon-circle-x text-[9px]"></i> Draft
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5 ms-auto">
                                        <a asp-action="Edit" asp-route-id="@pageItem.Id" class="btn btn-outline border-secondary text-xs px-2.5 py-1.5 rounded-lg text-decoration-none flex items-center gap-1" title="Edit Page">
                                            <i class="icon-edit text-[13px]"></i>
                                            <span>Edit</span>
                                        </a>
                                        <a href="/@pageItem.Slug" target="_blank" class="btn btn-outline border-secondary text-xs px-2.5 py-1.5 rounded-lg text-decoration-none flex items-center gap-1" title="Preview Public Page">
                                            <i class="icon-external-link text-[13px]"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-[var(--text-tertiary)]">
                                <div class="size-12 rounded-2xl bg-[var(--surface-sunken)] grid place-items-center mx-auto mb-3">
                                    <i class="icon-file-text text-[24px] text-[var(--text-tertiary)]"></i>
                                </div>
                                <p class="text-sm font-semibold text-[var(--text-primary)]">No CMS Pages Found</p>
                                <p class="text-xs text-[var(--text-tertiary)] mt-1">Click "Add Custom Page" to create your first content page.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
