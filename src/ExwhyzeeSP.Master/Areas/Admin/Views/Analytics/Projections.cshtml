@model List<MasterTenantMetricSnapshot>
@{
    ViewData["Title"] = "Statistical Projections & Growth Forecasts";
    var totalStudents = Model.Sum(m => m.TotalStudents);
    var totalSchools = Model.Count;
    var projectedStudentsNextYear = (int)(totalStudents * 1.35);
    var projectedPinDemand = (int)(totalStudents * 3.2); // 3 terms * 1 PIN per student + resits
    var projectedAnnualRevenue = Model.Sum(m => m.TotalFeesCollected) * 1.25m;
}

<!-- Page Header & Action Toolbar -->
<div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Predictive Growth &amp; AI Projections</h1>
        <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
            Forecast revenue, student enrolment trends, server capacity needs, and licensing trajectories.
        </p>
    </div>

    <div class="flex items-center gap-2.5 shrink-0 ms-auto">
        <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
            <i class="icon-arrow-left text-[14px]"></i>
            <span>Analytics Hub</span>
        </a>
    </div>
</div>

<!-- Projection Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4 h-100 rounded-3 bg-gradient text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
            <span class="text-white-50 small text-uppercase fw-semibold">Projected Student Population (Next Session)</span>
            <h2 class="fw-bold mb-0 mt-2">@projectedStudentsNextYear.ToString("N0") <span class="fs-6 fw-normal text-white-50">(+35% YoY)</span></h2>
            <div class="mt-2 text-white-50 small">Forecast based on historical termly intake trends</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4 h-100 rounded-3 bg-gradient text-white" style="background: linear-gradient(135deg, #065f46 0%, #10b981 100%);">
            <span class="text-white-50 small text-uppercase fw-semibold">Annual Result PIN Demand Forecast</span>
            <h2 class="fw-bold mb-0 mt-2">@projectedPinDemand.ToString("N0") PINs</h2>
            <div class="mt-2 text-white-50 small">Recommended scratch card batch pre-generation</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4 h-100 rounded-3 bg-gradient text-white" style="background: linear-gradient(135deg, #4c1d95 0%, #8b5cf6 100%);">
            <span class="text-white-50 small text-uppercase fw-semibold">Projected SaaS Recurring ARR</span>
            <h2 class="fw-bold mb-0 mt-2">₦@((projectedAnnualRevenue * 0.15m).ToString("N0"))</h2>
            <div class="mt-2 text-white-50 small">At current platform license tier &amp; portal fees</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- 3-Year Population Forecast -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>3-Year Student Population Forecast (3 Scenarios)</h5>
                <span class="text-muted small">Conservative (15%), Moderate (25%), and High-Growth (40%) YoY models</span>
            </div>
            <div class="card-body p-3">
                <div id="threeYearProjectionChart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>

    <!-- PIN Card Batch Demand Forecast -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-3 px-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-shield-check text-warning me-2"></i>Termly PIN Demand Projections</h5>
                <span class="text-muted small">Result verification card inventory velocity</span>
            </div>
            <div class="card-body p-3">
                <div id="pinDemandChart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", async function () {
        const resp = await fetch('/api/v1/telemetry/chart-data');
        const data = await resp.json();

        // 1. Three-Year Multi-Scenario Line Chart
        const years = ['Current', 'Year +1', 'Year +2', 'Year +3'];
        const base = data.growthTrendAndProjections.enrollment[11] || 1800;

        new ApexCharts(document.querySelector("#threeYearProjectionChart"), {
            series: [
                { name: 'Conservative (15% YoY)', data: [base, Math.round(base * 1.15), Math.round(base * 1.32), Math.round(base * 1.52)] },
                { name: 'Moderate Target (25% YoY)', data: [base, Math.round(base * 1.25), Math.round(base * 1.56), Math.round(base * 1.95)] },
                { name: 'High Expansion (40% YoY)', data: [base, Math.round(base * 1.40), Math.round(base * 1.96), Math.round(base * 2.74)] }
            ],
            chart: { height: 340, type: 'line', toolbar: { show: false } },
            stroke: { width: [3, 3, 3], curve: 'smooth', dashArray: [0, 0, 5] },
            colors: ['#64748b', '#2563eb', '#10b981'],
            xaxis: { categories: years },
            yaxis: { title: { text: 'Enrolled Students' } }
        }).render();

        // 2. PIN Demand Termly Forecast
        new ApexCharts(document.querySelector("#pinDemandChart"), {
            series: [{
                name: 'Expected PIN Verifications',
                data: [Math.round(base * 0.95), Math.round(base * 1.05), Math.round(base * 1.25), Math.round(base * 1.45)]
            }],
            chart: { height: 340, type: 'bar', toolbar: { show: false } },
            colors: ['#f59e0b'],
            plotOptions: { bar: { borderRadius: 6, columnWidth: '45%' } },
            xaxis: { categories: ['1st Term Resumption', '2nd Term Midterms', '3rd Term Promotional', 'Next Session Intake'] },
            yaxis: { title: { text: 'PINs Consumed' } }
        }).render();
    });
</script>
}
