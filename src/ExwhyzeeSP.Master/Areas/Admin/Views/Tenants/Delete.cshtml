@model DeleteTenantViewModel
@{
    ViewData["Title"] = $"Decommission {Model.SchoolName}";
}

<div class="w-full space-y-6 animate-rise-in pb-12">

    <!-- Back button & Breadcrumb -->
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="header-icon-btn text-decoration-none" title="Back to Details">
                <i class="icon-arrow-left text-[16px]"></i>
            </a>
            <div>
                <h1 class="font-display font-bold text-xl text-rose-600 dark:text-rose-400 flex items-center gap-2">
                    <i class="icon-alert-triangle text-2xl"></i>
                    <span>Decommission &amp; Delete School</span>
                </h1>
                <p class="text-xs text-[var(--text-tertiary)]">Regulatory Soft-Delete &amp; Anonymization Protocol</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline border-secondary text-xs px-3 py-1.5 rounded-lg text-decoration-none">
            Cancel
        </a>
    </div>

    <!-- FinTech Warning Banner -->
    <div class="surface-card border border-rose-500/30 bg-rose-500/5 p-5 rounded-2xl">
        <div class="flex items-start gap-4">
            <div class="size-12 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 grid place-items-center shrink-0 border border-rose-500/20 text-xl font-bold">
                <i class="icon-shield-alert"></i>
            </div>
            <div class="space-y-1">
                <h2 class="text-base font-bold text-rose-700 dark:text-rose-400">High-Risk Administrative Action</h2>
                <p class="text-xs leading-relaxed text-[var(--text-secondary)]">
                    You are initiating a permanent institutional decommissioning procedure for <strong>@Model.SchoolName</strong>. 
                    In accordance with regulatory and financial audit compliance, this operation utilizes a <strong>FinTech Soft-Delete Pattern</strong>. 
                    All institution identifiers and domain routing are anonymized and revoked immediately, while historical ledger records are preserved for audit reconciliation.
                </p>
            </div>
        </div>
    </div>

    <!-- School Snapshot & Impact Analysis -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)]">Target Institution</span>
            <div class="text-sm font-bold text-[var(--text-primary)] truncate">@Model.SchoolName</div>
            <div class="text-xs font-mono text-[var(--color-primary-600)] truncate">
                @(!string.IsNullOrWhiteSpace(Model.SubDomain) ? $"{Model.SubDomain}.exwhyzee.ng" : "No Subdomain")
            </div>
        </div>

        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)]">Financial Ledger Summary</span>
            <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">
                ₦@Model.TransactionVolume.ToString("N2")
            </div>
            <div class="text-xs text-[var(--text-secondary)]">
                @Model.TransactionCount recorded transaction(s)
            </div>
        </div>

        <div class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] space-y-1">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)]">Registration Date</span>
            <div class="text-sm font-bold text-[var(--text-primary)]">
                @Model.DateCreated.ToString("MMM dd, yyyy")
            </div>
            <div class="text-xs text-[var(--text-tertiary)]">
                Portal Reference #@Model.Id
            </div>
        </div>
    </div>

    <!-- Impact & Consequences Breakdown -->
    <div class="surface-card p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-2">
            <i class="icon-info text-[var(--color-primary-600)]"></i>
            <span>Consequences of Decommissioning</span>
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] flex items-start gap-2.5">
                <i class="icon-lock text-rose-500 text-sm mt-0.5 shrink-0"></i>
                <div>
                    <strong class="text-[var(--text-primary)] block">Immediate Lockout:</strong>
                    All student, teacher, and school admin accounts are permanently locked out and revoked.
                </div>
            </div>

            <div class="p-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] flex items-start gap-2.5">
                <i class="icon-globe text-rose-500 text-sm mt-0.5 shrink-0"></i>
                <div>
                    <strong class="text-[var(--text-primary)] block">Domain Unbinding:</strong>
                    Subdomains and custom domains are detached, immediately taking down public and private portals.
                </div>
            </div>

            <div class="p-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] flex items-start gap-2.5">
                <i class="icon-eye-off text-rose-500 text-sm mt-0.5 shrink-0"></i>
                <div>
                    <strong class="text-[var(--text-primary)] block">Complete Hidden Status:</strong>
                    The institution is masked and removed from all active directories, queries, and marketing lists.
                </div>
            </div>

            <div class="p-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] flex items-start gap-2.5">
                <i class="icon-file-check text-emerald-500 text-sm mt-0.5 shrink-0"></i>
                <div>
                    <strong class="text-[var(--text-primary)] block">Audit Preserved:</strong>
                    Historical invoices, receipts, and ledger audit logs remain intact for financial reporting compliance.
                </div>
            </div>
        </div>
    </div>

    <!-- Security Authorization Form -->
    <div class="surface-card p-6 rounded-2xl border-2 border-rose-500/20 bg-[var(--surface-raised)] shadow-lg space-y-5">
        <div class="border-b border-[var(--border-subtle)] pb-3">
            <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                <i class="icon-key text-rose-500"></i>
                <span>Multi-Factor Administrative Authorization</span>
            </h3>
            <p class="text-xs text-[var(--text-tertiary)]">Complete all verification requirements below to execute this decommissioning.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="p-4 mb-4 rounded-2xl border flex items-start gap-3.5 shadow-sm" style="background-color: #fff1f2; border: 1.5px solid #fda4af; color: #9f1239;">
                <div class="size-9 rounded-xl flex items-center justify-center shrink-0 mt-0.5" style="background-color: #ffe4e6; color: #e11d48;">
                    <i class="bi bi-exclamation-triangle-fill text-lg"></i>
                </div>
                <div class="flex-1 text-xs">
                    <h4 class="font-bold text-sm mb-1.5" style="color: #9f1239;">Action Required — Please complete all verification steps:</h4>
                    <div asp-validation-summary="All" class="space-y-1 font-medium" style="color: #be123c;"></div>
                </div>
            </div>
        }

        <form asp-action="DeleteConfirmed" method="post" class="space-y-5" id="decommissionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- 1. Deletion Reason -->
            <div class="space-y-1.5">
                <label asp-for="Reason" class="block text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">
                    1. Mandatory Compliance / Decommission Reason <span class="text-rose-500">*</span>
                </label>
                <textarea asp-for="Reason" rows="3" required class="form-control text-sm w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] p-3 focus:border-rose-500 focus:ring-1 focus:ring-rose-500" placeholder="Type the official reason for decommissioning this institution (at least 5 characters)..."></textarea>
                <span asp-validation-for="Reason" class="text-xs text-rose-500 font-semibold mt-1 block"></span>
            </div>

            <!-- 2. Pass Phrase Verification -->
            <div class="space-y-1.5">
                <label asp-for="ConfirmationText" class="block text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">
                    2. Type <code class="px-1.5 py-0.5 bg-rose-500/10 text-rose-600 font-mono rounded font-bold">DELETE</code> or <code class="px-1.5 py-0.5 bg-rose-500/10 text-rose-600 font-mono rounded font-bold">DELETE @Model.SchoolName</code> to confirm: <span class="text-rose-500">*</span>
                </label>
                <input asp-for="ConfirmationText" id="confirmTextInput" required autocomplete="off" class="form-control font-mono text-sm py-2.5 px-3.5 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] focus:border-rose-500 focus:ring-1 focus:ring-rose-500" placeholder="Type DELETE here..." />
                <span asp-validation-for="ConfirmationText" class="text-xs text-rose-500 font-semibold mt-1 block"></span>
            </div>

            <!-- 3. Admin Account Password -->
            <div class="space-y-1.5">
                <label asp-for="AdminPassword" class="block text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">
                    3. Your Master Administrator Password <span class="text-rose-500">*</span>
                </label>
                <input asp-for="AdminPassword" type="password" required class="form-control text-sm py-2.5 px-3.5 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] focus:border-rose-500 focus:ring-1 focus:ring-rose-500" placeholder="Enter your master administrator login password..." />
                <span asp-validation-for="AdminPassword" class="text-xs text-rose-500 font-semibold mt-1 block"></span>
            </div>

            <!-- 4. Acknowledgment Checkbox -->
            <div class="p-4 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)]">
                <div class="form-check flex items-start gap-3">
                    <input asp-for="AcknowledgeConsequences" class="form-check-input size-4 mt-0.5 rounded border-secondary text-rose-600 focus:ring-rose-500 shrink-0 cursor-pointer" id="ackCheckbox" />
                    <label for="ackCheckbox" class="text-xs text-[var(--text-primary)] font-medium select-none cursor-pointer leading-relaxed">
                        I confirm and acknowledge that this institution will be permanently decommissioned, domain routing revoked, and all active user access terminated immediately.
                    </label>
                </div>
                <span asp-validation-for="AcknowledgeConsequences" class="text-xs text-rose-500 font-semibold mt-1 block"></span>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-3 border-t border-[var(--border-subtle)]">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline border-secondary text-xs font-semibold px-4 py-2.5 rounded-xl text-decoration-none w-full sm:w-auto text-center">
                    Cancel and Return
                </a>
                <button type="submit" id="deleteSubmitBtn" class="btn btn-danger bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-6 py-2.5 rounded-xl shadow-lg flex items-center justify-center gap-2 w-full sm:w-auto cursor-pointer">
                    <i class="icon-trash-2 text-[15px]"></i>
                    <span>Permanently Decommission Institution</span>
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
