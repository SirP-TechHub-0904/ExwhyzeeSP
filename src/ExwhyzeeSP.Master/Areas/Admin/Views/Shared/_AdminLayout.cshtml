        </aside>

        <!-- ================= MAIN CONTENT SHELL ================= -->
        <div class="app-main flex-1 flex flex-col min-w-0">

            <!-- ================= HEADER ================= -->
            <header class="app-header relative bg-[var(--surface-raised)] border-b border-[var(--border-subtle)]">
                <div class="absolute inset-x-0 bottom-0 h-px pointer-events-none [background:linear-gradient(90deg,transparent,var(--color-primary-500)_20%,var(--color-accent-500)_50%,var(--color-primary-500)_80%,transparent)] opacity-[0.55]"></div>

                <div class="flex items-center gap-3 px-4 lg:px-6 h-16">

                    <!-- Mobile sidebar toggle -->
                    <button type="button" id="mobileSidebarBtn" class="header-icon-btn lg:hidden" aria-label="Open menu">
                        <i class="icon-menu text-[18px]"></i>
                    </button>

                    <!-- Desktop sidebar collapse toggle -->
                    <button type="button" id="topbarSidebarToggle" class="header-icon-btn hidden lg:inline-flex" title="Toggle Sidebar" aria-label="Toggle sidebar collapse">
                        <i class="icon-menu text-[18px]"></i>
                    </button>

                    <!-- Mobile Logo -->
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="lg:hidden shrink-0">
                        <img src="/img/icon-exwhyzeesp.jpg?v=2" alt="Exwhyzee SP" class="size-8 object-cover rounded-full">
                    </a>

                    <!-- Global Search Bar -->
                    <form asp-area="Admin" asp-controller="Tenants" asp-action="Index" method="get" class="header-search-wrapper hidden md:flex">
                        <span class="header-search-icon">
                            <i class="icon-search"></i>
                        </span>
                        <input type="text" name="searchString" placeholder="Search schools, domains..." class="header-search-input" />
