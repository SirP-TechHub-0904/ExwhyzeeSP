@page
@model ExwhyzeeSP.Web.Areas.MisContent.Pages.IBlogs.Category.CreateModel

@{
    ViewData["Title"] = "BLOG CATEGORY Create";
    ViewData["BackUrl"] = "./Index";
    @if (User.Identity.IsAuthenticated && User.IsInRole("SubAdmin") || User.IsInRole("SuperAdmin,Admin"))
    {
        

    }
    else
    {
        

    }
}

<div class="box box-primary card-default">
    
    <!-- /.card-header -->

    <div class="box-body p-4">
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-4">
                        <label asp-for="BlogCategory.Title" class="control-label"></label>
                        <input asp-for="BlogCategory.Title" class="form-control" />
                        <span asp-validation-for="BlogCategory.Title" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="BlogCategory.Publish" /> @Html.DisplayNameFor(model => model.BlogCategory.Publish)
                        </label>
                    </div>
                    <div class="form-group mb-4">
                        <input type="submit" value="Submit" class="btn btn-primary" />
                        

                    </div>
                </form>
            </div>
        </div>


        <!-- /.row -->
    </div>
    <!-- /.card-body -->
    <div class="box-footer">
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}





