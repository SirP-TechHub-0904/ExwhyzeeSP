@model ExwhyzeeSP.Core.Models.TenantSchool
@{
    ViewData["Title"] = $"Gatekeeper & Access Control - {Model.SchoolName}";
}

<!-- Page Header (Dreams Core Profile Style) -->
<div class="surface-card p-5 lg:p-6 mb-6 animate-rise-in">
    <div class="flex flex-wrap items-start justify-between gap-5 w-full">
        <div class="flex items-start gap-4">
            <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Schools">
                <i class="icon-arrow-left text-[16px]"></i>
            </a>

            <div class="relative shrink-0 size-16 rounded-2xl bg-rose-500/10 text-rose-600 grid place-items-center border border-rose-500/20 shadow-xs">
                <i class="icon-shield text-[28px]"></i>
                @if (Model.IsActive)
                {
                    <span class="absolute -bottom-1 -end-1 size-4 rounded-full bg-emerald-500 border-2 border-[var(--surface-raised)]" title="Active"></span>
                }
                else
                {
                    <span class="absolute -bottom-1 -end-1 size-4 rounded-full bg-rose-500 border-2 border-[var(--surface-raised)]" title="Suspended / Disabled"></span>
                }
            </div>

            <div class="pt-0.5">
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Gatekeeper &amp; Feature Gates</h1>
                    @if (Model.IsActive)
                    {
                        <span class="badge-soft badge-success">
                            <i class="icon-circle-check text-[9px]"></i> Active School
                        </span>
                    }
                    else
                    {
                        <span class="badge-soft badge-danger">
                            <i class="icon-circle-x text-[9px]"></i> Restricted
                        </span>
                    }
                </div>
                
                <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1 flex items-center gap-2 flex-wrap">
                    <span>School: <strong class="text-[var(--text-primary)]">@Model.SchoolName</strong></span>
                    <span>&middot;</span>
                    <span>Portal ID: <strong class="text-[var(--text-primary)]">#@Model.Id</strong></span>
                    <span>&middot;</span>
                    <span>Subdomain: <code class="font-mono text-[var(--color-primary-600)]">@(!string.IsNullOrWhiteSpace(Model.SubDomain) ? $"{Model.SubDomain}.exwhyzee.ng" : "Unassigned")</code></span>
                </p>
            </div>
        </div>

        <!-- Action buttons on far right -->
        <div class="flex items-center gap-2 shrink-0 ms-auto">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-eye text-[14px]"></i>
                <span>School Overview</span>
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-edit text-[14px]"></i>
                <span>Edit Settings</span>
            </a>
            <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-arrow-left text-[14px]"></i>
                <span>Back to Schools</span>
            </a>
        </div>
    </div>
</div>

<form asp-action="AccessControl" asp-route-id="@Model.Id" method="post" class="space-y-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SchoolName" />
    <input type="hidden" asp-for="ConnectionString" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left: Access Mode & Public Notice Configuration -->
        <div class="lg:col-span-7 space-y-6">
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 shadow-sm space-y-5">
                <div class="border-b border-[var(--border-subtle)] pb-3">
                    <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                        <i class="icon-sliders text-[18px] text-[var(--color-primary-600)]"></i>
                        <span>School Status &amp; Access Level</span>
                    </h3>
                    <p class="text-xs text-[var(--text-secondary)] mt-0.5">Control the overall operational availability of this portal instance.</p>
                </div>

                <!-- Master Active Checkbox -->
                <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] flex items-center justify-between gap-4">
                    <div>
                        <span class="text-sm font-bold text-[var(--text-primary)] block">School Active Status</span>
                        <span class="text-xs text-[var(--text-secondary)]">When turned off, all access to this school portal is disabled immediately.</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" asp-for="IsActive" class="sr-only peer" />
                        <div class="w-11 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                    </label>
                </div>

                <!-- Suspension Mode Selector -->
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Suspension &amp; Lockout Mode</label>
                    <select asp-for="SuspensionMode" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:ring-1 focus:ring-[var(--color-primary-500)]" asp-items="Html.GetEnumSelectList<TenantSuspensionMode>()"></select>
                    <p class="text-xs text-[var(--text-tertiary)] mt-1.5">
                        <strong>PortalDashboardSuspensionOnly:</strong> Keeps the public school website online for parents and visitors, but prevents logins to student, staff, and admin dashboards.
                    </p>
                </div>

                <!-- Internal Admin Reason -->
                <div>
                    <label asp-for="SuspensionReason" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Internal Suspension Reason (Admin Audit Log)</label>
                    <input asp-for="SuspensionReason" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:ring-1 focus:ring-[var(--color-primary-500)]" placeholder="e.g. 2026/2027 1st Term Subscription Unpaid (INV-2026-00103 overdue)" />
                    <span class="text-xs text-[var(--text-tertiary)] mt-1 block">Internal audit trail note visible only to master platform administrators.</span>
                </div>

                <!-- Public / Student / Staff Lockout Notice -->
                <div>
                    <label asp-for="SuspensionNotice" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Public &amp; Student Lockout Notice</label>
                    <textarea asp-for="SuspensionNotice" rows="3" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:ring-1 focus:ring-[var(--color-primary-500)]" placeholder="Enter custom message displayed to students and staff on the lockout page..."></textarea>
                    <span class="text-xs text-[var(--text-tertiary)] mt-1 block">This message is rendered inside the official notice panel when users attempt to access locked portal features.</span>
                </div>

                <!-- Grace Period Deadline -->
                <div>
                    <label asp-for="GracePeriodDeadline" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Payment Grace Period Deadline (Optional)</label>
                    <input asp-for="GracePeriodDeadline" type="date" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3.5 py-2.5 text-sm text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:ring-1 focus:ring-[var(--color-primary-500)]" />
                </div>
            </div>
        </div>

        <!-- Right: Feature Gatekeeper Switches -->
        <div class="lg:col-span-5 space-y-6">
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 shadow-sm space-y-4">
                <div class="border-b border-[var(--border-subtle)] pb-3">
                    <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                        <i class="icon-grid text-[18px] text-amber-500"></i>
                        <span>Granular Feature Access Gates</span>
                    </h3>
                    <p class="text-xs text-[var(--text-secondary)] mt-0.5">Disable specific modules if subscriptions or PIN orders are pending settlement.</p>
                </div>

                <div class="space-y-2.5">
                    <!-- Result Checking Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Result Checking &amp; PIN Verification</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Term report cards &amp; online scratch PIN verification</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowResultChecking" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- CBT Exam Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Online CBT Examination Lab</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Online quizzes, terminal test timers &amp; auto-grading</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowCbtExams" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- Online Payment Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Online Fee Payment Gateways</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Paystack, Flutterwave, and Monnify checkout forms</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowOnlinePayment" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- Staff Portal Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Staff Portal &amp; Score Upload</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Teacher dashboards, score recording &amp; attendance</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowStaffPortal" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- Student Portal Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Student Dashboard &amp; Profile</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Student login, homework download &amp; receipts</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowStudentPortal" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- Admission Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">Online Admission &amp; Enrolment</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Prospective student admission application forms</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowAdmissionPortal" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- SMS Notifications Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">SMS Notification Broadcasts</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Bulk SMS to parents and staff</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowSmsNotifications" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>

                    <!-- E-Learning Gate -->
                    <div class="flex items-center justify-between p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:bg-[var(--surface-sunken)] transition-all">
                        <div class="pe-3">
                            <span class="text-xs font-bold text-[var(--text-primary)] block">E-Learning &amp; Digital Coursework</span>
                            <span class="text-[11px] text-[var(--text-secondary)]">Online lessons, syllabus notes &amp; video lectures</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer shrink-0">
                            <input type="checkbox" asp-for="AllowElearning" class="sr-only peer" />
                            <div class="w-9 h-5 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--color-primary-600)]"></div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Save Action Button -->
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 shadow-sm text-center">
                <button type="submit" class="btn btn-primary w-full py-3 text-sm font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                    <i class="icon-check-circle text-[16px]"></i>
                    <span>Save Access &amp; Gate Settings</span>
                </button>
                <span class="text-xs text-[var(--text-tertiary)] block mt-2">Changes take effect immediately across all visitors and school users.</span>
            </div>
        </div>
    </div>
</form>
