@model ExwhyzeeSP.Core.Models.Blog
@{
    ViewData["Title"] = $"Edit Blog Article - {Model.Title}";
    Layout = "_AdminLayout";
}

<div class="space-y-4">

    <!-- ============ Hero Header (Dreams Core Profile Style) ============ -->
    <div class="surface-card p-5 lg:p-6 animate-rise-in">
        <div class="flex flex-wrap items-start justify-between gap-5 w-full">
            <div class="flex items-start gap-4">
                <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Articles">
                    <i class="icon-arrow-left text-[16px]"></i>
                </a>

                <div class="relative shrink-0 size-16 rounded-2xl bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center border border-[var(--color-primary-500)]/20 shadow-xs">
                    <i class="icon-file-text text-[28px]"></i>
                </div>

                <div class="pt-0.5">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Edit: @Model.Title</h1>
                        @if (Model.Publish)
                        {
                            <span class="badge-soft badge-success">
                                <i class="icon-circle-check text-[9px]"></i> Published
                            </span>
                        }
                        else
                        {
                            <span class="badge-soft badge-danger">
                                <i class="icon-circle-x text-[9px]"></i> Draft
                            </span>
                        }
                    </div>
                    
                    <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1">
                        Modify article body content, excerpt description, category metadata, and featured ribbon flags.
                    </p>
                </div>
            </div>

            <!-- Action buttons on far right -->
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-arrow-left text-[14px]"></i>
                    <span>Back to Articles</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ============ Form ============ -->
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs font-medium text-rose-600 dark:text-rose-400"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Form Column: Content -->
            <div class="lg:col-span-8 space-y-6">

                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-file-text text-[15px] text-[var(--color-primary-500)]"></i>
                        Article Content
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="Title" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Article Title *</label>
                            <input asp-for="Title" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-bold text-[var(--text-primary)]" required />
                            <span asp-validation-for="Title" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Description" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Short Excerpt / Summary *</label>
                            <textarea asp-for="Description" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" rows="3" required></textarea>
                            <span asp-validation-for="Description" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="FullDescription" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Full Article Content (HTML / Rich Text) *</label>
                            <textarea asp-for="FullDescription" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono text-[var(--text-primary)]" rows="14" required></textarea>
                            <span class="text-[11px] text-[var(--text-tertiary)] block mt-1">Supports standard HTML headings, lists, quotes, and embed links.</span>
                            <span asp-validation-for="FullDescription" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Form Column: Metadata & Settings -->
            <div class="lg:col-span-4 space-y-6">

                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-sliders text-[15px] text-[var(--color-primary-500)]"></i>
                        Publishing Settings
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="BlogCategoryId" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Category</label>
                            <select asp-for="BlogCategoryId" asp-items="ViewBag.Categories" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>

                        <div>
                            <label asp-for="ImageUrl" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Featured Image URL</label>
                            <input asp-for="ImageUrl" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mt-2 text-center">
                                    <img src="@Model.ImageUrl" alt="Preview" class="w-full h-32 rounded-lg object-cover border border-[var(--border-subtle)] shadow-xs" />
                                </div>
                            }
                        </div>

                        <div>
                            <label asp-for="Date" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Publication Date</label>
                            <input asp-for="Date" type="datetime-local" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>

                        <div>
                            <label asp-for="SortOrder" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Display Order</label>
                            <input asp-for="SortOrder" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" type="number" />
                        </div>

                        <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] space-y-3">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input asp-for="Publish" type="checkbox" class="form-checkbox rounded text-[var(--color-primary-500)] size-4" />
                                <span class="text-xs font-semibold text-[var(--text-primary)]">Publish Article</span>
                            </label>
                            <p class="text-[11px] text-[var(--text-tertiary)] pl-6.5">Make article publicly visible on the blog feed.</p>
                        </div>

                        <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] space-y-3">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input asp-for="AddToRibon" type="checkbox" class="form-checkbox rounded text-[var(--color-primary-500)] size-4" />
                                <span class="text-xs font-semibold text-[var(--text-primary)]">Featured Ribbon Badge</span>
                            </label>
                            <input asp-for="RibonCustomDisplayTitle" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] px-3 py-1.5 text-xs text-[var(--text-primary)]" placeholder="e.g. Case Study, Spotlight" />
                        </div>
                    </div>
                </div>

                <!-- Form Action Card -->
                <div class="surface-card p-5 space-y-3">
                    <button type="submit" class="btn btn-primary w-full py-2.5 text-xs font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                        <i class="icon-check text-[15px]"></i>
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline border-secondary w-full py-2 text-xs font-semibold rounded-lg text-center flex items-center justify-center gap-1.5 text-decoration-none">
                        <i class="icon-arrow-left text-[13px]"></i>
                        <span>Cancel</span>
                    </a>
                </div>

            </div>

        </div>
    </form>
</div>
