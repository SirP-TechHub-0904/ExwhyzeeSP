@model IEnumerable<ExwhyzeeSP.Core.Models.MasterKnowledgeBaseItem>
@{
    ViewData["Title"] = "Knowledge Base & Portal Operating Guides";
    ViewData["MetaDescription"] = "Comprehensive directory of pages, controllers, and step-by-step operating instructions for School Administrators, Teachers/Staff, and Students/Parents in Exwhyzee SP.";
    Layout = "_PublicLayout";
    var selectedRole = ViewBag.SelectedRole as string;
    var search = ViewBag.Search as string;

    // Group items by Role and then by Area/Controller
    var roles = new[] { "Admin", "Staff", "Student" };
    if (!string.IsNullOrEmpty(selectedRole) && roles.Contains(selectedRole))
    {
        roles = new[] { selectedRole };
    }
}

<!-- Page Header Start -->
<div class="sisf-page-header position-relative">
   <div class="sisf-page-header-image">
      <figure>
         <img src="/assets/images/page-banner.png" alt="Knowledge Base & Guides">
      </figure>
   </div>
   <div class="container">
      <div class="row align-items-center">
         <div class="col-lg-12">
            <div class="sisf-page-header-content text-center">
               <h1 class="text-white" data-aos="fade-up">Knowledge Base &amp; Operating Guides</h1>
               <ul class="list-unstyled d-flex align-items-center justify-content-center gap-2 m-0" data-aos="fade-up" data-aos-delay="200">
                  <li><a href="/" class="text-white">Home</a></li>
                  <li><span class="text-white">/</span></li>
                  <li class="text-white">Knowledge Base &amp; Help Desk</li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Page Header End -->

<!-- Search & Role Selector Section -->
<div class="py-5" style="background-color: #f8fafc;">
   <div class="container">
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
         <div class="row g-3 align-items-center">
            <div class="col-lg-6">
               <h3 class="fw-bold mb-1"><i class="fa-solid fa-book-bookmark text-primary me-2"></i> Portal Page &amp; Route Directory</h3>
               <p class="text-muted small mb-0">Select your user role or search by controller name, action, route URL, or keywords.</p>
            </div>
            <div class="col-lg-6">
               <form method="get" action="/KnowledgeBase" class="d-flex gap-2">
                  @if (!string.IsNullOrEmpty(selectedRole))
                  {
                     <input type="hidden" name="role" value="@selectedRole" />
                  }
                  <div class="input-group">
                     <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                     <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search page, controller (e.g. ResultManagement, ScoreSheet, PIN)...">
                     <button class="btn btn-primary px-4 fw-semibold" type="submit">Search</button>
                  </div>
                  @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedRole))
                  {
                     <a href="/KnowledgeBase" class="btn btn-outline-secondary" title="Clear search"><i class="fa-solid fa-xmark"></i></a>
                  }
               </form>
            </div>
         </div>

         <!-- Role Switcher Buttons -->
         <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            <a href="/KnowledgeBase@(string.IsNullOrEmpty(search) ? "" : $"?search={search}")" 
               class="btn @(string.IsNullOrEmpty(selectedRole) ? "btn-dark fw-bold" : "btn-outline-secondary") rounded-pill px-4">
               <i class="fa-solid fa-layer-group me-1"></i> All Roles
            </a>
            <a href="/KnowledgeBase?role=Admin@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")" 
               class="btn @(selectedRole == "Admin" ? "btn-primary fw-bold" : "btn-outline-primary") rounded-pill px-4">
               <i class="fa-solid fa-shield-halved me-1"></i> Administrator (Admin)
            </a>
            <a href="/KnowledgeBase?role=Staff@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")" 
               class="btn @(selectedRole == "Staff" ? "btn-info text-dark fw-bold" : "btn-outline-info text-dark") rounded-pill px-4">
               <i class="fa-solid fa-chalkboard-user me-1"></i> Staff &amp; Teachers (Staff)
            </a>
            <a href="/KnowledgeBase?role=Student@(string.IsNullOrEmpty(search) ? "" : $"&search={search}")" 
               class="btn @(selectedRole == "Student" ? "btn-success fw-bold" : "btn-outline-success") rounded-pill px-4">
               <i class="fa-solid fa-graduation-cap me-1"></i> Students &amp; Parents (Student)
            </a>
         </div>
      </div>

      <!-- Main Knowledge Base List -->
      @if (Model != null && Model.Any())
      {
         @foreach (var role in roles)
         {
            var roleItems = Model.Where(m => m.TargetRole.Equals(role, StringComparison.OrdinalIgnoreCase)).ToList();
            if (roleItems.Any())
            {
               var roleTitle = role == "Admin" ? "Administrator Operating Manual" :
                               role == "Staff" ? "Staff & Teacher Operating Manual" :
                               "Student & Parent Portal Guide";

               var roleBadge = role == "Admin" ? "bg-primary" : role == "Staff" ? "bg-info text-dark" : "bg-success";
               var roleIcon = role == "Admin" ? "fa-shield-halved" : role == "Staff" ? "fa-chalkboard-user" : "fa-graduation-cap";

               <div class="mb-5" id="role-@role.ToLower()">
                  <div class="d-flex align-items-center gap-3 mb-4 pb-2 border-bottom">
                     <div class="rounded-3 @roleBadge text-white p-2 px-3 fs-5 shadow-sm">
                        <i class="fa-solid @roleIcon"></i>
                     </div>
                     <div>
                        <h3 class="fw-bold m-0 text-dark">@roleTitle</h3>
                        <small class="text-muted">Target Role: <strong>@role</strong> &bull; @roleItems.Count page guide(s) available</small>
                     </div>
                  </div>

                  <!-- Group by Controller -->
                  @{
                     var controllerGroups = roleItems.GroupBy(m => new { m.Area, m.ControllerName });
                  }

                  <div class="row g-4">
                     @foreach (var group in controllerGroups)
                     {
                        <div class="col-12">
                           <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                              <!-- Module Header -->
                              <div class="p-3 px-4 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                                 <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary">@group.Key.Area Module</span>
                                    <h5 class="fw-bold m-0 text-primary">
                                       <i class="fa-solid fa-folder-open me-2 text-primary"></i> @group.Key.ControllerName
                                    </h5>
                                 </div>
                                 <span class="badge bg-light text-dark border small">
                                    @group.Count() Guide@(group.Count() > 1 ? "s" : "") Available
                                 </span>
                              </div>

                              <!-- Pages under this Controller -->
                              <div class="p-4">
                                 <div class="row g-3">
                                    @foreach (var guide in group.OrderBy(p => p.SortOrder))
                                    {
                                       var steps = (guide.Instructions ?? "")
                                          .Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

                                       <div class="col-12" id="@guide.Title.ToSlug()">
                                          <div class="p-4 border rounded-3 bg-white h-100 position-relative shadow-sm">
                                             <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                                <div>
                                                   <div class="d-flex align-items-center gap-2 mb-1">
                                                      <span class="badge bg-primary-subtle text-primary border font-monospace px-2 py-1">
                                                         @guide.RouteUrl
                                                      </span>
                                                      @if (!string.IsNullOrEmpty(guide.BadgeText))
                                                      {
                                                         <span class="badge bg-warning-subtle text-dark border">@guide.BadgeText</span>
                                                      }
                                                   </div>
                                                   <h5 class="fw-bold text-dark m-0">@guide.Title</h5>
                                                </div>
                                             </div>

                                             <!-- What It Does -->
                                             <div class="mt-3 p-3 bg-white rounded-3 border">
                                                <h6 class="fw-bold text-primary mb-1">
                                                   <i class="fa-solid fa-circle-info me-1"></i> What This Page Does:
                                                </h6>
                                                <p class="text-muted small mb-0">@guide.WhatItDoes</p>
                                             </div>

                                             <!-- Instructions -->
                                             <div class="mt-3">
                                                <h6 class="fw-bold text-dark mb-2">
                                                   <i class="fa-solid fa-list-check text-success me-1"></i> Step-by-Step Operating Instructions:
                                                </h6>
                                                <ol class="mb-0 ps-3 small text-secondary">
                                                   @foreach (var step in steps)
                                                   {
                                                      var cleanStep = step.Trim();
                                                      if (cleanStep.Length > 2 && char.IsDigit(cleanStep[0]) && cleanStep[1] == '.')
                                                      {
                                                         cleanStep = cleanStep.Substring(2).Trim();
                                                      }
                                                      <li class="mb-1">@cleanStep</li>
                                                   }
                                                </ol>
                                             </div>
                                          </div>
                                       </div>
                                    }
                                 </div>
                              </div>
                           </div>
                        </div>
                     }
                  </div>
               </div>
            }
         }
      }
      else
      {
         <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-5">
            <i class="fa-solid fa-folder-open display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">No Guides Found</h4>
            <p class="text-muted">No operating instructions matched your search query. Try searching with a different term.</p>
            <a href="/KnowledgeBase" class="btn btn-primary rounded-pill px-4 mt-2">View All Guides</a>
         </div>
      }
   </div>
</div>

<!-- Support CTA Banner -->
<div class="py-5 bg-dark text-white">
   <div class="container py-3">
      <div class="row align-items-center g-4">
         <div class="col-lg-8" data-aos="fade-right">
            <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">24/7 Portal Technical Support</span>
            <h3 class="display-6 fw-bold text-white">Need Live Help with Any Page or Result Broadsheet?</h3>
            <p class="text-light lead mb-0">
               Our dedicated technical support team provides instant on-site and remote training, scoresheet assistance, and tenant customization.
            </p>
         </div>
         <div class="col-lg-4 text-lg-end" data-aos="fade-left">
            <a href="/Contact" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow">
               Contact Support Desk <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
         </div>
      </div>
   </div>
</div>
