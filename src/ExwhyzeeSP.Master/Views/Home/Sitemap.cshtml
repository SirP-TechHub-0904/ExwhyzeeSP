@{
    ViewData["Title"] = "Website Sitemap & Directory";
    Layout = "_PublicLayout";
    var blogs = ViewBag.RecentBlogs as IEnumerable<ExwhyzeeSP.Core.Models.Blog>;
    var categories = ViewBag.Categories as IEnumerable<ExwhyzeeSP.Core.Models.BlogCategory>;
}

<!-- Page Banner -->
<section class="page-banner" style="background: linear-gradient(rgba(10, 24, 50, 0.88), rgba(10, 24, 50, 0.96)), url('/assets/images/page-banner.png') center/cover no-repeat; padding: 100px 0 60px;">
    <div class="container text-center text-white">
        <h1 class="display-4 fw-bold mb-3">Website Sitemap &amp; Directory</h1>
        <p class="lead text-light mb-4" style="max-width: 750px; margin: 0 auto;">
            A complete architectural overview of pages, product modules, legal frameworks, and support channels across Exwhyzee SP.
        </p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent p-0 m-0">
                <li class="breadcrumb-item"><a href="/" class="text-info text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-light" aria-current="page">Sitemap</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Sitemap Directory Content -->
<section class="py-5" style="background-color: #f8fafc;">
    <div class="container py-4">
        <!-- XML Feed Notice -->
        <div class="d-flex justify-content-between align-items-center bg-white p-4 rounded-4 shadow-sm border mb-5">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-filetype-xml text-primary me-2"></i> Machine-Readable XML Feed</h5>
                <p class="text-muted small mb-0">Search engine crawlers and scrapers can access the real-time XML sitemap protocol below.</p>
            </div>
            <a href="/sitemap.xml" target="_blank" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-box-arrow-up-right me-1"></i> View sitemap.xml
            </a>
        </div>

        <div class="row g-4">
            <!-- Main Navigation Pages -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                            <i class="bi bi-compass fs-4"></i>
                        </div>
                        <h5 class="fw-bold m-0">Core Pages</h5>
                    </div>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><a href="/" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Homepage</a></li>
                        <li><a href="/About" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> About Exwhyzee SP</a></li>
                        <li><a href="/Services" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> ERP Services &amp; Features</a></li>
                        <li><a href="/Pricing" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Pricing Plans</a></li>
                        <li><a href="/Testimonials" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Customer Testimonials</a></li>
                        <li><a href="/Demo" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Request Live Demo</a></li>
                        <li><a href="/Contact" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Contact &amp; Support</a></li>
                    </ul>
                </div>
            </div>

            <!-- News & Articles -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-info-subtle text-info p-3 me-3">
                            <i class="bi bi-newspaper fs-4"></i>
                        </div>
                        <h5 class="fw-bold m-0">News &amp; Blog</h5>
                    </div>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><a href="/Blog" class="text-dark text-decoration-none fw-bold hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> All EdTech Articles</a></li>
                        @if (categories != null)
                        {
                            @foreach (var c in categories)
                            {
                                var cSlug = c.Title.ToSlug();
                                <li>
                                    <a href="/Blog/Category/@c.Id/@cSlug" class="text-dark text-decoration-none hover-primary">
                                        <i class="bi bi-folder2 text-muted me-1"></i> @c.Title
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>

            <!-- Help & Documentation -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-warning-subtle text-warning p-3 me-3">
                            <i class="bi bi-question-circle fs-4"></i>
                        </div>
                        <h5 class="fw-bold m-0">Help &amp; Docs</h5>
                    </div>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><a href="/KnowledgeBase" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Knowledge Base &amp; FAQs</a></li>
                        <li><a href="/KnowledgeBase#scoresheet" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Scoresheet Upload Guide</a></li>
                        <li><a href="/KnowledgeBase#cbt" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> CBT Exam Engine Guide</a></li>
                        <li><a href="/KnowledgeBase#bursary" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Fee Payments &amp; Bursary</a></li>
                        <li><a href="/KnowledgeBase#sms" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Bulk SMS Sender ID Setup</a></li>
                        <li><a href="/KnowledgeBase#security" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Cloud Backups &amp; Security</a></li>
                    </ul>
                </div>
            </div>

            <!-- Legal & Governance -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-success-subtle text-success p-3 me-3">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                        <h5 class="fw-bold m-0">Legal &amp; Policy</h5>
                    </div>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><a href="/Privacy" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Privacy Policy (NDPR)</a></li>
                        <li><a href="/Terms" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Terms of Service &amp; SLA</a></li>
                        <li><a href="/Cookies" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> Cookie Policy</a></li>
                        <li><a href="/robots.txt" target="_blank" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> robots.txt Direct File</a></li>
                        <li><a href="/sitemap.xml" target="_blank" class="text-dark text-decoration-none hover-primary"><i class="bi bi-arrow-right-short text-primary"></i> sitemap.xml Feed</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
