@model ExwhyzeeSP.Master.Controllers.ResetAdminPasswordViewModel
@{
    ViewData["Title"] = "Reset Administrator Password";
    Layout = "_AdminLayout";
}

<div class="space-y-4 max-w-2xl mx-auto">

    <!-- ============ Hero Header (Dreams Core Profile Style) ============ -->
    <div class="surface-card p-5 lg:p-6 animate-rise-in">
        <div class="flex flex-wrap items-start justify-between gap-5 w-full">
            <div class="flex items-start gap-4">
                <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Users">
                    <i class="icon-arrow-left text-[16px]"></i>
                </a>

                <div class="relative shrink-0 size-16 rounded-2xl bg-amber-500/10 text-amber-600 grid place-items-center border border-amber-500/20 shadow-xs">
                    <i class="icon-key text-[28px]"></i>
                </div>

                <div class="pt-0.5">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Reset Operator Password</h1>
                        <span class="badge-soft badge-warning">
                            <i class="icon-lock text-[9px]"></i> Credentials
                        </span>
                    </div>
                    
                    <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1">
                        Updating login credentials for <strong class="text-[var(--text-primary)]">@Model.FullName</strong> (<code class="font-mono text-[var(--color-primary-600)]">@Model.Email</code>).
                    </p>
                </div>
            </div>

            <!-- Action buttons on far right -->
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-arrow-left text-[14px]"></i>
                    <span>Back to Users</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ============ Form ============ -->
    <div class="surface-card p-5 lg:p-6">
        <form asp-action="ResetPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FullName" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 text-xs" role="alert"></div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">New Password <span class="text-rose-500">*</span></label>
                <input asp-for="NewPassword" type="password" class="w-full h-10 px-3.5 py-2 text-xs font-mono rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:outline-none" placeholder="Minimum 6 characters" autofocus required />
                <span asp-validation-for="NewPassword" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5">Confirm New Password <span class="text-rose-500">*</span></label>
                <input asp-for="ConfirmPassword" type="password" class="w-full h-10 px-3.5 py-2 text-xs font-mono rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-card)] text-[var(--text-primary)] focus:border-[var(--color-primary-500)] focus:outline-none" placeholder="Re-enter new password" required />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-3">
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-4 py-2 rounded-lg text-decoration-none">
                    <span>Cancel</span>
                </a>
                <button type="submit" class="btn btn-warning text-xs font-semibold px-4 py-2 rounded-lg flex items-center gap-1.5 shadow-sm">
                    <i class="icon-key text-[14px]"></i>
                    <span>Update Password</span>
                </button>
            </div>
        </form>
    </div>

</div>
