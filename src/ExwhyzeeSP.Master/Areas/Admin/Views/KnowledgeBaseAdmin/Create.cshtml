@model ExwhyzeeSP.Core.Models.MasterKnowledgeBaseItem
@{
    ViewData["Title"] = "Add Knowledge Base Guide";
    Layout = "_AdminLayout";
}

<div class="space-y-4">

    <!-- ============ Hero Header (Dreams Core Profile Style) ============ -->
    <div class="surface-card p-5 lg:p-6 animate-rise-in">
        <div class="flex flex-wrap items-start justify-between gap-5 w-full">
            <div class="flex items-start gap-4">
                <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Guides">
                    <i class="icon-arrow-left text-[16px]"></i>
                </a>

                <div class="relative shrink-0 size-16 rounded-2xl bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center border border-[var(--color-primary-500)]/20 shadow-xs">
                    <i class="icon-book-open text-[28px]"></i>
                </div>

                <div class="pt-0.5">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Add Knowledge Base Guide</h1>
                        <span class="badge-soft badge-primary">
                            <i class="icon-plus text-[9px]"></i> Documentation
                        </span>
                    </div>
                    
                    <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1">
                        Map step-by-step instructions and route help documentation to portal screens and user roles.
                    </p>
                </div>
            </div>

            <!-- Action buttons on far right -->
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-arrow-left text-[14px]"></i>
                    <span>Back to Guides</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ============ Form ============ -->
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs font-medium text-rose-600 dark:text-rose-400"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Form Column -->
            <div class="lg:col-span-8 space-y-6">

                <!-- Guide Details -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-file-text text-[15px] text-[var(--color-primary-500)]"></i>
                        Guide Information
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="TargetRole" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Target Audience Role *</label>
                            <select asp-for="TargetRole" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" required>
                                <option value="Admin">Administrator (Admin)</option>
                                <option value="Staff">Staff &amp; Teacher (Staff)</option>
                                <option value="Student">Student &amp; Parent (Student)</option>
                            </select>
                            <span asp-validation-for="TargetRole" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Area" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Portal Area *</label>
                            <select asp-for="Area" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" required>
                                <option value="Admin">Admin</option>
                                <option value="Staff">Staff</option>
                                <option value="Student">Student</option>
                                <option value="CBTExam">CBTExam</option>
                                <option value="Content">Content</option>
                                <option value="Financial">Financial</option>
                                <option value="Accomodation">Accomodation</option>
                                <option value="OnlineClass">OnlineClass</option>
                            </select>
                            <span asp-validation-for="Area" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ControllerName" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Controller Name *</label>
                            <input asp-for="ControllerName" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" placeholder="e.g. ResultManagement" required />
                            <span asp-validation-for="ControllerName" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ActionName" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Action / Page Name *</label>
                            <input asp-for="ActionName" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" placeholder="e.g. BatchResult" required />
                            <span asp-validation-for="ActionName" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="RouteUrl" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Route URL *</label>
                            <input asp-for="RouteUrl" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono text-[var(--text-primary)]" placeholder="e.g. /Admin/ResultManagement/BatchResult" required />
                            <span asp-validation-for="RouteUrl" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Title" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Guide Title *</label>
                            <input asp-for="Title" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-bold text-[var(--text-primary)]" placeholder="e.g. Batch Result Processing & Broadsheets" required />
                            <span asp-validation-for="Title" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="WhatItDoes" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">What This Screen Does (Summary) *</label>
                            <textarea asp-for="WhatItDoes" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" rows="3" placeholder="Explain the operational purpose of this screen..." required></textarea>
                            <span asp-validation-for="WhatItDoes" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Instructions" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Step-by-Step Instructions *</label>
                            <textarea asp-for="Instructions" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono text-[var(--text-primary)]" rows="6" placeholder="1. Navigate to /Area/Controller/Action.
2. Select session, term, and class arm.
3. Click Compute to generate broadsheets.
4. Verify student marks and click Approve & Publish." required></textarea>
                            <span asp-validation-for="Instructions" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Settings & Submit -->
            <div class="lg:col-span-4 space-y-6">

                <!-- Settings -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-sliders text-[15px] text-[var(--color-primary-500)]"></i>
                        Settings
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="BadgeText" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Badge Category</label>
                            <input asp-for="BadgeText" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" placeholder="e.g. Academics, Grading, Fees" />
                            <span asp-validation-for="BadgeText" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="SortOrder" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Display Sort Order</label>
                            <input asp-for="SortOrder" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" type="number" value="1" />
                            <span asp-validation-for="SortOrder" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-sunken)] space-y-3">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input asp-for="IsPublished" type="checkbox" class="form-checkbox rounded text-[var(--color-primary-500)] size-4" checked />
                                <span class="text-xs font-semibold text-[var(--text-primary)]">Published &amp; Live</span>
                            </label>
                            <p class="text-[11px] text-[var(--text-tertiary)] pl-6.5">Controls public visibility in the knowledge base and contextual help panels.</p>
                        </div>
                    </div>
                </div>

                <!-- Form Action Card -->
                <div class="surface-card p-5 space-y-3">
                    <button type="submit" class="btn btn-primary w-full py-2.5 text-xs font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                        <i class="icon-check text-[15px]"></i>
                        <span>Save Guide</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline border-secondary w-full py-2 text-xs font-semibold rounded-lg text-center flex items-center justify-center gap-1.5 text-decoration-none">
                        <i class="icon-arrow-left text-[13px]"></i>
                        <span>Cancel</span>
                    </a>
                </div>

            </div>

        </div>
    </form>
</div>
