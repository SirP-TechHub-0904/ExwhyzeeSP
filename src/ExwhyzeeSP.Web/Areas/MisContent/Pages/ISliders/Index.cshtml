@page
@model ExwhyzeeSP.Web.Areas.MisContent.Pages.ISliders.IndexModel

@{
    ViewData["Title"] = "Sliders & Banners";
}

@section HeaderActions {
    <a asp-page="./Create" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Add New</a>
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-picture-o"></i> Sliders &amp; Banners</h3>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th style="width: 50px;">S/N</th>
                        <th style="width: 110px;">Image</th>
                        <th>Title</th>
                        <th style="width: 90px;">Sort Order</th>
                        <th style="width: 80px;">Show</th>
                        <th style="width: 130px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sn = 0; }
                    @foreach (var item in Model.Slider)
                    {
                        sn++;
                        <tr>
                            <td>@sn</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <img src="@item.Url" alt="@item.Title" style="max-height:55px; max-width:95px; object-fit:cover; border-radius:4px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>
                            <td>
                                <strong>@Html.Raw(item.Title)</strong>
                                @if (!string.IsNullOrWhiteSpace(item.MiniTitle))
                                {
                                    <div class="text-muted small">@item.MiniTitle</div>
                                }
                            </td>
                            <td>@item.SortOrder</td>
                            <td>
                                @if (item.Show)
                                {
                                    <span class="label label-success">Visible</span>
                                }
                                else
                                {
                                    <span class="label label-default">Hidden</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-primary btn-xs dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                        Action <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-right" role="menu">
                                        <li><a asp-page="./Details" asp-route-id="@item.Id"><i class="fa fa-eye"></i> Details</a></li>
                                        <li><a asp-page="./Edit" asp-route-id="@item.Id"><i class="fa fa-edit"></i> Edit</a></li>
                                        <li class="divider"></li>
                                        <li><a asp-page="./Delete" asp-route-id="@item.Id" class="text-danger"><i class="fa fa-trash"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
