@model ExwhyzeeSP.Core.Models.MasterSchoolTransaction
@using ExwhyzeeSP.Core.Models
@{
    ViewData["Title"] = $"Edit Transaction - {Model.InvoiceNumber}";
    Layout = "_AdminLayout";
}

<div class="space-y-4">

    <!-- ============ Hero Header (Dreams Core Profile Style) ============ -->
    <div class="surface-card p-5 lg:p-6 animate-rise-in">
        <div class="flex flex-wrap items-start justify-between gap-5 w-full">
            <div class="flex items-start gap-4">
                <a asp-action="Index" class="header-icon-btn shrink-0 text-decoration-none" title="Back to Invoices">
                    <i class="icon-arrow-left text-[16px]"></i>
                </a>

                <div class="relative shrink-0 size-16 rounded-2xl bg-emerald-500/10 text-emerald-600 grid place-items-center border border-emerald-500/20 shadow-xs">
                    <i class="icon-receipt text-[28px]"></i>
                </div>

                <div class="pt-0.5">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="font-display font-bold text-[20px] tracking-tight text-[var(--text-primary)]">Edit Transaction: @Model.InvoiceNumber</h1>
                        @if (Model.Status == SchoolPaymentStatus.Paid)
                        {
                            <span class="badge-soft badge-success">
                                <i class="icon-circle-check text-[9px]"></i> Paid
                            </span>
                        }
                        else if (Model.Status == SchoolPaymentStatus.Pending)
                        {
                            <span class="badge-soft badge-warning">
                                <i class="icon-clock text-[9px]"></i> Pending
                            </span>
                        }
                        else
                        {
                            <span class="badge-soft badge-danger">
                                <i class="icon-alert-triangle text-[9px]"></i> @Model.Status
                            </span>
                        }
                    </div>
                    
                    <p class="text-[12.5px] text-[var(--text-tertiary)] mt-1">
                        Update billing breakdown, record payment confirmation, and manage receipts for this transaction.
                    </p>
                </div>
            </div>

            <!-- Action buttons on far right -->
            <div class="flex items-center gap-2 shrink-0 ms-auto">
                <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-printer text-[14px]"></i>
                    <span>View Receipt</span>
                </a>
                <a asp-action="Index" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                    <i class="icon-arrow-left text-[14px]"></i>
                    <span>Back to Ledger</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ============ Edit Form ============ -->
    <form asp-action="Edit" method="post" class="space-y-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs font-medium text-rose-600 dark:text-rose-400"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Primary Transaction Information (Left Column) -->
            <div class="lg:col-span-8 space-y-6">

                <!-- Basic Details -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-file-text text-[15px] text-[var(--color-primary-500)]"></i>
                        Invoice Core Details
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="InvoiceNumber" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Invoice Number *</label>
                            <input asp-for="InvoiceNumber" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono font-bold text-[var(--text-primary)]" />
                            <span asp-validation-for="InvoiceNumber" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="TenantSchoolId" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Target School Portal *</label>
                            <select asp-for="TenantSchoolId" asp-items="ViewBag.Schools" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]"></select>
                            <span asp-validation-for="TenantSchoolId" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Title" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Invoice Title / Item Summary *</label>
                            <input asp-for="Title" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="Title" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="BillingType" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Billing Category *</label>
                            <select asp-for="BillingType" asp-items="Html.GetEnumSelectList<SchoolBillingType>()" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]"></select>
                            <span asp-validation-for="BillingType" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="DueDate" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Payment Due Date *</label>
                            <input asp-for="DueDate" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" type="date" />
                            <span asp-validation-for="DueDate" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Description" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Internal Notes / Breakdown Terms</label>
                            <textarea asp-for="Description" class="form-textarea w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Payment Settlement Information -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-credit-card text-[15px] text-emerald-500"></i>
                        Payment Settlement &amp; Bank Reference
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="PaidDate" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Date Paid</label>
                            <input asp-for="PaidDate" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" type="date" />
                            <span asp-validation-for="PaidDate" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="PaymentChannel" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Payment Channel</label>
                            <select asp-for="PaymentChannel" asp-items="Html.GetEnumSelectList<SchoolPaymentChannel>()" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]"></select>
                            <span asp-validation-for="PaymentChannel" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="BankReference" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Bank / Transaction Reference</label>
                            <input asp-for="BankReference" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" />
                            <span asp-validation-for="BankReference" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="ReceiptNumber" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Official Receipt Number</label>
                            <input asp-for="ReceiptNumber" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-mono text-[var(--text-primary)]" />
                            <span asp-validation-for="ReceiptNumber" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="ProofDocumentUrl" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Proof of Payment URL / Document</label>
                            <input asp-for="ProofDocumentUrl" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs text-[var(--text-primary)]" placeholder="https://..." />
                            <span asp-validation-for="ProofDocumentUrl" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right Column: Financial Summary & Actions -->
            <div class="lg:col-span-4 space-y-6">

                <!-- Financial Balance Card -->
                <div class="surface-card p-5 lg:p-6 space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--text-tertiary)] flex items-center gap-2 pb-2 border-b border-[var(--border-subtle)]">
                        <i class="icon-dollar-sign text-[15px] text-[var(--color-primary-500)]"></i>
                        Amount &amp; Status
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="Amount" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Total Amount (&#8358;) *</label>
                            <input asp-for="Amount" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-base font-bold text-[var(--text-primary)]" type="number" step="0.01" />
                            <span asp-validation-for="Amount" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="AmountPaid" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Amount Paid (&#8358;)</label>
                            <input asp-for="AmountPaid" class="form-input w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-base font-bold text-emerald-600 dark:text-emerald-400" type="number" step="0.01" />
                            <span asp-validation-for="AmountPaid" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Status" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">Payment Status *</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<SchoolPaymentStatus>()" class="form-select w-full rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3.5 py-2 text-xs font-semibold text-[var(--text-primary)]"></select>
                            <span asp-validation-for="Status" class="text-rose-500 text-[11px] mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Form Action Card -->
                <div class="surface-card p-5 space-y-3">
                    <button type="submit" class="btn btn-primary w-full py-2.5 text-xs font-semibold rounded-lg shadow-sm flex items-center justify-center gap-2">
                        <i class="icon-check text-[15px]"></i>
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline border-secondary w-full py-2 text-xs font-semibold rounded-lg text-center flex items-center justify-center gap-1.5 text-decoration-none">
                        <i class="icon-arrow-left text-[13px]"></i>
                        <span>Cancel</span>
                    </a>
                </div>

            </div>

        </div>
    </form>
</div>
