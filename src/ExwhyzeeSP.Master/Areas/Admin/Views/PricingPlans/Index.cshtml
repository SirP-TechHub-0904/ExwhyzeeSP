@model IEnumerable<ExwhyzeeSP.Core.Models.MasterPricingPlan>
@{
    ViewData["Title"] = "Pricing Plans Management";
    Layout = "_AdminLayout";
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Public Pricing Plans &amp; Packages</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Manage subscription tiers, feature checklists, fees, and billing cycles displayed on the public website.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Create" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-plus text-[14px]"></i>
                <span>Add Pricing Plan</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3">
            <i class="icon-check-circle text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Pricing Plans Table Card -->
    <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-[var(--surface-sunken)] border-b border-[var(--border-subtle)] text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)]">
                    <tr>
                        <th class="py-3 px-4 w-16">Order</th>
                        <th class="py-3 px-4">Plan Name &amp; Description</th>
                        <th class="py-3 px-4">Price &amp; Billing</th>
                        <th class="py-3 px-4">Badge</th>
                        <th class="py-3 px-4">Popular</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-subtle)]">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var plan in Model)
                        {
                            <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors">
                                <td class="py-3.5 px-4 font-mono font-bold text-[var(--text-tertiary)]">
                                    #@plan.SortOrder
                                </td>
                                <td class="py-3.5 px-4">
                                    <strong class="text-sm font-bold text-[var(--text-primary)] block">@plan.Name</strong>
                                    <span class="text-[11.5px] text-[var(--text-tertiary)]">@(plan.Subtitle ?? plan.Description)</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-[var(--color-primary-600)] text-sm">@plan.PriceText</span>
                                    <span class="text-[11px] text-[var(--text-tertiary)] block">@plan.BillingCycle</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrEmpty(plan.BadgeText))
                                    {
                                        <span class="badge-soft badge-primary">@plan.BadgeText</span>
                                    }
                                    else
                                    {
                                        <span class="text-[var(--text-tertiary)]">-</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (plan.IsPopular)
                                    {
                                        <span class="badge-soft badge-warning">
                                            <i class="icon-star text-[9px]"></i> Popular
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] text-[var(--text-tertiary)]">Standard</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    <form asp-action="ToggleActive" asp-route-id="@plan.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="badge-soft @(plan.IsActive ? "badge-success" : "badge-danger") border-0 cursor-pointer" title="Click to toggle status">
                                            <i class="@(plan.IsActive ? "icon-circle-check" : "icon-circle-x") text-[9px]"></i>
                                            @(plan.IsActive ? "Active" : "Hidden")
                                        </button>
                                    </form>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5 ms-auto">
                                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-outline border-secondary text-xs px-2.5 py-1.5 rounded-lg text-decoration-none flex items-center gap-1" title="Edit Plan">
                                            <i class="icon-edit text-[13px]"></i>
                                            <span>Edit</span>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@plan.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this pricing plan?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline border-rose-500/30 text-rose-600 hover:bg-rose-500/10 text-xs px-2.5 py-1.5 rounded-lg flex items-center gap-1" title="Delete Plan">
                                                <i class="icon-trash text-[13px]"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-[var(--text-tertiary)]">
                                <div class="size-12 rounded-2xl bg-[var(--surface-sunken)] grid place-items-center mx-auto mb-3">
                                    <i class="icon-tag text-[24px] text-[var(--text-tertiary)]"></i>
                                </div>
                                <p class="text-sm font-semibold text-[var(--text-primary)]">No Pricing Plans Found</p>
                                <p class="text-xs text-[var(--text-tertiary)] mt-1">Click "Add Pricing Plan" to publish your first subscription package.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
