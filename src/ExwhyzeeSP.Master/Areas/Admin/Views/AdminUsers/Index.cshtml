@section Scripts {
    <script>
        function switchViewTab(tab) {
            const usersSection = document.getElementById('usersViewSection');
            const rolesSection = document.getElementById('rolesViewSection');
            const tabUsersBtn = document.getElementById('tabUsersBtn');
            const tabRolesBtn = document.getElementById('tabRolesBtn');

            if (tab === 'users') {
                usersSection.classList.remove('hidden');
                rolesSection.classList.add('hidden');
                
                tabUsersBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 bg-sky-600 text-white shadow-xs';
                tabRolesBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-2';
            } else {
                usersSection.classList.add('hidden');
                rolesSection.classList.remove('hidden');

                tabRolesBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 bg-sky-600 text-white shadow-xs';
                tabUsersBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-slate-100 dark:hover:bg-slate-800 transition-all flex items-center gap-2';
            }
        }
    </script>
}
