        .btn-mobile {
            padding: 2px 6px !important;
            font-size: 12px !important;
            font-weight: 200 !important;
            white-space: normal;
        }
    </style>
    <style>
        .example-modal .modal {
            position: relative;
            top: auto;
            bottom: auto;
            right: auto;
            left: auto;
            display: block;
            z-index: 1;
        }

        .example-modal .modal {
            background: transparent !important;
        }

        .direct-chat-messages {
            height: auto !important;
        }

        .row {
            margin-right: 0px !important;
            margin-left: 0px !important;
        }

        tr > th, tr > th, tr > th, tr > td, tr > td, tr > td {
            border: 1px solid #c1c1c1 !important;
        }

        table td {
            white-space: nowrap
        }


        @@media print {
            /*@@page { margin: 0; }
            body { margin: 1.6cm; }*/
            table {
                border: solid #000 !important;
                border-width: 1px 0 0 1px !important;
                page-break-inside: avoid;
                margin: 0;
            }

            th, td {
                border: solid #000 !important;
                border-width: 0 1px 1px 0 !important;
                margin: 0;
            }
        }



        /* Fixed/sticky icon bar (vertically aligned 50% from the top of the screen) */
        .icon-bar {
            position: fixed;
            top: 30%;
            -webkit-transform: translateY(50%);
            -ms-transform: translateY(50%);
            transform: translateY(50%);
        }

            /* Style the icon bar links */
            .icon-bar a {
                display: block;
                text-align: center;
                padding: 16px;
                transition: all 0.3s ease;
                color: white;
                font-size: 20px;
            }

                /* Style the social media icons with color, if you want */
                .icon-bar a:hover {
                    background-color: #000;
                }

        .buttons {
            background: #3B5998;
            color: white;
        }

        .wrapper {
            overflow: visible;
        }

        .skin-blue .sidebar-form input[type="text"] {
            color: white;
            font-weight: 800;
        }

        /*'''''*/

        /*'''''''*/

        .sticky-container {
            padding: 0px;
            margin: 0px;
            position: fixed;
            right: -110px;
            top: 420px;
            width: 220px;
            z-index: 1100;
        }

        .sticky li {
            list-style-type: none;
            background-color: #fff;
            color: #efefef;
            height: 43px;
            padding: 0px;
            padding-left: 5px;
            margin: 0px 0px 1px 0px;
            -webkit-transition: all 0.25s ease-in-out;
            -moz-transition: all 0.25s ease-in-out;
            -o-transition: all 0.25s ease-in-out;
            transition: all 0.25s ease-in-out;
            cursor: pointer;
        }

            .sticky li:hover {
                margin-left: -115px;
            }

            .sticky li img {
                float: left;
                margin: 5px 4px;
                margin-right: 5px;
            }

            .sticky li p {
                padding-top: 5px;
                margin: 0px;
                line-height: 16px;
                font-size: 11px;
            }

                .sticky li p a {
                    text-decoration: none;
                    color: #2C3539;
                }

                    .sticky li p a:hover {
                        text-decoration: underline;
                    }
    </style>

    <style>
        @@media print {
            .noprint {
                display: none !important;
            }

            html {
                zoom: 75%;
                font-size: 55% !important;
            }
        }

        .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
            padding: 6px;
            line-height: 1.0;
            vertical-align: middle;
        }

    </style>
    @Html.Raw(GeneralService.Analytics())
</head>
<body class="hold-transition skin-blue sidebar-mini">
    <div class="wrapper">

        <header class="main-header">
            <!-- Logo -->
            <a href="~/Admin/DashBoard/Index" class="logo">
                <!-- mini logo for sidebar mini 50x50 pixels -->
                <span class="logo-mini">
                    @if (!string.IsNullOrEmpty(GeneralService.SchoolLogoBase64()))
                    {
                        <img src="@GeneralService.SchoolLogoBase64()" alt="Logo" style="max-height:34px; max-width:34px; border-radius:50%; background:#fff; padding:2px; vertical-align:middle;" />
                    }
                    else
                    {
                        <b>@GeneralService.SchoolInitials()</b>
                    }
                </span>
                <!-- logo for regular state and mobile devices -->
                <span class="logo-lg" style="font-size:14px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">
                    @if (!string.IsNullOrEmpty(GeneralService.SchoolLogoBase64()))
                    {
                        <img src="@GeneralService.SchoolLogoBase64()" alt="Logo" style="max-height:32px; max-width:32px; border-radius:50%; background:#fff; padding:2px; vertical-align:middle; margin-right:5px;" />
                    }
                    <b>@GeneralService.SchoolInitials()</b>
                </span>
            </a>
            <!-- Header Navbar: style can be found in header.less -->
            <nav class="navbar navbar-static-top">
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                    <span class="sr-only">Toggle navigation</span>
                </a>

                <!-- School Name Title Bar in Navbar -->
                <div style="float:left; line-height:50px; padding-left:15px; color:#ffffff; font-weight:700; font-size:15px; letter-spacing:0.3px; text-transform:uppercase; max-width:calc(100% - 180px); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    <span class="hidden-xs">@GeneralService.SchoolName()</span>
                    <span class="visible-xs">@GeneralService.SchoolInitials()</span>
                </div>

                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        @using (Html.BeginForm("LogOff", "XYZ", new { area = "Account" }, FormMethod.Post, new { id = "logoutForm" }))
                        {
                            <li class="dropdown user user-menu">
                                <a href="javascript:document.getElementById('logoutForm').submit()" style="position: relative;color:#fff; text-decoration:none; display: block;padding: 10px 15px;">
                                    <i class="fa fa-sign-out"></i> Sign Out
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </header>
        <!-- Left side column. contains the logo and sidebar -->
        <aside class="main-sidebar">
            <!-- sidebar: style can be found in sidebar.less -->
            <section class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel" style="display:flex; align-items:center; padding:12px 10px; gap:10px;">
                    <div class="image" style="flex-shrink:0;">
                        @if (!string.IsNullOrEmpty(GeneralService.SchoolLogoBase64()))
                        {
                            <img src="@GeneralService.SchoolLogoBase64()" class="img-circle" alt="Logo" style="width:45px; height:45px; object-fit:cover; background:#fff; padding:2px; border:1px solid #ddd;" />
                        }
                        else
                        {
                            <img src="~/admin/dist/img/avatar5.jpg" class="img-circle" alt="User Image" style="width:45px; height:45px; object-fit:cover;" />
                        }
                    </div>
                    <div class="info" style="position:static; padding:0; flex-grow:1; overflow:hidden;">
                        <p style="margin:0 0 4px 0; font-weight:600; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@User.Identity.Name</p>
                        <p style="margin:0; font-size:11px; color:#b8c7ce;">
                            @if (User.IsInRole("Admin"))
                            {
                                <span>(Admin)</span>
                            }
                            @if (User.IsInRole("Staff"))
                            {
                                <span>(Staff)</span>
                            }
                            @if (User.IsInRole("Student"))
                            {
                                <span>(@GeneralService.StudentorPupil())</span>
                            }
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <span>(Super Admin)</span>
                            }
                            @if (User.IsInRole("FormTeacher"))
                            {
                                <span>(Form Teacher)</span>
                            }
                        </p>
                    </div>
                </div>
                <!-- search form  <a href="#"><i class="fa fa-circle text-success"></i> Online</a> -->
                <form action="#" method="get" class="sidebar-form">
                    <div class="input-group">
                        <input type="text" name="" value="Online" class="form-control" disabled="disabled">
                        <span class="input-group-btn">
                            <button type="submit" name="search" id="search-btn" class="btn btn-flat">
                                <i class="fa fa-circle text-success"></i>
                            </button>
                        </span>
                    </div>
                </form>
                <!-- /.search form -->
                <!-- sidebar menu: : style can be found in sidebar.less -->

                <ul class="sidebar-menu" data-widget="tree">


