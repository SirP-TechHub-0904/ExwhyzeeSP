                                <span class="pull-right-container">
                                    <i class="fa fa-angle-left pull-right"></i>
                                </span>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="@Url.Action("Index", "ResultArchive", new { area="SuperUser"})"><i class="fa fa-bar-chart-o"></i> <span> Archived Result</span></a></li>
                                <li><a href="@Url.Action("ArchiveResult", "ResultArchive", new { area="SuperUser"})"><i class="fa fa-bar-chart-o"></i> <span> Archive Student Result</span></a></li>
                                <li><a href="@Url.Action("Result", "ArchiveResult", new { area="Student"})"><i class="fa fa-bar-chart-o"></i> <span> Print Archive Result</span></a></li>

                            </ul>
                        </li>
                        <li class="treeview">
                            <a href="#">
                                <i class="fa fa-globe"></i> <span>Website & Content CMS</span>
                                <span class="pull-right-container">
                                    <i class="fa fa-angle-left pull-right"></i>
                                </span>
                            </a>
                            <ul class="treeview-menu">
                                <li><a href="/MisContent/WebSetting"><i class="fa fa-cogs"></i> Website Settings & Theme</a></li>
                                <li><a href="/UI" target="_blank"><i class="fa fa-desktop"></i> UI Themes & Section Samples</a></li>
                                <li><a href="/MisContent/WebSetting/UiProperty"><i class="fa fa-sliders"></i> UI Properties</a></li>
                                <li><a href="/MisContent/WebSetting/DesignSettings"><i class="fa fa-paint-brush"></i> Design Settings</a></li>
                                <li><a href="/MisContent/ISliders"><i class="fa fa-picture-o"></i> Sliders & Banners</a></li>
                                <li><a href="/MisContent/IPages/Main"><i class="fa fa-file-text-o"></i> Web Pages & Menus</a></li>
                                <li><a href="/MisContent/IPages/Category"><i class="fa fa-folder-open-o"></i> Page Categories</a></li>
                                <li><a href="/MisContent/IPages/Section"><i class="fa fa-th-large"></i> Page Sections & Layouts</a></li>
                                <li><a href="/MisContent/IBlogs/Post"><i class="fa fa-newspaper-o"></i> Blog & News Posts</a></li>
                                <li><a href="/MisContent/IBlogs/Category"><i class="fa fa-tags"></i> Blog Categories</a></li>
                                <li><a href="/MisContent/ITestimony"><i class="fa fa-quote-left"></i> Testimonials</a></li>
                                <li><a href="/MisContent/IFaq"><i class="fa fa-question-circle"></i> FAQs</a></li>
                                <li><a href="/MisContent/IModal"><i class="fa fa-bullhorn"></i> Pop-up Announcements</a></li>
                                <li><a href="/MisContent/Reconciliation"><i class="fa fa-refresh"></i> Image/File Reconciliation</a></li>
                            </ul>
                        </li>
                        <li><a href="@Url.Action("Index", "DeviceManager", new { area = "SuperDevice" })"><i class="fa fa-desktop"></i> <span> Super Admin Device</span></a></li>
                        <li><a href="@Url.Action("Newsletter", "Settings", new { area = "Admin" })"><i class="fa fa-book"></i> <span>Newsletter</span></a></li>
                        <li><a href="@Url.Action("UpdateSchoolLogo", "Settings", new { area = "Admin" })"><i class="fa fa-lock"></i> <span>Update School Logo</span></a></li>
                        //if (User.IsInRole("Developer"))
                        //{
                        <li><a href="@Url.Action("SuperDetails", "Settings", new { area = "Admin" })"><i class="fa fa-lock"></i> <span>Super Settings</span></a></li>
                        //}
                        <li><a href="@Url.Action("UserList", "AdminUser", new { area = "SuperUser" })"><i class="fa fa-bookmark"></i> <span> users</span></a></li>
                        <li><a href="@Url.Action("EmptyExcelFolder", "Settings", new { area = "Admin" })"><i class="fa fa-bookmark"></i> <span> Empty Excel Folder</span></a></li>
                        <li><a href="@Url.Action("AdminPinIndex", "PinManagement", new { area = "Admin" })"><i class="fa fa-lock"></i> <span> Pins</span></a></li>
                        <li><a href="@Url.Action("ReloadAllStudent", "Panel", new { area = "Staff" })"><i class="fa fa-lock"></i> <span> Reload</span></a></li>
                        <li><a href="@Url.Action("CheckClassPublish", "ResultManagement", new { area = "Admin" })"><i class="fa fa-podcast"></i> <span> Publish Status</span></a></li>
                        <li><a href="@Url.Action("Index", "WebsiteSettings", new { area = "SuperUser" })"><i class="fa fa-globe"></i> <span> Website Settings</span></a></li>
                        <li><a href="@Url.Action("UploadCard", "ImportFromExcel", new { area = "SuperUser" })"><i class="fa fa-upload"></i> <span> Card Upload</span></a></li>
                        <li><a href="@Url.Action("StudentsInTerm", "Doc", new { area = "Content" })"><i class="fa fa-book"></i> <span> @GeneralService.StudentorPupil() in a Term</span></a></li>
                        <li><a href="@Url.Action("Index", "Helps", new { area = "Content" })"><i class="fa fa-book"></i> <span> Help Document</span></a></li>
                        <li><a href="@Url.Action("ListBatch", "ResultManagement", new { area = "Admin" })"><i class="fa fa-book"></i> <span> View Batch</span></a></li>
