@model ExwhyzeeSP.Master.Controllers.ForceChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set New Password";
}

<!-- Auth Card -->
<div class="auth-card animate-rise-in">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning mb-3" style="width: 54px; height: 54px; font-size: 24px;">
        <i class="bi bi-shield-lock"></i>
    </div>

    <h4 class="fw-bold text-white mb-1">Establish Personal Password</h4>
    <p class="text-secondary small mb-4">
        As part of our first-time security onboarding, please replace your temporary credentials with a secure personal password.
    </p>

    <!-- Alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <form asp-controller="Account" asp-action="ForceChangePassword" method="post" id="forcePasswordForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger"></div>

        <!-- New Password Input -->
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label text-light small fw-semibold">New Secure Password</label>
            <div class="position-relative">
                <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control form-control-custom pe-5" placeholder="Minimum 6 characters" autofocus required />
                <button type="button" class="input-icon-btn" onclick="toggleFieldVisibility('newPasswordInput', 'newToggleIcon')" title="Toggle visibility">
                    <i class="bi bi-eye" id="newToggleIcon"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- Confirm Password Input -->
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label text-light small fw-semibold">Confirm New Password</label>
            <div class="position-relative">
                <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control form-control-custom pe-5" placeholder="Re-enter new password" required />
                <button type="button" class="input-icon-btn" onclick="toggleFieldVisibility('confirmPasswordInput', 'confirmToggleIcon')" title="Toggle visibility">
                    <i class="bi bi-eye" id="confirmToggleIcon"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- Password Guidance -->
        <div class="p-2.5 rounded-3 mb-4 text-start" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="text-secondary" style="font-size: 11.5px;">
                <i class="bi bi-info-circle text-info me-1"></i>
                Choose a strong password containing letters, numbers, and special symbols for maximum account protection.
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary-custom w-100 py-2.5 mb-3">
            <i class="bi bi-check2-circle me-1"></i> Update Password &amp; Enter Portal
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFieldVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
