@{
    ViewBag.Title = "Confirm Mass Delete Class Subjects";
    var classLevel = ViewBag.ClassLevel as ExwhyzeeSP.Core.Entities.ClassLevel;
    var subjects = ViewBag.Subjects as List<ExwhyzeeSP.Core.Entities.Subject> ?? new List<ExwhyzeeSP.Core.Entities.Subject>();
    int totalEnrollments = ViewBag.TotalEnrollments ?? 0;
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> DANGER: Mass Delete All Class Subjects</h3>
            </div>

            <div class="box-body">
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                        @TempData["error"]
                    </div>
                }

                <div class="callout callout-danger">
                    <h4><i class="fa fa-warning"></i> Permanent Deletion Warning</h4>
                    <p>
                        You are about to <strong>delete all @subjects.Count subject(s)</strong> created for <strong>@(classLevel?.ClassName)</strong> and permanently purge all <strong>@totalEnrollments student score record(s)</strong> tied to them.
                    </p>
                    <p><strong>This action CANNOT be undone!</strong></p>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading"><strong>Subjects to be deleted:</strong></div>
                    <ul class="list-group" style="max-height: 180px; overflow-y: auto;">
                        @foreach (var s in subjects)
                        {
                            <li class="list-group-item">
                                <i class="fa fa-book text-danger"></i> @s.SubjectName
                            </li>
                        }
                    </ul>
                </div>

                @using (Html.BeginForm("DelSubjectsInClass", "ClassLevels", new { area = "Admin", id = ViewBag.ClassId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-top: 25px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve deleting all @subjects.Count subjects for this class, type <strong style="text-decoration: underline; letter-spacing: 1px;">CONFIRM</strong>:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>

                    <div class="box-footer" style="padding: 15px 0 0 0; background: transparent;">
                        <button type="submit" id="btnSubmitDelete" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                            <i class="fa fa-trash"></i> Approve & Mass Delete Class Subjects
                        </button>
                        <a href="@Url.Action("Details", "ClassLevels", new { area = "Admin", id = ViewBag.ClassId })" class="btn btn-default btn-lg btn-flat pull-right">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitDelete');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
