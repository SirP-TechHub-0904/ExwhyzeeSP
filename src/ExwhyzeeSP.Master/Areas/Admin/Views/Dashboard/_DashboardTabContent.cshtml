                                <span class="text-[11px] text-[var(--text-tertiary)] block">@(kb.BadgeText ?? kb.TargetRole) &bull; Added @kb.CreatedAt.ToString("MMM dd")</span>
                            </div>
                            <i class="icon-eye text-[13px] text-[var(--text-tertiary)]"></i>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
