@{
    ViewData["Title"] = "Marketing & Broadcast Hub";
    Layout = "_AdminLayout";

    var recentCampaigns = ViewBag.RecentCampaigns as List<ExwhyzeeSP.Core.Models.MarketingCampaign> ?? new();
    var recentBroadcastEmails = ViewBag.RecentBroadcastEmails as List<ExwhyzeeSP.Core.Models.MasterEmailLog> ?? new();
    var tagStats = ViewBag.TagStats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Marketing &amp; Broadcast Hub</h1>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Target school leaders, send personalized bulk broadcasts, manage HTML templates, and monitor email delivery.
            </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Import" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-upload text-[14px]"></i>
                <span>Import Contacts</span>
            </a>
            <a asp-action="CreateCampaign" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none">
                <i class="icon-send text-[14px]"></i>
                <span>New Broadcast Campaign</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3">
            <i class="icon-check-circle text-[18px]"></i>
            <div class="text-xs font-semibold">@Html.Raw(TempData["SuccessMessage"])</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center gap-3">
            <i class="icon-alert-triangle text-[18px]"></i>
            <div class="text-xs font-semibold">@Html.Raw(TempData["ErrorMessage"])</div>
        </div>
    }

    <!-- Top KPI Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a asp-action="Contacts" class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 hover:border-sky-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none group cursor-pointer">
            <div class="size-11 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                <i class="icon-users text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors block">Total Audience</span>
                <span class="text-xl font-bold text-[var(--text-primary)] leading-tight block">@ViewBag.TotalContacts</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400">@ViewBag.SubscribedContacts Subscribed</span>
            </div>
            <i class="icon-chevron-right text-[12px] text-[var(--text-tertiary)] ms-auto opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"></i>
        </a>

        <a asp-action="Templates" class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 hover:border-amber-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none group cursor-pointer">
            <div class="size-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                <i class="icon-layout text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors block">Email Templates</span>
                <span class="text-xl font-bold text-[var(--text-primary)] leading-tight block">@ViewBag.TotalTemplates</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">HTML Designs</span>
            </div>
            <i class="icon-chevron-right text-[12px] text-[var(--text-tertiary)] ms-auto opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"></i>
        </a>

        <a href="#recent-campaigns" class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 hover:border-purple-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none group cursor-pointer">
            <div class="size-11 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                <i class="icon-radio text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors block">Total Campaigns</span>
                <span class="text-xl font-bold text-[var(--text-primary)] leading-tight block">@ViewBag.TotalCampaigns</span>
                <span class="text-[11px] text-[var(--text-tertiary)]">Executed Broadcasts</span>
            </div>
            <i class="icon-chevron-right text-[12px] text-[var(--text-tertiary)] ms-auto opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"></i>
        </a>

        <a href="#outbox-deliveries" class="surface-card p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] flex items-center gap-3.5 hover:border-emerald-500/50 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none group cursor-pointer">
            <div class="size-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                <i class="icon-check-circle text-[20px]"></i>
            </div>
            <div>
                <span class="text-[11.5px] font-medium text-[var(--text-tertiary)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors block">Delivered Emails</span>
                <span class="text-xl font-bold text-[var(--text-primary)] leading-tight block">@ViewBag.TotalDelivered</span>
                <span class="text-[11px] text-emerald-600 dark:text-emerald-400">100% Outbox Logged</span>
            </div>
            <i class="icon-chevron-right text-[12px] text-[var(--text-tertiary)] ms-auto opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"></i>
        </a>
    </div>

    <!-- Quick Action Launchpad -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a asp-action="Import" class="surface-card p-5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-3 hover:border-[var(--color-primary-500)]/60 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none block group cursor-pointer">
            <div class="flex items-center gap-3">
                <div class="size-9 rounded-lg bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="icon-file-spreadsheet text-[18px]"></i>
                </div>
                <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">Import Leads &amp; Contacts</h3>
            </div>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">Upload spreadsheets (.xlsx, .csv) or paste email dumps directly from word documents.</p>
            <span class="btn btn-outline border-secondary text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1 group-hover:bg-[var(--color-primary-600)] group-hover:text-white group-hover:border-[var(--color-primary-600)] transition-all">
                <span>Go to Import Hub</span>
                <i class="icon-arrow-right text-[12px]"></i>
            </span>
        </a>

        <a asp-action="Templates" class="surface-card p-5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-3 hover:border-amber-500/60 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none block group cursor-pointer">
            <div class="flex items-center gap-3">
                <div class="size-9 rounded-lg bg-amber-500/10 text-amber-600 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="icon-layout text-[18px]"></i>
                </div>
                <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-amber-600 transition-colors">Template Gallery</h3>
            </div>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">Customize high-converting email templates with dynamic tags like <code>{{FullName}}</code>.</p>
            <span class="btn btn-outline border-secondary text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1 group-hover:bg-amber-600 group-hover:text-white group-hover:border-amber-600 transition-all">
                <span>Manage Templates</span>
                <i class="icon-arrow-right text-[12px]"></i>
            </span>
        </a>

        <a asp-action="Contacts" class="surface-card p-5 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm space-y-3 hover:border-emerald-500/60 hover:shadow-md hover:-translate-y-0.5 transition-all text-decoration-none block group cursor-pointer">
            <div class="flex items-center gap-3">
                <div class="size-9 rounded-lg bg-emerald-500/10 text-emerald-600 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="icon-book-open text-[18px]"></i>
                </div>
                <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-emerald-600 transition-colors">Audience Directory</h3>
            </div>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">Filter, segment, search, and export school contacts across states, roles, and tags.</p>
            <span class="btn btn-outline border-secondary text-xs font-semibold px-3 py-1.5 rounded-lg inline-flex items-center gap-1 group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all">
                <span>View Contacts</span>
                <i class="icon-arrow-right text-[12px]"></i>
            </span>
        </a>
    </div>

    <!-- Active Broadcast Campaigns & Outbox Feed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Recent Campaigns -->
        <div class="lg:col-span-7 space-y-6" id="recent-campaigns">
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                    <h3 class="text-sm font-bold text-[var(--text-primary)] flex items-center gap-2">
                        <i class="icon-send text-[16px] text-[var(--color-primary-600)]"></i>
                        <span>Recent Broadcast Campaigns</span>
                    </h3>
                    <a asp-action="CreateCampaign" class="btn btn-primary text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1 text-decoration-none">
                        <i class="icon-plus text-[12px]"></i> Launch Campaign
                    </a>
                </div>
                <div>
                    @if (recentCampaigns.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="table table-hover align-middle mb-0 w-full text-xs">
                                <thead>
                                    <tr class="border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-tertiary)] uppercase font-semibold text-[11px] tracking-wider">
                                        <th class="px-4 py-3 text-start">Campaign Title</th>
                                        <th class="px-4 py-3 text-start">Target Tag</th>
                                        <th class="px-4 py-3 text-start">Recipients</th>
                                        <th class="px-4 py-3 text-start">Status</th>
                                        <th class="px-4 py-3 text-start">Date</th>
                                        <th class="px-4 py-3 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[var(--border-subtle)]">
                                    @foreach (var c in recentCampaigns)
                                    {
                                        <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors">
                                            <td class="px-4 py-3">
                                                <div class="font-bold text-[var(--text-primary)]">@c.Title</div>
                                                <span class="text-[11px] text-[var(--text-tertiary)] max-w-xs truncate block">@c.Subject</span>
                                            </td>
                                            <td class="px-4 py-3">
                                                <span class="inline-block px-2 py-0.5 rounded text-[10.5px] bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">@c.TargetTag</span>
                                            </td>
                                            <td class="px-4 py-3 font-semibold text-emerald-600 dark:text-emerald-400">
                                                @c.DeliveredCount / @c.TotalRecipients
                                            </td>
                                            <td class="px-4 py-3">
                                                @if (c.Status == "Completed")
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Completed</span>
                                                }
                                                else if (c.Status == "Executing")
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">Executing</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-semibold bg-gray-500/10 text-gray-600 border border-gray-500/20">@c.Status</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-[var(--text-tertiary)]">
                                                @c.CreatedAtUtc.ToString("MMM d, yyyy")
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                <a asp-action="CampaignDetails" asp-route-id="@c.Id" class="btn btn-outline border-secondary text-xs px-2.5 py-1 rounded-lg text-decoration-none">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-10 space-y-2">
                            <i class="icon-send text-[28px] text-[var(--text-tertiary)]"></i>
                            <h4 class="text-sm font-bold text-[var(--text-primary)]">No campaigns dispatched yet</h4>
                            <p class="text-xs text-[var(--text-secondary)]">Launch your first marketing campaign to engage schools.</p>
                            <a asp-action="CreateCampaign" class="btn btn-primary text-xs font-semibold px-3 py-1.5 rounded-lg inline-block text-decoration-none mt-2">Create Campaign</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Audience Breakdown & Outbox Feed -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Audience Segment Distribution -->
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm p-5 space-y-4">
                <div class="border-b border-[var(--border-subtle)] pb-3 flex items-center justify-between">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">Audience Segments &amp; Tags</h4>
                    <a asp-action="Contacts" class="text-xs text-[var(--color-primary-600)] hover:underline text-decoration-none">Manage Tags</a>
                </div>
                <div>
                    @if (tagStats.Any())
                    {
                        <div class="space-y-3">
                            @foreach (var stat in tagStats)
                            {
                                <div>
                                    <div class="flex justify-between items-center mb-1 text-xs">
                                        <span class="font-medium text-[var(--text-primary)]">@stat.Tag</span>
                                        <span class="text-[11px] font-semibold text-[var(--color-primary-600)]">@stat.Count contacts</span>
                                    </div>
                                    <div class="w-full bg-[var(--surface-sunken)] rounded-full h-1.5 overflow-hidden">
                                        @{
                                            int total = (int)ViewBag.TotalContacts;
                                            int pct = total > 0 ? (int)((stat.Count / (double)total) * 100) : 0;
                                        }
                                        <div class="bg-[var(--color-primary-600)] h-1.5 rounded-full" style="width: @(pct)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-[var(--text-tertiary)] text-center py-3">No contacts imported yet.</p>
                    }
                </div>
            </div>

            <!-- Recent Outbox Dumps -->
            <div class="surface-card rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden" id="outbox-deliveries">
                <div class="px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-1.5">
                        <i class="icon-inbox text-[14px] text-emerald-600"></i>
                        <span>Recent Outbox Deliveries</span>
                    </h4>
                    <a asp-controller="EmailLogs" asp-action="Index" class="text-xs text-[var(--color-primary-600)] hover:underline text-decoration-none">View Full Outbox &rarr;</a>
                </div>
                <div class="divide-y divide-[var(--border-subtle)] text-xs">
                    @if (recentBroadcastEmails.Any())
                    {
                        @foreach (var mail in recentBroadcastEmails)
                        {
                            <div class="p-3.5 flex justify-between items-center gap-2">
                                <div class="truncate max-w-[240px]">
                                    <div class="font-semibold text-[var(--text-primary)] truncate">@mail.Subject</div>
                                    <div class="text-[11px] text-[var(--text-tertiary)] truncate">&rarr; @mail.RecipientEmail</div>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">Delivered</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-5 text-center text-[var(--text-tertiary)]">
                            No marketing emails logged in outbox yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
