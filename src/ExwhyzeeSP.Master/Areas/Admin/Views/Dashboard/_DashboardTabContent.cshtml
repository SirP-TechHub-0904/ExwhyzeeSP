                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No assessment activity logged.</div>
                }
                else
                {
                    int rank = 1;
                    @foreach (var s in Model.TopAssessmentSchools)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="size-5 rounded-full bg-[var(--surface-sunken)] border text-[10.5px] font-bold text-purple-600 grid place-items-center shrink-0">
                                    @rank
                                </span>
                                <div class="min-w-0">
                                    <span class="text-xs font-semibold text-[var(--text-primary)] truncate block">@s.SchoolName</span>
                                    <span class="text-[11px] text-[var(--text-tertiary)] block">@s.CbtExams exams &bull; @s.PinsVerified PIN checks</span>
                                </div>
                            </div>
                            <span class="badge-soft badge-purple text-[11px] font-bold shrink-0">Active</span>
                        </div>
                        rank++;
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Assessment Data</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "marketing")
    {
        <!-- Marketing Card 1: Recent Broadcast Campaigns -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 grid place-items-center text-xs font-bold">1</span>
                        Recent Broadcasts
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Outreach campaigns dispatched.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentCampaigns.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No broadcast campaigns sent yet.</div>
                }
                else
                {
                    @foreach (var c in Model.RecentCampaigns)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <a asp-area="Admin" asp-controller="Marketing" asp-action="CampaignDetails" asp-route-id="@c.Id" class="text-xs font-semibold text-[var(--text-primary)] hover:text-amber-600 truncate block text-decoration-none">
                                    @c.Title
                                </a>
                                <span class="text-[11px] text-[var(--text-tertiary)] block">@c.TotalRecipients recipients &bull; @c.CreatedAtUtc.ToString("MMM dd")</span>
                            </div>
                            <span class="badge-soft badge-warning text-[10px] shrink-0">@c.Status</span>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Marketing" asp-action="Index" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Campaigns</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- Marketing Card 2: Recent CRM Contacts -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 grid place-items-center text-xs font-bold">2</span>
                        Recent School Leads
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Audience members added to CRM.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentContacts.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No contacts in CRM.</div>
                }
                else
                {
                    @foreach (var lead in Model.RecentContacts)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <div class="min-w-0">
                                <span class="text-xs font-semibold text-[var(--text-primary)] truncate block">@lead.SchoolName</span>
                                <span class="text-[11px] text-[var(--text-tertiary)] block">@lead.FullName &bull; @lead.PhoneNumber</span>
                            </div>
                            <span class="badge-soft badge-primary text-[10px] shrink-0">@(lead.Tag ?? "Lead")</span>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Marketing" asp-action="Contacts" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>View More Contacts (@Model.TotalContacts)</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>

        <!-- Marketing Card 3: Contact Categories Distribution -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center text-xs font-bold">3</span>
                        Lead Categories
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Audience classification.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.ContactCategories.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No categories tagged yet.</div>
                }
                else
                {
                    @foreach (var cat in Model.ContactCategories)
                    {
                        <div class="py-2.5 first:pt-1 last:pb-1 flex items-center justify-between gap-2.5 hover:bg-[var(--surface-sunken)] px-2 rounded-lg transition-colors">
                            <span class="text-xs font-semibold text-[var(--text-primary)] truncate">@cat.CategoryName</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-[var(--text-primary)]">@cat.Count</span>
                                <span class="text-[11px] text-[var(--text-tertiary)]">(@cat.Percentage%)</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="p-3 bg-[var(--surface-sunken)] border-t border-[var(--border-subtle)] text-center">
                <a asp-area="Admin" asp-controller="Marketing" asp-action="Import" class="btn btn-outline w-full text-xs font-semibold py-1.5 rounded-lg flex items-center justify-center gap-1 text-decoration-none">
                    <span>Import More Leads (CSV / Excel)</span>
                    <i class="icon-arrow-right text-[11px]"></i>
                </a>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "content")
    {
        <!-- Content Card 1: Knowledge Guides -->
        <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm flex flex-col overflow-hidden">
            <div class="p-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                    <h4 class="font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
                        <span class="size-6 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 grid place-items-center text-xs font-bold">1</span>
                        Top Knowledge Guides
                    </h4>
                    <p class="text-[11.5px] text-[var(--text-tertiary)] mt-0.5">Most viewed user guide articles.</p>
                </div>
            </div>

            <div class="p-3 divide-y divide-[var(--border-subtle)] flex-1 overflow-y-auto max-h-[380px]">
                @if (!Model.RecentKb.Any())
                {
                    <div class="py-8 text-center text-xs text-[var(--text-tertiary)]">No guides created yet.</div>
                }
                else
                {
                    @foreach (var kb in Model.RecentKb)
