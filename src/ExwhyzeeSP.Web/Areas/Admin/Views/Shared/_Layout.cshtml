    <script type="text/javascript">
        $(window).on('load', function () {
            try {
                var modal = $('#abcdef');
                if (modal.length > 0) {
                    var msgText = modal.find('.modal-body').text().trim();
                    var storageKey = 'portal_notice_modal_timestamp';
                    var storageMsgKey = 'portal_notice_modal_msg';
                    var lastShown = localStorage.getItem(storageKey);
                    var lastMsg = localStorage.getItem(storageMsgKey);
                    var twentyFourHours = 24 * 60 * 60 * 1000; // 24 hours in milliseconds
                    var now = new Date().getTime();

                    // Show if new message content OR 24 hours have elapsed
                    if (!lastShown || lastMsg !== msgText || (now - parseInt(lastShown, 10)) > twentyFourHours) {
                        modal.modal('show');
                        localStorage.setItem(storageKey, now.toString());
                        localStorage.setItem(storageMsgKey, msgText);
                    }
                }
            } catch (e) {
                $('#abcdef').modal('show');
            }
        });
    </script>

    <!-- Global DataTables & Smart Table Dropdown Handler -->
    <script type="text/javascript">
        $(function () {
            try {
                // Support both Bootstrap 3 and Bootstrap 5 data-bs-toggle attributes for tabs
                $('a[data-bs-toggle="tab"], button[data-bs-toggle="tab"]').on('click', function (e) {
                    e.preventDefault();
                    $(this).tab('show');
                });

                // Auto-initialize DataTables on all tables with class .table that have proper thead & tbody
                $('table.table').each(function () {
                    var $table = $(this);
                    if ($table.data('skip-datatable') || $table.find('thead th').length === 0 || $table.find('tbody tr').length === 0) {
                        return;
                    }
                    if (!$.fn.DataTable.isDataTable(this)) {
                        try {
                            $table.DataTable({
                                "paging": true,
                                "lengthChange": true,
                                "searching": true,
                                "ordering": true,
                                "info": true,
                                "autoWidth": false,
                                "responsive": true,
                                "pageLength": 10,
                                "order": [], // Preserves initial server-side order
                                "columnDefs": [
                                    { "orderable": false, "targets": "no-sort" },
                                    { "orderable": false, "targets": -1 } // Disable sorting on Action column
                                ],
                                "language": {
                                    "search": "_INPUT_",
                                    "searchPlaceholder": "Search records...",
                                    "lengthMenu": "Show _MENU_ entries"
                                }
                            });
                        } catch (err) {
                            console.warn("DataTable init notice:", err);
                        }
                    }
                });

                // Prevent Action Dropdowns from getting cut off at the bottom or sides of responsive tables
                $(document).on('show.bs.dropdown', '.table-responsive .btn-group, .table-responsive .dropdown, table .btn-group, table .dropdown', function () {
                    var $btnGroup = $(this);
                    var $tr = $btnGroup.closest('tr');
                    var $tbody = $tr.closest('tbody');
                    var totalRows = $tbody.length ? $tbody.find('tr').length : 0;
                    var rowIndex = $tr.index();

                    // Temporarily allow overflow on table container so dropdown floats visibly
                    $btnGroup.closest('.table-responsive').css('overflow', 'inherit');
                    $btnGroup.closest('.box-body').css('overflow', 'inherit');

                    // Determine whether to flip upwards (dropup)
                    var offset = $btnGroup.offset();
                    var btnHeight = $btnGroup.outerHeight();
                    var windowBottom = $(window).scrollTop() + $(window).height();
                    var spaceBelow = windowBottom - (offset.top + btnHeight);

                    // If in the bottom 2 rows of a multi-row table OR if space below is limited (< 180px)
                    if ((totalRows >= 2 && rowIndex >= totalRows - 2) || spaceBelow < 180) {
                        $btnGroup.addClass('dropup');
                    } else {
                        $btnGroup.removeClass('dropup');
                    }
                });

                $(document).on('hidden.bs.dropdown', '.table-responsive .btn-group, .table-responsive .dropdown, table .btn-group, table .dropdown', function () {
                    var $btnGroup = $(this);
                    $btnGroup.removeClass('dropup');
                    $btnGroup.closest('.table-responsive').css('overflow', 'auto');
                    $btnGroup.closest('.box-body').css('overflow', '');
                });

                // Auto-initialize Summernote with all rich-text and raw HTML codeview features
                if ($.fn.summernote) {
                    var summernoteSelector = '.summernote, textarea.summernote, .editor, textarea.editor, textarea[name*="MoreDescription"], textarea[name*="FullDescription"], textarea[name*="Content"], textarea[name*="Body"]';
                    $(summernoteSelector).each(function () {
                        var $editor = $(this);
                        if (!$editor.next().hasClass('note-editor') && !$editor.hasClass('no-summernote')) {
                            try {
                                $editor.summernote({
                                    height: 250,
                                    minHeight: 140,
                                    maxHeight: 600,
                                    tabsize: 2,
                                    toolbar: [
                                        ['style', ['style']],
                                        ['font', ['bold', 'italic', 'underline', 'strikethrough', 'superscript', 'subscript', 'clear']],
                                        ['fontname', ['fontname']],
                                        ['fontsize', ['fontsize']],
                                        ['color', ['color']],
                                        ['para', ['ul', 'ol', 'paragraph', 'height']],
                                        ['table', ['table']],
                                        ['insert', ['link', 'picture', 'video', 'hr']],
                                        ['view', ['fullscreen', 'codeview', 'help']] // codeview enables full HTML source mode
                                    ]
                                });
                            } catch (e) {
                                console.warn("Summernote init error on", this, e);
                            }
                        }
                    });

                    // Ensure Summernote code syncs to textarea before form submission
                    $('form').on('submit', function () {
                        $('textarea').each(function () {
                            if ($(this).data('summernote')) {
                                $(this).val($(this).summernote('code'));
                            }
                        });
                    });
                }
            } catch (globalErr) {
                console.error("Global init error:", globalErr);
            }
        });
    </script>
