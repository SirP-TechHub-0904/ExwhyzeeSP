# ==============================================================================
# ExwhyzeeSP Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTIONS
# ------------------------------------------------------------------------------
# Default Local Database (Used on localhost development)
DEFAULT_DB_CONNECTION="Server=(localdb)\\mssqllocaldb;Database=ExwhyzeeSP_LocalDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# Master Database (Stores school tenants, domains, and connection string mappings)
MASTER_DB_CONNECTION="Server=(localdb)\\mssqllocaldb;Database=ExwhyzeeSP_MasterDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# ------------------------------------------------------------------------------
# 2. MASTER PORTAL SUPERADMIN CREDENTIALS
# ------------------------------------------------------------------------------
MASTER_ADMIN_EMAIL="superadmin@exwhyzeesp.com"
MASTER_ADMIN_DEFAULT_PASSWORD="SuperSecretAdminPass123!"

# ------------------------------------------------------------------------------
# 3. PLATFORM & SECURITY SETTINGS
# ------------------------------------------------------------------------------
PLATFORM_NAME="Exwhyzee School Portal Platform"
PLATFORM_ROOT_DOMAIN="exwhyzeesp.com"
APP_SECRET_KEY="ExwhyzeeSP_SecureAppSecretKey_2026_ChangeInProduction!"

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY INTEGRATIONS (SMS, Mail, Payment Gateways)
# ------------------------------------------------------------------------------
SMS_API_KEY=""
SMS_SENDER_ID="EXWHYZEE"

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
