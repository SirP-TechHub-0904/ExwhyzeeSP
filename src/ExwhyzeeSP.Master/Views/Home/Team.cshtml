@{
    ViewData["Title"] = "Our Team & EdTech Leaders";
    ViewData["MetaDescription"] = "Meet the educational technologists, software architects, and institutional consultants behind Exwhyzee SP.";
    Layout = "_PublicLayout";
}

<!-- Page Banner -->
<section class="page-banner" style="background: linear-gradient(rgba(10, 24, 50, 0.88), rgba(10, 24, 50, 0.96)), url('/assets/images/page-banner.png') center/cover no-repeat; padding: 100px 0 60px;">
    <div class="container text-center text-white">
        <h1 class="display-4 fw-bold mb-3">Our Team &amp; EdTech Leaders</h1>
        <p class="lead text-light mb-4" style="max-width: 750px; margin: 0 auto;">
            Passionate educators, software engineers, and cloud architects dedicated to revolutionizing school management across Africa.
        </p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent p-0 m-0">
                <li class="breadcrumb-item"><a href="/" class="text-info text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active text-light" aria-current="page">Team</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Team Members Section -->
<section class="py-5" style="background-color: #f8fafc;">
    <div class="container py-4">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">The Brains Behind the Platform</span>
            <h2 class="display-6 fw-bold">Dedicated to Institutional Excellence</h2>
            <p class="text-muted mx-auto" style="max-width: 650px;">
                Our multidisciplinary team combines deep experience in Nigerian basic &amp; tertiary education with world-class cloud engineering.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Member 1 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white text-center p-4">
                    <div class="mx-auto mb-3 rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px; font-size: 2.2rem; font-weight: bold;">
                        ET
                    </div>
                    <h5 class="fw-bold mb-1">Engr. Justin N.</h5>
                    <span class="text-primary small fw-semibold d-block mb-3">Chief Executive &amp; Lead Systems Architect</span>
                    <p class="text-muted small">Over 15 years driving mission-critical software engineering, school systems, and enterprise educational technology deployments.</p>
                </div>
            </div>

            <!-- Member 2 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white text-center p-4">
                    <div class="mx-auto mb-3 rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px; font-size: 2.2rem; font-weight: bold;">
                        CO
                    </div>
                    <h5 class="fw-bold mb-1">Chidinma O.</h5>
                    <span class="text-success small fw-semibold d-block mb-3">Head of Product &amp; Curriculum Integration</span>
                    <p class="text-muted small">Specializes in automated continuous assessment algorithms, WAEC/NECO grading alignment, and teacher usability workflows.</p>
                </div>
            </div>

            <!-- Member 3 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white text-center p-4">
                    <div class="mx-auto mb-3 rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px; font-size: 2.2rem; font-weight: bold;">
                        AA
                    </div>
                    <h5 class="fw-bold mb-1">Abubakar A.</h5>
                    <span class="text-warning-emphasis small fw-semibold d-block mb-3">Director of School Onboarding &amp; Support</span>
                    <p class="text-muted small">Oversees rapid institutional onboarding, legacy student data migration, and 24/7 technical help desk operations.</p>
                </div>
            </div>
        </div>

        <!-- CTA Box -->
        <div class="mt-5 p-5 rounded-4 text-white text-center shadow-lg" style="background: linear-gradient(135deg, #0d3b66, #001f3f);">
            <h3 class="fw-bold mb-2">Want to Partner or Join Our Mission?</h3>
            <p class="text-light mb-4 mx-auto" style="max-width: 600px;">
                We are constantly expanding our consultant network and academic deployment partnerships nationwide.
            </p>
            <a href="/Contact" class="btn btn-warning rounded-pill fw-bold px-4 py-2 text-dark shadow-sm">
                Get in Touch with Us
            </a>
        </div>
    </div>
</section>
