@model IEnumerable<ExwhyzeeSP.Core.Models.MasterKnowledgeBaseItem>
@{
    ViewData["Title"] = "Knowledge Base & Page Guides";
    Layout = "_AdminLayout";
    var selectedRole = ViewBag.SelectedRole as string;
    var search = ViewBag.Search as string;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);

    var startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Knowledge Base &amp; Operating Guides</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                    @totalItems Guides
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)]">
                Hierarchical documentation and user guides mapped to portal routes for administrators, staff, and students.
            </p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0 ms-auto">
            <a asp-action="Create" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none bg-sky-600 hover:bg-sky-700 text-white">
                <i class="icon-plus text-[14px]"></i>
                <span>Add New Guide</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3 shadow-sm">
            <i class="icon-check-circle text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="surface-card rounded-xl border border-slate-200/80 dark:border-slate-800 p-4 shadow-sm">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            <div class="lg:col-span-6 relative">
                <span class="absolute start-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none flex items-center">
                    <i class="icon-search text-[14px]"></i>
                </span>
                <input type="text" name="search" value="@search" style="padding-left: 2.25rem !important;" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 pr-3.5 py-2 text-xs text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition" placeholder="Search page, controller, route, title..." />
            </div>
            <div class="lg:col-span-4">
                <select name="role" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition" onchange="this.form.submit()">
                    <option value="">All Roles (Admin, Staff, Student)</option>
                    <option value="Admin" selected="@(selectedRole == "Admin")">Administrator (Admin)</option>
                    <option value="Staff" selected="@(selectedRole == "Staff")">Staff &amp; Teachers (Staff)</option>
                    <option value="Student" selected="@(selectedRole == "Student")">Students &amp; Parents (Student)</option>
                </select>
            </div>
            <div class="lg:col-span-2 flex items-center gap-2">
                <button type="submit" class="btn btn-primary text-xs font-semibold py-2 px-4 rounded-lg shadow-sm flex-1 bg-sky-600 hover:bg-sky-700 text-white">Filter</button>
                @if (!string.IsNullOrEmpty(selectedRole) || !string.IsNullOrEmpty(search))
                {
                    <a href="/KnowledgeBaseAdmin" class="btn btn-outline border-secondary text-xs font-semibold py-2 px-3 rounded-lg text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Guides Table Card -->
    <div class="surface-card rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[var(--text-primary)]">
                <thead class="bg-slate-100/75 dark:bg-slate-800/60 text-[11px] font-bold uppercase tracking-wider text-[var(--text-secondary)] border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th scope="col" class="py-3 px-4 w-16 text-center">Order</th>
                        <th scope="col" class="py-3 px-4 w-36">Role &amp; Area</th>
                        <th scope="col" class="py-3 px-4 w-48">Route &amp; Controller</th>
                        <th scope="col" class="py-3 px-4 min-w-[280px]">Guide Title &amp; Summary</th>
                        <th scope="col" class="py-3 px-4 w-40">Badge</th>
                        <th scope="col" class="py-3 px-4 w-28 text-center">Status</th>
                        <th scope="col" class="py-3 px-4 w-32 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Order -->
                                <td class="py-3.5 px-4 text-center font-mono font-bold text-slate-500 dark:text-slate-400">
                                    <span class="inline-block px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[11px]">
                                        #@item.SortOrder
                                    </span>
                                </td>

                                <!-- Role & Area -->
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold @(item.TargetRole == "Admin" ? "bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60" : item.TargetRole == "Staff" ? "bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/60" : "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60")">
                                        <span class="w-1.5 h-1.5 rounded-full @(item.TargetRole == "Admin" ? "bg-sky-500" : item.TargetRole == "Staff" ? "bg-indigo-500" : "bg-emerald-500")"></span>
                                        @item.TargetRole
                                    </span>
                                    <span class="text-[11px] text-[var(--text-secondary)] block mt-1">Area: <strong class="text-[var(--text-primary)]">@item.Area</strong></span>
                                </td>

                                <!-- Route & Controller -->
                                <td class="py-3.5 px-4">
                                    <span class="font-semibold text-[var(--text-primary)] block">@item.ControllerName</span>
                                    <code class="font-mono text-[11px] text-sky-600 dark:text-sky-400 bg-slate-50 dark:bg-slate-900 px-1.5 py-0.5 rounded border border-slate-200/60 dark:border-slate-800 inline-block mt-0.5">@item.RouteUrl</code>
                                </td>

                                <!-- Guide Title & Summary -->
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-sm text-[var(--text-primary)] block">@item.Title</span>
                                    <p class="text-[11.5px] text-[var(--text-secondary)] mt-0.5 line-clamp-2 leading-relaxed">@item.WhatItDoes</p>
                                </td>

                                <!-- Badge -->
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrEmpty(item.BadgeText))
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            @item.BadgeText
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-xs">-</span>
                                    }
                                </td>

                                <!-- Status Toggle -->
                                <td class="py-3.5 px-4 text-center">
                                    <form asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold border cursor-pointer transition-colors @(item.IsPublished ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800/60 hover:bg-emerald-100" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700 hover:bg-slate-200")" title="Click to toggle status">
                                            <i class="@(item.IsPublished ? "icon-check-circle" : "icon-eye-off") text-[11px]"></i>
                                            @(item.IsPublished ? "Published" : "Hidden")
                                        </button>
                                    </form>
                                </td>

                                <!-- Actions -->
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold text-decoration-none transition-colors" title="Edit Guide">
                                            <i class="icon-edit-3 text-[13px] text-sky-500"></i>
                                            <span>Edit</span>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this guide?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center w-7 h-7 rounded-lg border border-rose-200 dark:border-rose-900/40 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Guide">
                                                <i class="icon-trash-2 text-[13px]"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-[var(--text-secondary)]">
                                <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 grid place-items-center mx-auto mb-3 text-slate-400">
                                    <i class="icon-book-open text-[24px]"></i>
                                </div>
                                <p class="text-sm font-semibold text-[var(--text-primary)]">No Knowledge Base Guides Found</p>
                                <p class="text-xs text-[var(--text-secondary)] mt-1">Click "Add New Guide" to document your first portal module or clear active search filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (totalPages > 1 || totalItems > 0)
        {
            <div class="p-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/50 dark:bg-slate-900/50">
                <div class="text-xs text-[var(--text-secondary)]">
                    Showing <strong class="text-[var(--text-primary)] font-semibold">@startItem</strong> to <strong class="text-[var(--text-primary)] font-semibold">@endItem</strong> of <strong class="text-[var(--text-primary)] font-semibold">@totalItems</strong> guides
                </div>

                @if (totalPages > 1)
                {
                    <div class="flex items-center gap-1.5">
                        <!-- First Page -->
                        <a asp-action="Index" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-role="@selectedRole" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="First Page">
                            <i class="icon-chevrons-left text-[14px]"></i>
                        </a>

                        <!-- Previous Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-role="@selectedRole" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="Previous Page">
                            <i class="icon-chevron-left text-[14px]"></i>
                        </a>

                        <!-- Page Number Range -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a asp-action="Index" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-role="@selectedRole" asp-route-search="@search" class="grid place-items-center min-w-8 h-8 px-2 rounded-lg text-xs font-semibold text-decoration-none transition-colors @(p == currentPage ? "bg-sky-600 text-white shadow-sm" : "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700")">
                                @p
                            </a>
                        }

                        <!-- Next Page -->
                        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-role="@selectedRole" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Next Page">
                            <i class="icon-chevron-right text-[14px]"></i>
                        </a>

                        <!-- Last Page -->
                        <a asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="@pageSize" asp-route-role="@selectedRole" asp-route-search="@search" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Last Page">
                            <i class="icon-chevrons-right text-[14px]"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>
