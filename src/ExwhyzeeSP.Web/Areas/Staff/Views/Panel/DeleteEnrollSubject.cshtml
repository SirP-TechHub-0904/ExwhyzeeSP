@{
    ViewBag.Title = "Confirm Mass Removal - Enrolled Students in Subject";
    var subject = ViewBag.Subject as ExwhyzeeSP.Core.Entities.Subject;
    var session = ViewBag.Session as ExwhyzeeSP.Core.Entities.Session;
    var classLevel = ViewBag.ClassLevel as ExwhyzeeSP.Core.Entities.ClassLevel;
    int enrolledCount = ViewBag.EnrolledCount ?? 0;
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> Critical Action: Mass Remove Students From Subject</h3>
            </div>
            <div class="box-body">
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                        @TempData["error"]
                    </div>
                }

                <div class="callout callout-danger">
                    <h4><i class="fa fa-warning"></i> Warning: Irreversible Data Loss</h4>
                    <p>
                        You are about to <strong>mass un-enroll all students</strong> and <strong>permanently delete all entered assessment and exam scores</strong> for this subject.
                    </p>
                </div>

                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <th style="width: 35%;">Subject:</th>
                            <td><strong class="text-primary">@(subject?.SubjectName)</strong></td>
                        </tr>
                        <tr>
                            <th>Class Level:</th>
                            <td>@(classLevel?.ClassName ?? "All Classes for Subject")</td>
                        </tr>
                        <tr>
                            <th>Academic Session:</th>
                            <td>@(session?.SessionYear) - @(session?.Term)</td>
                        </tr>
                        <tr>
                            <th>Affected Students:</th>
                            <td><span class="badge bg-red" style="font-size: 14px;">@enrolledCount Student(s) will be removed</span></td>
                        </tr>
                    </tbody>
                </table>

                @using (Html.BeginForm("DeleteEnrollSubject", "Panel", new { area = "Staff", id = ViewBag.SubjectId, sessionId = ViewBag.SessionId, classId = ViewBag.ClassId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-top: 20px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve this mass deletion, type <strong style="letter-spacing: 1px; text-decoration: underline;">CONFIRM</strong> below:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>

                    <div class="box-footer" style="padding: 15px 0 0 0; background: transparent;">
                        <button type="submit" id="btnSubmitDelete" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                            <i class="fa fa-trash"></i> Approve & Delete All Subject Scores
                        </button>
                        <a href="@Url.Action("StudentsList", "Panel", new { area = "Staff", subId = ViewBag.SubjectId, sessionId = ViewBag.SessionId })" class="btn btn-default btn-lg btn-flat pull-right">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitDelete');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
