@{
    ViewBag.Title = "Remove Enrolled Subject By Class";
    int n = 0;
}

<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <div class="box box-danger box-solid">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exclamation-triangle"></i> Mass Remove Enrolled Subjects in Class</h3>
            </div>

            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible" style="margin: 15px;">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                    <h4><i class="icon fa fa-ban"></i> Alert!</h4>
                    @TempData["error"]
                </div>
            }
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible" style="margin: 15px;">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                    <h4><i class="icon fa fa-check"></i> Success!</h4>
                    @TempData["success"]
                </div>
            }

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="box-body">
                    <div class="callout callout-danger">
                        <h4><i class="fa fa-warning"></i> Warning: Permanent Assessment Deletion</h4>
                        <p>
                            Selecting a class and subject below will <strong>mass-delete this subject enrollment for all students in that class</strong>, including all entered test scores and exam grades for this term.
                        </p>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <label>Select Target Class <span class="text-danger">*</span></label>
                        @Html.DropDownList("ClassLevelId", ViewBag.ClassLevelId as List<SelectListItem>, "Select a class", new { id = "classesId", @class = "form-control input-lg", required = "required" })
                    </div>

                    <div class="form-group">
                        <label>Select Subject To Remove <span class="text-danger">*</span></label>
                        <select id="Subject" name="SubjectId" class="form-control input-lg" required="required">
                            <option value="">-- Select Class First --</option>
                        </select>
                    </div>

                    <div class="form-group" style="margin-top: 25px;">
                        <label for="confirmCode" class="text-danger" style="font-size: 15px;">
                            To approve this mass removal, type <strong style="text-decoration: underline; letter-spacing: 1px;">CONFIRM</strong>:
                        </label>
                        <input type="text" id="confirmCode" name="confirmCode" class="form-control input-lg" placeholder="Type CONFIRM here" autocomplete="off" required style="border: 2px solid #dd4b39; font-weight: bold; text-transform: uppercase;" />
                    </div>
                </div>

                <div class="box-footer" style="padding: 15px; background: #f9f9f9;">
                    <button type="submit" id="btnSubmitRemove" class="btn btn-danger btn-lg btn-flat" disabled="disabled">
                        <i class="fa fa-trash"></i> Approve & Remove Enrolled Subject
                    </button>
                    <a href="javascript: history.back()" class="btn btn-default btn-lg btn-flat pull-right">
                        <i class="fa fa-times"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
    <div class="col-md-3"></div>
</div>

@section Scripts {
    <script src="~/admin/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/admin/bower_components/datatables.net-bs/js/dataTables.bootstrap.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/jquery-ui.min.js"></script>
    
    <script type="text/javascript">
        $(function () {
            $('#classesId').change(function () {
                var classId = $('#classesId').val();
                if (!classId) {
                    $('#Subject').html('<option value="">-- Select Class First --</option>');
                    return;
                }
                $.getJSON('/EventsControl/SubjectByClass/' + classId, function (data) {
                    var items = '<option value="">-- Select a Subject --</option>';
                    $.each(data, function (i, local) {
                        items += "<option value='" + local.Value + "'>" + local.Text + "</option>";
                    });
                    $('#Subject').html(items);
                });
            });

            var $input = $('#confirmCode');
            var $btn = $('#btnSubmitRemove');

            $input.on('input keyup paste', function () {
                var val = $(this).val().trim().toUpperCase();
                if (val === 'CONFIRM') {
                    $btn.removeAttr('disabled').removeClass('disabled');
                } else {
                    $btn.attr('disabled', 'disabled').addClass('disabled');
                }
            });
        });
    </script>
}
