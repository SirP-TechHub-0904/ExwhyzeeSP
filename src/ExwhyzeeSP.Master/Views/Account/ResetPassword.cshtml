@model ExwhyzeeSP.Master.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card">
    <h4 class="fw-bold text-white mb-1">Set New Password</h4>
    <p class="text-secondary small mb-4">OTP successfully verified for <span class="text-info">@Model.Email</span>. Choose a strong new password.</p>

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="ResetToken" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 bg-danger-subtle text-danger"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label text-light small fw-semibold">New Password</label>
            <div class="position-relative">
                <input asp-for="NewPassword" type="password" id="newPwd" class="form-control form-control-custom pe-5" placeholder="••••••••••••" autofocus required />
                <button type="button" class="input-icon-btn" onclick="togglePwd('newPwd', 'eye1')">
                    <i class="bi bi-eye" id="eye1"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label text-light small fw-semibold">Confirm New Password</label>
            <div class="position-relative">
                <input asp-for="ConfirmPassword" type="password" id="confirmPwd" class="form-control form-control-custom pe-5" placeholder="••••••••••••" required />
                <button type="button" class="input-icon-btn" onclick="togglePwd('confirmPwd', 'eye2')">
                    <i class="bi bi-eye" id="eye2"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-submit-glow d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-check2-circle"></i>
                <span>Update Password &amp; Sign In</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(inputId, iconId) {
            const el = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (el.type === 'password') {
                el.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                el.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
