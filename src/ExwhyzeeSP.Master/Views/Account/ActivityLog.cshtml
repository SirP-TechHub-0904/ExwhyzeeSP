@model IEnumerable<ExwhyzeeSP.Core.Models.MasterAuditLog>
@{
    ViewData["Title"] = "Security Activity Log & Audit History";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var search = ViewBag.Search as string;
    var actionType = ViewBag.ActionType as string;
    var severity = ViewBag.Severity as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;

    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 15);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);

    var totalAllLogs = (int)(ViewBag.TotalAllLogs ?? 0);
    var totalLogins = (int)(ViewBag.TotalLogins ?? 0);
    var totalSso = (int)(ViewBag.TotalSso ?? 0);
    var totalWarnings = (int)(ViewBag.TotalWarnings ?? 0);
    var uniqueIps = (int)(ViewBag.UniqueIps ?? 0);

    var trendDates = ViewBag.TrendDates as List<string> ?? new List<string>();
    var trendLogins = ViewBag.TrendLogins as List<int> ?? new List<int>();
    var trendSso = ViewBag.TrendSso as List<int> ?? new List<int>();
    var trendOther = ViewBag.TrendOther as List<int> ?? new List<int>();

    var availableActions = ViewBag.AvailableActions as List<string> ?? new List<string>();

    var auditedUser = ViewBag.AuditedUser as ExwhyzeeSP.Core.Models.MasterAdminUser;
    var isSingleUserAudit = auditedUser != null || (!string.IsNullOrWhiteSpace(search) && (search.Contains("@") || search.Contains("admin")));
    var auditedIdentifier = auditedUser?.FullName ?? search ?? "Operator";
    var auditedEmail = auditedUser?.Email ?? (search?.Contains("@") == true ? search : null);
    var auditedRole = auditedUser?.RoleTitle ?? "Administrator";

    var startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Security Activity Log &amp; Audit Trail</h1>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    @totalAllLogs Active Records in Scope
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)]">
                Cryptographic authentication ledger, delegated SSO sessions, IP traces, and regulatory audit history.
            </p>
        </div>

        <div class="flex items-center flex-wrap gap-2.5 shrink-0 ms-auto">
            <!-- Official Statement Export -->
            <a asp-action="ActivityStatement" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" target="_blank" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" title="Generate printable formal audit statement">
                <i class="icon-file-text text-[14px] text-sky-500"></i>
                <span>Official Statement</span>
            </a>

            <!-- CSV Export -->
            <a asp-action="ExportActivityLogCsv" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="btn btn-outline border-secondary text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" title="Export matching logs to CSV">
                <i class="icon-download text-[14px] text-emerald-500"></i>
                <span>Export CSV</span>
            </a>

            <!-- Purge / Reclaim Storage Modal Trigger -->
            <button type="button" data-bs-toggle="modal" data-bs-target="#purgeModal" class="btn btn-outline border-rose-200 dark:border-rose-900/40 text-rose-600 dark:text-rose-400 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-lg shadow-sm hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Purge historical logs to reclaim DB storage">
                <i class="icon-trash-2 text-[14px]"></i>
                <span>Purge Records</span>
            </button>

            <!-- Back to Profile -->
            <a asp-action="Profile" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-lg shadow-sm text-decoration-none bg-sky-600 hover:bg-sky-700 text-white">
                <i class="icon-arrow-left text-[14px]"></i>
                <span>Account Profile</span>
            </a>
        </div>
    </div>

    <!-- ================= MASTER TIMEFRAME & AUDIT SCOPE FILTER TOOLBAR (AT TOP) ================= -->
    <div class="surface-card rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 sm:p-5 shadow-sm space-y-4">
        <form method="get" id="masterFilterForm" class="space-y-3">
            @if (!string.IsNullOrEmpty(severity))
            {
                <input type="hidden" name="severity" value="@severity" />
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
                <!-- Search Keyword / Operator -->
                <div class="lg:col-span-4 relative">
                    <span class="absolute start-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none flex items-center">
                        <i class="icon-search text-[14px]"></i>
                    </span>
                    <input type="text" name="search" value="@search" style="padding-left: 2.25rem !important;" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 pr-3.5 py-2 text-xs text-[var(--text-primary)] placeholder:text-slate-400 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition" placeholder="Search operator, email, IP, action, device..." />
                </div>

                <!-- Action Type Dropdown -->
                <div class="lg:col-span-3">
                    <select name="actionType" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition" onchange="this.form.submit()">
                        <option value="">All Action Types</option>
                        <option value="Login" selected="@(actionType == "Login")">Login / Sign-In Events</option>
                        <option value="Delegated" selected="@(actionType == "Delegated")">Delegated SSO Support</option>
                        <option value="2fa" selected="@(actionType == "2fa")">Two-Factor Authentication</option>
                        <option value="Password" selected="@(actionType == "Password")">Password Management</option>
                        <option value="Logout" selected="@(actionType == "Logout")">Sign-Out (Logout)</option>
                        @foreach (var act in availableActions.Where(a => !string.IsNullOrEmpty(a) && !a.Contains("Login") && !a.Contains("Delegated") && !a.Contains("2fa") && !a.Contains("Password") && !a.Contains("Logout")))
                        {
                            <option value="@act" selected="@(actionType == act)">@act</option>
                        }
                    </select>
                </div>

                <!-- Date Range From -->
                <div class="lg:col-span-2">
                    <div class="relative">
                        <input type="date" id="inputFromDate" name="fromDate" value="@fromDate" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs text-[var(--text-primary)] focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition font-mono" title="Start Date (From)" />
                    </div>
                </div>

                <!-- Date Range To -->
                <div class="lg:col-span-2">
                    <div class="relative">
                        <input type="date" id="inputToDate" name="toDate" value="@toDate" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-xs text-[var(--text-primary)] focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition font-mono" title="End Date (To)" />
                    </div>
                </div>

                <!-- Submit / Clear -->
                <div class="lg:col-span-1 flex items-center gap-1.5">
                    <button type="submit" class="btn btn-primary text-xs font-semibold py-2 px-3 rounded-lg shadow-sm flex-1 bg-sky-600 hover:bg-sky-700 text-white flex items-center justify-center gap-1" title="Apply Timeframe & Filters">
                        <i class="icon-filter text-[13px]"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(actionType) || !string.IsNullOrEmpty(severity) || !string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
                    {
                        <a href="/Admin/Account/ActivityLog" class="btn btn-outline border-secondary text-xs font-semibold py-2 px-2.5 rounded-lg text-decoration-none hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" title="Reset all filters to default">
                            <i class="icon-x text-[13px]"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Quick Timeframe Presets Bar -->
            <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
                <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider me-1">Quick Scope:</span>
                    <button type="button" onclick="setPresetRange(0)" class="px-2.5 py-1 rounded-md text-[11px] font-medium border border-slate-200 dark:border-slate-700 bg-[var(--surface-card)] hover:bg-slate-100 dark:hover:bg-slate-800 text-[var(--text-primary)] transition">
                        Today
                    </button>
                    <button type="button" onclick="setPresetRange(7)" class="px-2.5 py-1 rounded-md text-[11px] font-medium border border-slate-200 dark:border-slate-700 bg-[var(--surface-card)] hover:bg-slate-100 dark:hover:bg-slate-800 text-[var(--text-primary)] transition">
                        Last 7 Days
                    </button>
                    <button type="button" onclick="setPresetRange(14)" class="px-2.5 py-1 rounded-md text-[11px] font-semibold border border-sky-300 dark:border-sky-800 bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 transition">
                        Last 14 Days
                    </button>
                    <button type="button" onclick="setPresetRange(30)" class="px-2.5 py-1 rounded-md text-[11px] font-medium border border-slate-200 dark:border-slate-700 bg-[var(--surface-card)] hover:bg-slate-100 dark:hover:bg-slate-800 text-[var(--text-primary)] transition">
                        Last 30 Days
                    </button>
                    <button type="button" onclick="clearDateRange()" class="px-2.5 py-1 rounded-md text-[11px] font-medium border border-slate-200 dark:border-slate-700 bg-[var(--surface-card)] hover:bg-slate-100 dark:hover:bg-slate-800 text-[var(--text-secondary)] transition">
                        All Time
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
                {
                    <div class="flex items-center gap-2 text-xs font-semibold text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/40 px-3 py-1 rounded-full border border-sky-200 dark:border-sky-800/60">
                        <i class="bi bi-calendar-range"></i>
                        <span>Active Window: @(fromDate ?? "Beginning") &rarr; @(toDate ?? "Today")</span>
                    </div>
                }
            </div>
        </form>

        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(actionType) || !string.IsNullOrEmpty(severity) || !string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
        {
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between flex-wrap gap-2 text-xs">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-[var(--text-secondary)] font-medium">Active Audit Filter:</span>
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                            <i class="bi bi-person-badge text-xs"></i> User / Keyword: <strong class="font-mono">@search</strong>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(actionType))
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/60">
                            <i class="bi bi-funnel text-xs"></i> Action: <strong>@actionType</strong>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(severity))
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-200 dark:border-amber-800/60">
                            <i class="bi bi-shield-exclamation text-xs"></i> Severity: <strong>@severity</strong>
                        </span>
                    }
                </div>
                <a asp-action="ActivityLog" asp-controller="Account" asp-area="" class="text-xs font-semibold text-rose-600 hover:text-rose-700 flex items-center gap-1 text-decoration-none">
                    <i class="bi bi-x-circle"></i>
                    <span>Reset All Filters</span>
                </a>
            </div>
        }
    </div>

    @if (isSingleUserAudit)
    {
        <!-- ============ Single-Person Security Audit Profile Card ============ -->
        <div class="surface-card rounded-2xl border-2 border-sky-500/40 dark:border-sky-500/30 bg-gradient-to-r from-sky-500/[0.06] via-[var(--surface-card)] to-indigo-500/[0.06] p-5 sm:p-6 shadow-md relative overflow-hidden animate-rise-in">
            <div class="absolute top-0 right-0 w-72 h-72 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
                <!-- Left: Identity & Scope -->
                <div class="flex items-start sm:items-center gap-4">
                    <div class="relative shrink-0 size-14 sm:size-16 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-600 text-white font-display font-bold text-xl sm:text-2xl grid place-items-center shadow-md border-2 border-white dark:border-slate-800">
                        @if (auditedUser != null && !string.IsNullOrEmpty(auditedUser.ProfileImageUrl))
                        {
                            <img src="@auditedUser.ProfileImageUrl" alt="@auditedIdentifier" class="w-full h-full object-cover rounded-2xl" />
                        }
                        else
                        {
                            <span>@((!string.IsNullOrEmpty(auditedIdentifier) ? auditedIdentifier[0].ToString() : "U").ToUpper())</span>
                        }
                        <span class="absolute -bottom-1 -end-1 size-4 rounded-full bg-emerald-500 border-2 border-white dark:border-slate-800" title="Active Security Monitoring"></span>
                    </div>

                    <div class="space-y-1">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-500/25">
                                Single-Person Security Audit Scope
                            </span>
                            @if (auditedRole == "SuperAdmin")
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60">
                                    <i class="bi bi-shield-lock-fill text-[11px]"></i> Root SuperAdmin
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                                    <i class="bi bi-shield-fill text-[11px]"></i> @auditedRole
                                </span>
                            }
                        </div>

                        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-[var(--text-primary)] flex items-center gap-2">
                            <span>@auditedIdentifier</span>
                        </h2>

                        <div class="flex items-center gap-3 flex-wrap text-xs text-[var(--text-secondary)]">
                            @if (!string.IsNullOrEmpty(auditedEmail))
                            {
                                <span class="flex items-center gap-1.5 font-mono text-[12px] font-semibold text-slate-800 dark:text-slate-200">
                                    <i class="bi bi-envelope text-sky-500"></i>
                                    @auditedEmail
                                </span>
                                <span>&middot;</span>
                            }
                            <span class="flex items-center gap-1">
                                <i class="bi bi-journal-check text-emerald-500"></i>
                                <strong class="text-[var(--text-primary)]">@totalItems.ToString("N0")</strong> Security Events in Scope
                            </span>
                            @if (auditedUser?.LastLoginUtc != null)
                            {
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <i class="bi bi-clock-history text-sky-500"></i>
                                    Last Active: <strong class="text-[var(--text-primary)]">@auditedUser.LastLoginUtc.Value.ToString("MMM dd, yyyy HH:mm")</strong>
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right: Action Controls -->
                <div class="flex items-center gap-2 flex-wrap shrink-0">
                    <a asp-action="ActivityStatement" asp-route-search="@search" target="_blank" class="btn btn-outline border-sky-300 dark:border-sky-800/60 text-sky-700 dark:text-sky-300 hover:bg-sky-50 dark:hover:bg-sky-950/40 text-xs font-semibold px-3 py-2 rounded-xl flex items-center gap-1.5 text-decoration-none shadow-xs transition-all" title="Generate individual audit statement">
                        <i class="bi bi-printer text-sm"></i>
                        <span>Print Person Audit</span>
                    </a>
                    <a asp-action="ExportActivityLogCsv" asp-route-search="@search" class="btn btn-outline border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-semibold px-3 py-2 rounded-xl flex items-center gap-1.5 text-decoration-none shadow-xs transition-all" title="Export this person's logs to CSV">
                        <i class="bi bi-download text-sm text-emerald-500"></i>
                        <span>Export CSV</span>
                    </a>
                    <a asp-action="ActivityLog" asp-controller="Account" asp-area="" class="btn btn-outline border-rose-200 dark:border-rose-900/40 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-semibold px-3.5 py-2 rounded-xl flex items-center gap-1.5 text-decoration-none shadow-xs transition-all" title="Exit single-person audit and view all system logs">
                        <i class="bi bi-x-circle text-sm"></i>
                        <span>View All System Logs</span>
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center gap-3 shadow-sm">
            <i class="icon-check-circle text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center gap-3 shadow-sm">
            <i class="icon-alert-triangle text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["ErrorMessage"]</div>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center gap-3 shadow-sm">
            <i class="icon-info text-[18px]"></i>
            <div class="text-xs font-semibold">@TempData["InfoMessage"]</div>
        </div>
    }

    <!-- Top Statistical Metric Tiles (Scoped to Timeframe & Filters) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Logins -->
        <a asp-action="ActivityLog" asp-route-actionType="Login" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@search" class="surface-card rounded-xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden text-decoration-none hover:border-emerald-500 hover:shadow-md transition-all group @(actionType == "Login" ? "ring-2 ring-emerald-500/40 border-emerald-500" : "")">
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-emerald-500"></div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider group-hover:text-emerald-600 transition-colors">Successful Logins</span>
                <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i class="icon-log-in text-sm"></i>
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <h3 class="text-2xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">@totalLogins.ToString("N0")</h3>
                <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full">Scoped</span>
            </div>
            <p class="text-[11px] text-[var(--text-secondary)] mt-1.5 flex items-center gap-1">
                <i class="icon-shield-check text-[12px] text-emerald-500"></i>
                <span>Direct &amp; 2FA sign-ins</span>
            </p>
        </a>

        <!-- Delegated SSO Support Sessions -->
        <a asp-action="ActivityLog" asp-route-actionType="Delegated" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@search" class="surface-card rounded-xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden text-decoration-none hover:border-sky-500 hover:shadow-md transition-all group @(actionType == "Delegated" ? "ring-2 ring-sky-500/40 border-sky-500" : "")">
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-sky-500"></div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider group-hover:text-sky-600 transition-colors">Delegated SSO Support</span>
                <span class="w-8 h-8 rounded-lg bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i class="icon-external-link text-sm"></i>
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <h3 class="text-2xl font-bold tracking-tight text-sky-600 dark:text-sky-400">@totalSso.ToString("N0")</h3>
                <span class="text-xs font-semibold text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/60 px-2 py-0.5 rounded-full">Authorized</span>
            </div>
            <p class="text-[11px] text-[var(--text-secondary)] mt-1.5 flex items-center gap-1">
                <i class="icon-key text-[12px] text-sky-500"></i>
                <span>School portal inspections</span>
            </p>
        </a>

        <!-- Unique Client IPs -->
        <a asp-action="ActivityLog" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@search" class="surface-card rounded-xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden text-decoration-none hover:border-indigo-500 hover:shadow-md transition-all group">
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-indigo-500"></div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider group-hover:text-indigo-600 transition-colors">Unique Client IPs</span>
                <span class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i class="icon-globe text-sm"></i>
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <h3 class="text-2xl font-bold tracking-tight text-indigo-600 dark:text-indigo-400">@uniqueIps.ToString("N0")</h3>
                <span class="text-xs font-medium text-[var(--text-secondary)]">Gateways</span>
            </div>
            <p class="text-[11px] text-[var(--text-secondary)] mt-1.5 flex items-center gap-1">
                <i class="icon-map-pin text-[12px] text-indigo-500"></i>
                <span>Distinct connection origins</span>
            </p>
        </a>

        <!-- Security Alerts / Warnings -->
        <a asp-action="ActivityLog" asp-route-severity="Warning" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-search="@search" class="surface-card rounded-xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm relative overflow-hidden text-decoration-none hover:border-amber-500 hover:shadow-md transition-all group @(severity == "Warning" ? "ring-2 ring-amber-500/40 border-amber-500" : "")">
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-amber-500"></div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider group-hover:text-amber-600 transition-colors">Security Events / Flags</span>
                <span class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i class="icon-alert-octagon text-sm"></i>
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <h3 class="text-2xl font-bold tracking-tight text-amber-600 dark:text-amber-400">@totalWarnings.ToString("N0")</h3>
                <span class="text-xs font-semibold @(totalWarnings > 0 ? "text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60" : "text-emerald-700 bg-emerald-50") px-2 py-0.5 rounded-full">
                    @(totalWarnings > 0 ? "Monitored" : "Clean")
                </span>
            </div>
            <p class="text-[11px] text-[var(--text-secondary)] mt-1.5 flex items-center gap-1">
                <i class="icon-activity text-[12px] text-amber-500"></i>
                <span>Warnings &amp; exceptions</span>
            </p>
        </a>
    </div>

    <!-- Activity Trend Chart (Scoped to Filtered Timeframe) -->
    <div class="surface-card rounded-xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
            <div>
                <h3 class="text-base font-bold text-[var(--text-primary)]">
                    @(trendDates.Count)-Day Authentication &amp; Activity Trend
                </h3>
                <p class="text-xs text-[var(--text-secondary)]">Daily breakdown of sign-ins, delegated SSO authorizations, and security events for active scope</p>
            </div>
            <span class="px-2.5 py-1 rounded text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60 w-fit">
                Live Audit Stream
            </span>
        </div>
        <div id="activityTimelineChart" style="min-height: 250px;"></div>
    </div>

    <!-- Security Activity Table -->
    <div class="surface-card rounded-xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-[var(--text-primary)]">
                <thead class="bg-slate-100/75 dark:bg-slate-800/60 text-[11px] font-bold uppercase tracking-wider text-[var(--text-secondary)] border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th scope="col" class="py-3 px-4 w-44">Event Action</th>
                        <th scope="col" class="py-3 px-4 w-36">IP Address</th>
                        <th scope="col" class="py-3 px-4 w-52">Browser / Device</th>
                        <th scope="col" class="py-3 px-4 min-w-[320px]">Details &amp; Audit Scope</th>
                        <th scope="col" class="py-3 px-4 w-44 text-right">Timestamp (UTC)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            var isLogin = log.Action.Contains("LoginSuccess") || log.Action.Contains("2fa_verified");
                            var isWarning = log.Action.Contains("Failed") || log.Action.Contains("Locked") || log.Severity == "Warning" || log.Severity == "Critical";
                            var isSso = log.Action.Contains("SSO") || log.Action.Contains("Delegated");

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
                                <!-- Event Action Badge -->
                                <td class="py-3.5 px-4 font-semibold">
                                    @if (isLogin)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                                            <i class="icon-check-circle text-[11px]"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else if (isWarning)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60">
                                            <i class="icon-alert-triangle text-[11px]"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else if (isSso)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60">
                                            <i class="icon-link-2 text-[11px]"></i>
                                            @log.Action
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            <i class="icon-activity text-[11px]"></i>
                                            @log.Action
                                        </span>
                                    }
                                </td>

                                <!-- IP Address -->
                                <td class="py-3.5 px-4">
                                    <code class="font-mono text-[11.5px] font-semibold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded border border-slate-200/60 dark:border-slate-700">
                                        @log.IpAddress
                                    </code>
                                </td>

                                <!-- Browser & Device Details -->
                                <td class="py-3.5 px-4">
                                    <div class="font-semibold text-[var(--text-primary)]">@(log.Browser ?? "Web Browser")</div>
                                    <span class="text-[11px] text-[var(--text-secondary)] block mt-0.5">
                                        @(log.DeviceType ?? "Desktop") &bull; @(log.OperatingSystem ?? "Windows")
                                    </span>
                                </td>

                                <!-- Details (Relaxed & Multi-Line with ample spacing) -->
                                <td class="py-3.5 px-4">
                                    <div class="text-[11.5px] text-[var(--text-secondary)] leading-relaxed max-w-xl">
                                        @log.Details
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.TenantSubDomain))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200 dark:border-sky-800/60 mt-1">
                                            Tenant: @log.TenantSubDomain
                                        </span>
                                    }
                                </td>

                                <!-- Timestamp (Non-Wrapping) -->
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <span class="font-mono text-xs font-semibold text-[var(--text-primary)] block">
                                        @log.TimestampUtc.ToString("yyyy-MM-dd")
                                    </span>
                                    <span class="font-mono text-[11px] text-[var(--text-secondary)] block">
                                        @log.TimestampUtc.ToString("HH:mm:ss") UTC
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-12 text-center text-[var(--text-secondary)]">
                                <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 grid place-items-center mx-auto mb-3 text-slate-400">
                                    <i class="icon-shield-check text-[24px]"></i>
                                </div>
                                <p class="text-sm font-semibold text-[var(--text-primary)]">No Security Activity Logs Found</p>
                                <p class="text-xs text-[var(--text-secondary)] mt-1">No authentication or audit entries match your current search filters.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        @if (totalPages > 1 || totalItems > 0)
        {
            <div class="p-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/50 dark:bg-slate-900/50">
                <div class="text-xs text-[var(--text-secondary)]">
                    Showing <strong class="text-[var(--text-primary)] font-semibold">@startItem</strong> to <strong class="text-[var(--text-primary)] font-semibold">@endItem</strong> of <strong class="text-[var(--text-primary)] font-semibold">@totalItems</strong> log entries
                </div>

                @if (totalPages > 1)
                {
                    <div class="flex items-center gap-1.5">
                        <!-- First Page -->
                        <a asp-action="ActivityLog" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="First Page">
                            <i class="icon-chevrons-left text-[14px]"></i>
                        </a>

                        <!-- Previous Page -->
                        <a asp-action="ActivityLog" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == 1 ? "pointer-events-none opacity-40" : "")" title="Previous Page">
                            <i class="icon-chevron-left text-[14px]"></i>
                        </a>

                        <!-- Page Number Range -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <a asp-action="ActivityLog" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="grid place-items-center min-w-8 h-8 px-2 rounded-lg text-xs font-semibold text-decoration-none transition-colors @(p == currentPage ? "bg-sky-600 text-white shadow-sm" : "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700")">
                                @p
                            </a>
                        }

                        <!-- Next Page -->
                        <a asp-action="ActivityLog" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Next Page">
                            <i class="icon-chevron-right text-[14px]"></i>
                        </a>

                        <!-- Last Page -->
                        <a asp-action="ActivityLog" asp-route-page="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-actionType="@actionType" asp-route-severity="@severity" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" class="grid place-items-center w-8 h-8 rounded-lg text-xs bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")" title="Last Page">
                            <i class="icon-chevrons-right text-[14px]"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Purge / Reclaim Storage Modal -->
<div class="modal fade" id="purgeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content surface-card rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden bg-white dark:bg-slate-900">
            <div class="p-6">
                <div class="flex items-start gap-4 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-200 dark:border-rose-900/40">
                        <i class="icon-trash-2 text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-[var(--text-primary)]">Purge Historical Activity Logs</h3>
                        <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                            Reclaim database storage and optimize performance when activity records reach high volume.
                        </p>
                    </div>
                </div>

                <form asp-action="PurgeActivityLogs" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <!-- Purge Mode Selector -->
                    <div>
                        <label class="block text-xs font-semibold text-[var(--text-primary)] mb-1.5">Purge Criteria</label>
                        <select name="daysOlderThan" id="purgeDaysSelect" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3.5 py-2 text-xs text-[var(--text-primary)] focus:border-rose-500 focus:ring-1 focus:ring-rose-500 outline-none" onchange="togglePurgeCustomDates(this.value)">
                            <option value="30">Delete logs older than 30 days</option>
                            <option value="60">Delete logs older than 60 days</option>
                            <option value="90" selected>Delete logs older than 90 days (Recommended)</option>
                            <option value="180">Delete logs older than 180 days (6 Months)</option>
                            <option value="365">Delete logs older than 1 Year</option>
                            <option value="-1">Custom Date Range...</option>
                        </select>
                    </div>

                    <!-- Custom Date Range (Hidden by default) -->
                    <div id="purgeCustomDatesRow" style="display: none;" class="grid grid-cols-2 gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                        <div>
                            <label class="block text-[11px] font-medium text-[var(--text-secondary)] mb-1">From Date</label>
                            <input type="date" name="purgeFromDate" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-xs text-[var(--text-primary)]" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-[var(--text-secondary)] mb-1">To Date</label>
                            <input type="date" name="purgeToDate" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2.5 py-1.5 text-xs text-[var(--text-primary)]" />
                        </div>
                    </div>

                    <!-- Security Confirmation -->
                    <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/40">
                        <label class="block text-xs font-bold text-rose-700 dark:text-rose-400 mb-1">Confirmation Required</label>
                        <p class="text-[11px] text-rose-600 dark:text-rose-300 mb-2">
                            Purged records cannot be recovered. Type <code class="font-bold bg-white dark:bg-rose-900/60 px-1 py-0.5 rounded text-rose-700 dark:text-rose-200">PURGE</code> below to confirm.
                        </p>
                        <input type="text" name="confirmText" placeholder="Type PURGE in capital letters" required class="w-full rounded-lg border border-rose-300 dark:border-rose-800 bg-white dark:bg-slate-950 px-3.5 py-2 text-xs text-rose-700 dark:text-rose-300 font-mono tracking-wider uppercase focus:outline-none focus:ring-1 focus:ring-rose-500" />
                    </div>

                    <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-200 dark:border-slate-800">
                        <button type="button" class="btn btn-outline border-secondary text-xs font-semibold px-4 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn text-xs font-semibold px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition-colors">
                            Confirm &amp; Reclaim Storage
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        initActivityChart();
    });

    function initActivityChart() {
        const dates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendDates));
        const logins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendLogins));
        const sso = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendSso));
        const other = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendOther));

        const options = {
            series: [
                { name: 'Logins & Auth', data: logins },
                { name: 'Delegated SSO Sessions', data: sso },
                { name: 'Other Security Events', data: other }
            ],
            chart: {
                type: 'area',
                height: 250,
                toolbar: { show: false },
                fontFamily: 'inherit'
            },
            colors: ['#10b981', '#0284c7', '#f59e0b'],
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 },
            xaxis: {
                categories: dates,
                labels: { style: { fontSize: '11px', fontWeight: 500 } }
            },
            yaxis: {
                title: { text: 'Events Count' },
                min: 0,
                forceNiceScale: true
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.5,
                    opacityTo: 0.05,
                    stops: [0, 95, 100]
                }
            },
            legend: {
                position: 'top',
                horizontalAlign: 'right'
            },
            tooltip: {
                y: {
                    formatter: function (val) {
                        return val + " events";
                    }
                }
            }
        };

        new ApexCharts(document.querySelector("#activityTimelineChart"), options).render();
    }

    function setPresetRange(days) {
        const toInput = document.getElementById('inputToDate');
        const fromInput = document.getElementById('inputFromDate');
        const form = document.getElementById('masterFilterForm');

        const now = new Date();
        const toDateStr = now.toISOString().split('T')[0];

        if (days === 0) {
            fromInput.value = toDateStr;
            toInput.value = toDateStr;
        } else {
            const fromDate = new Date();
            fromDate.setDate(now.getDate() - (days - 1));
            fromInput.value = fromDate.toISOString().split('T')[0];
            toInput.value = toDateStr;
        }

        form.submit();
    }

    function clearDateRange() {
        const toInput = document.getElementById('inputToDate');
        const fromInput = document.getElementById('inputFromDate');
        const form = document.getElementById('masterFilterForm');

        fromInput.value = '';
        toInput.value = '';
        form.submit();
    }

    function togglePurgeCustomDates(val) {
        const row = document.getElementById('purgeCustomDatesRow');
        if (row) {
            if (val === "-1") {
                row.style.display = 'grid';
            } else {
                row.style.display = 'none';
            }
        }
    }
</script>
}
