                                            <i class="icon-log-out text-[15px]"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </header>

            <!-- ================= BODY CONTENT ================= -->
            <main class="main-content flex-1 p-4 lg:p-6 overflow-y-auto">
