            overflow: hidden;
            display: none;
            flex-direction: column;
            z-index: 99999;
            border: 1px solid rgba(0, 0, 0, 0.08);
         }

         .whatsapp-chat-window.active {
            display: flex;
            animation: wa-slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
         }

         @@keyframes wa-slide-up {
