@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container text-center py-5" style="margin-top: 50px;">
    <h2 class="text-danger mb-3">Unable to process request</h2>
    <p class="text-muted">An error occurred while loading this page. Please refresh or try again shortly.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <div class="mt-4">
        <a href="/" class="btn btn-primary">Go to Home</a>
    </div>
</div>



