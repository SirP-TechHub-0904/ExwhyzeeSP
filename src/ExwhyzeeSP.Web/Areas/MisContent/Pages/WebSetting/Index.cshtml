@page
@model ExwhyzeeSP.Web.Areas.MisContent.Pages.WebSetting.IndexModel
@{
    ViewData["Title"] = "Website Settings & Theme";
    var ss = Model.SuperSetting;
    var st = Model.Setting;
}

@section HeaderActions {
    <a asp-page="./Update" class="btn btn-primary btn-sm"><i class="fa fa-edit"></i> Edit Settings</a>
    <a asp-page="./DesignSettings" class="btn btn-info btn-sm"><i class="fa fa-paint-brush"></i> Design &amp; Theme</a>
    <a asp-page="./UiProperty" class="btn btn-default btn-sm"><i class="fa fa-sliders"></i> UI Properties</a>
}

@if (!Model.HasSuperSetting)
{
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle"></i>
        <strong>No Website SuperSetting record found yet.</strong>
        Click <a asp-page="./Update" class="btn btn-warning btn-xs"><i class="fa fa-plus"></i> Configure Website Settings</a> to initialize it.
    </div>
}

<div class="nav-tabs-custom">
    <ul class="nav nav-tabs">
        <li class="active"><a href="#tab-branding" data-toggle="tab"><i class="fa fa-building-o"></i> Company &amp; Branding</a></li>
        <li><a href="#tab-theme" data-toggle="tab"><i class="fa fa-paint-brush"></i> Theme &amp; Layout</a></li>
        <li><a href="#tab-features" data-toggle="tab"><i class="fa fa-toggle-on"></i> Menu &amp; Features</a></li>
        <li><a href="#tab-contact" data-toggle="tab"><i class="fa fa-share-alt"></i> Contact, Social &amp; Footer</a></li>
        <li><a href="#tab-payment" data-toggle="tab"><i class="fa fa-credit-card"></i> Payment &amp; Storage</a></li>
    </ul>

    <div class="tab-content">
        <!-- Tab 1: Company & Branding -->
        <div class="tab-pane fade in active" id="tab-branding">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th style="width:260px;">Company / School Name</th><td>@(ss.CompanyName ?? "-")</td></tr>
                    <tr><th>Abbreviation</th><td>@(ss.CompanyNameAbbreviation ?? "-")</td></tr>
                    <tr><th>Website Title</th><td>@(ss.WebsiteTitle ?? "-")</td></tr>
                    <tr><th>Dashboard Title</th><td>@(ss.DashboardTitle ?? "-")</td></tr>
                    <tr><th>Company Description</th><td>@(ss.CompanyDescription ?? "-")</td></tr>
                    <tr><th>Website Link</th><td>@(ss.CompanyWebsiteLink ?? "-")</td></tr>
                    <tr>
                        <th>Company Logo</th>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(ss.CompanyLogoUrl))
                            {
                                <img src="@ss.CompanyLogoUrl" alt="Logo" style="max-height:60px;" />
                            }
                            else { <span class="text-muted">Not set</span> }
                        </td>
                    </tr>
                    <tr>
                        <th>White Logo</th>
                        <td style="background:#222d32;">
                            @if (!string.IsNullOrWhiteSpace(ss.CompanyWhiteLogoUrl))
                            {
                                <img src="@ss.CompanyWhiteLogoUrl" alt="White Logo" style="max-height:60px;" />
                            }
                            else { <span style="color:#ccc;">Not set</span> }
                        </td>
                    </tr>
                    <tr>
                        <th>Favicon / Icon</th>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(ss.CompanyIconUrl))
                            {
                                <img src="@ss.CompanyIconUrl" alt="Icon" style="max-height:48px;" />
                            }
                            else { <span class="text-muted">Not set</span> }
                        </td>
                    </tr>
                    <tr>
                        <th>Reloader Icon</th>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(ss.ReloaderIconUrl))
                            {
                                <img src="@ss.ReloaderIconUrl" alt="Reloader" style="max-height:48px;" />
                            }
                            else { <span class="text-muted">Not set</span> }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Tab 2: Theme & Layout -->
        <div class="tab-pane fade" id="tab-theme">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th style="width:260px;">Template Layout Key</th><td><code>@(ss.TemplateLayoutKey ?? "-")</code></td></tr>
                    <tr><th>Color Template Key</th><td><code>@(ss.ColorTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Slider Template Key</th><td><code>@(ss.SliderTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Blog Template Key</th><td><code>@(ss.BlogTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Footer Template Key</th><td><code>@(ss.FooterTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Page Header Template Key</th><td><code>@(ss.PageHeaderTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Login Template Key</th><td><code>@(ss.LoginTemplateKey ?? "-")</code></td></tr>
                    <tr><th>Reloader Template Key</th><td><code>@(ss.ReloaderTemplateKey ?? "-")</code></td></tr>
                </tbody>
            </table>
        </div>

        <!-- Tab 3: Menu & Features -->
        <div class="tab-pane fade" id="tab-features">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th style="width:280px;">Activate Login</th><td><span class="label @(ss.ActivateLogin ? "label-success" : "label-default")">@(ss.ActivateLogin ? "Yes" : "No")</span></td></tr>
                    <tr><th>Activate Login In Menu</th><td><span class="label @(ss.ActivateLoginInMenu ? "label-success" : "label-default")">@(ss.ActivateLoginInMenu ? "Yes" : "No")</span></td></tr>
                    <tr><th>Special Menu Button</th><td><span class="label @(ss.SpecialMenuButtonActivate ? "label-success" : "label-default")">@(ss.SpecialMenuButtonActivate ? "Yes" : "No")</span> @ss.SpecialMenuButtonText (@ss.SpecialMenuButtonLink)</td></tr>
                    <tr><th>Coming Soon Mode</th><td><span class="label @(ss.ActivateComingSoon ? "label-warning" : "label-default")">@(ss.ActivateComingSoon ? "Yes" : "No")</span></td></tr>
                    <tr><th>Show Made By XYZ</th><td><span class="label @(ss.ShowMadeByXYZ ? "label-success" : "label-default")">@(ss.ShowMadeByXYZ ? "Yes" : "No")</span></td></tr>
                    <tr><th>Breaking News Ribbon</th><td><span class="label @(st.EnableBreakingNewsRibon ? "label-success" : "label-default")">@(st.EnableBreakingNewsRibon ? "Yes" : "No")</span> @st.BreakingNewsRibonTitle</td></tr>
                    <tr><th>Add Blog To Home / Menu / Footer</th><td>Home: @(st.AddBlogToHome ? "Yes" : "No") | Menu: @(st.AddBlogToMenu ? "Yes" : "No") | Footer: @(st.AddBlogToFooter ? "Yes" : "No")</td></tr>
                    <tr><th>Add Testimony To Home / Footer</th><td>Home: @(st.AddTestimonyToHome ? "Yes" : "No") | Footer: @(st.AddTestimonyToFooter ? "Yes" : "No")</td></tr>
                    <tr><th>Add FAQ To Home / Footer</th><td>Home: @(st.AddFaqToHome ? "Yes" : "No") | Footer: @(st.AddFaqToFooter ? "Yes" : "No")</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Tab 4: Contact, Social & Footer -->
        <div class="tab-pane fade" id="tab-contact">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th style="width:260px;">Contact Email</th><td>@(st.EmailOne ?? st.ContactEmail ?? "-")</td></tr>
                    <tr><th>Contact Phone</th><td>@(st.PhoneOne ?? st.ContactPhoneNumber ?? "-")</td></tr>
                    <tr><th>Address</th><td>@(st.AddressOne ?? st.SchoolAddress ?? "-")</td></tr>
                    <tr><th>Facebook</th><td>@(st.FacebookPage ?? "-")</td></tr>
                    <tr><th>Twitter / X</th><td>@(st.TwitterPage ?? "-")</td></tr>
                    <tr><th>Instagram</th><td>@(st.InstagramPage ?? "-")</td></tr>
                    <tr><th>TikTok</th><td>@(st.TiktokPage ?? "-")</td></tr>
                    <tr><th>YouTube</th><td>@(st.YoutubeChannel ?? "-")</td></tr>
                    <tr><th>Play Store Link</th><td>@(ss.PlayStoreLink ?? "-")</td></tr>
                    <tr><th>App Store Link</th><td>@(ss.AppStoreLink ?? "-")</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Tab 5: Payment & Storage -->
        <div class="tab-pane fade" id="tab-payment">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr><th style="width:260px;">Payment Module Active</th><td><span class="label @(ss.PaymentModuleActive ? "label-success" : "label-default")">@(ss.PaymentModuleActive ? "Yes" : "No")</span></td></tr>
                    <tr><th>Currency</th><td>@(ss.CurrencyCode ?? "-") (@(ss.CurrencySymbol ?? "-"))</td></tr>
                    <tr><th>Paystack Public Key</th><td>@(string.IsNullOrWhiteSpace(ss.PaystackPublicKey) ? "-" : ss.PaystackPublicKey)</td></tr>
                    <tr><th>AWS Bucket Name</th><td><code>@(ss.BucketName ?? "-")</code></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
