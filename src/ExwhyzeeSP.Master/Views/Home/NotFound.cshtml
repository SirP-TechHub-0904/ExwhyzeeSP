@{
    ViewData["Title"] = "Page Not Found";
    ViewData["MetaDescription"] = "The page you are looking for could not be found.";
}
      <!-- Banner Section Start -->
      <div class="sisf-banner position-relative">
         <div class="banner-img">
            <figure>
               <img src="/assets/images/page-banner.png" alt="Vistara">
            </figure>
         </div>
         <div class="sisf-page-title sisf-m sisf-title--standard sisf-alignment--center">
            <div class="sisf-m-inner container">
               <div class="sisf-breadcrumbs mb-2">
                  <a class="sisf-breadcrumbs-link text-white" href="/">
                  <span>Home</span>
                  </a>
                  <span class="sisf-breadcrumbs-separator text-white mx-2"><i class="fa-solid fa-chevron-right"></i></span>
                  <span class="sisf-breadcrumbs-current text-white">Page Not Found</span>
               </div>
               <div class="sisf-m-content sisf-content-grid ">
                  <h1 class="sisf-m-title text-white sis-text-anime-style-3 entry-title">Page Not Found</h1>
               </div>
            </div>
         </div>
      </div>
      <!-- Banner Section End -->
      <!-- Error Page Section Start -->
      <div class="sis-error-page-section section">
        <div class="container">
            <div class="row">
                <div class="col-md-7 col-12 ms-auto me-auto">
                   <div class="sisf-error-page-content text-center">
                      <div class="sisf-error-page-image mb-4" data-aos="fade-up" data-aos-delay="100">
                        <figure>
                            <img src="/assets/images/error_img.png" alt="Vistara">
                        </figure>
                      </div>
                        <div class="sis-section-title mb-4">
							<h2 class="sis-text-anime-style-3 sisf-m-text mb-3">Oops! page not found</h2>
                            <p class="mt-0" data-aos="fade-up" data-aos-delay="300">The page you are looking for does not exist.</p>
						</div>
                      <div class="sisf-m-button" data-aos="fade-up" data-aos-delay="500">
                        <a href="/" class="sis-btn-default">Back to Home <i class="fa-solid fa-arrow-right-long"></i></a>
                      </div>
                   </div>
                </div>
            </div>
        </div>
      </div>
      <!-- Error Page Section End -->
