@model IEnumerable<ExwhyzeeSP.Core.Models.MasterPricingPlan>
@{
    ViewData["Title"] = "Transparent & Flexible Pricing Plans";
    ViewData["MetaDescription"] = "Exwhyzee SP offers flexible school portal pricing models: Pay per student/term, Pay per class/term, Pay per student/year, Pay per class/year, or custom institutional enterprise.";
    Layout = "_PublicLayout";
}

<!-- Page Header Start -->
<div class="sisf-page-header position-relative">
   <div class="sisf-page-header-image">
      <figure>
         <img src="/assets/images/page-banner.png" alt="Exwhyzee SP Pricing">
      </figure>
   </div>
   <div class="container">
      <div class="row align-items-center">
         <div class="col-lg-12">
            <div class="sisf-page-header-content text-center">
               <h1 class="text-white" data-aos="fade-up">Transparent, Flexible Pricing</h1>
               <ul class="list-unstyled d-flex align-items-center justify-content-center gap-2 m-0" data-aos="fade-up" data-aos-delay="200">
                  <li><a href="/" class="text-white">Home</a></li>
                  <li><span class="text-white">/</span></li>
                  <li class="text-white">Pricing Plans</li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- Page Header End -->

<!-- Pricing Switch & Intro Section -->
<div class="py-5">
   <div class="container py-4 text-center">
      <div class="mx-auto mb-5" style="max-width: 750px;" data-aos="fade-up">
         <span class="badge bg-primary px-3 py-2 text-uppercase mb-2">Tailored to Every Institution</span>
         <h2 class="display-6 fw-bold">Choose the Billing Model That Fits Your School</h2>
         <p class="text-muted mt-2">
            Whether you run a growing private academy or a large multi-campus network, Exwhyzee SP delivers maximum value with zero hidden charges. <strong>All pricing plans can be fully customized based on your demand.</strong>
         </p>
      </div>

      <!-- Pricing Cards Row -->
      <div class="row g-4 text-start justify-content-center">
         @if (Model != null && Model.Any())
         {
            int delay = 100;
            @foreach (var plan in Model)
            {
               var featureLines = (plan.Features ?? "")
                   .Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);

               <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="@delay">
                  <div class="card h-100 @(plan.IsPopular ? "border-2 border-primary shadow-lg bg-white" : "border rounded-4 shadow-sm bg-white") p-4 d-flex flex-column justify-content-between position-relative">
                     @if (plan.IsPopular)
                     {
                        <span class="position-absolute top-0 start-50 translate-middle badge bg-primary px-3 py-2 text-uppercase fw-bold shadow text-white" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                           <i class="fa-solid fa-star me-1 text-warning"></i> @(string.IsNullOrEmpty(plan.BadgeText) ? "Most Popular" : plan.BadgeText)
                        </span>
                     }
                     <div>
                        @if (!plan.IsPopular && !string.IsNullOrEmpty(plan.BadgeText))
                        {
                           <div class="mb-2">
                              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 text-uppercase fw-bold text-wrap text-start" style="font-size: 0.68rem; letter-spacing: 0.5px; line-height: 1.3;">
                                 @plan.BadgeText
                              </span>
                           </div>
                        }
                        
                        <h4 class="fw-bold text-dark mb-2 @(plan.IsPopular ? "mt-2" : "")" style="font-size: 1.25rem;">@plan.Name</h4>
                        
                        @if (!string.IsNullOrEmpty(plan.Subtitle))
                        {
                           <p class="text-muted small mb-3" style="min-height: 40px; line-height: 1.4; font-size: 0.82rem;">
                              @plan.Subtitle
                           </p>
                        }
                        
                        <div class="my-3 pb-3 border-bottom">
                           <span class="fs-2 fw-bold text-primary">@plan.PriceText</span>
                           <span class="text-muted d-block small mt-1">@plan.BillingCycle</span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                           <p class="text-muted small mb-3">@plan.Description</p>
                        }
                        
                        <ul class="list-unstyled small text-secondary mb-0">
                           @foreach (var feature in featureLines)
                           {
                              <li class="mb-2 d-flex align-items-start gap-2">
                                 <i class="fa-solid fa-circle-check text-success mt-1 flex-shrink-0" style="font-size: 14px;"></i>
                                 <span>@feature.Trim()</span>
                              </li>
                           }
                        </ul>
                     </div>
                     <div class="mt-4 pt-2">
                        <a href="@(string.IsNullOrEmpty(plan.ButtonUrl) ? "/Demo" : plan.ButtonUrl)" 
                           class="btn @(plan.IsPopular ? "btn-primary shadow-sm" : "btn-outline-primary") w-100 py-2 fw-semibold rounded-pill">
                           @(string.IsNullOrEmpty(plan.ButtonText) ? "Get Started" : plan.ButtonText)
                        </a>
                     </div>
                  </div>
               </div>
               delay += 100;
            }
         }
         else
         {
            <!-- Default Fallback Plans if DB is empty -->
            <div class="col-lg-4 col-md-6">
               <div class="card h-100 border rounded-4 shadow-sm p-4 text-start">
                  <span class="badge bg-light text-primary border px-2 py-1 text-uppercase fw-bold mb-3">Termly Flexibility</span>
                  <h4 class="fw-bold text-dark">Per Student Plan</h4>
                  <div class="my-3">
                     <span class="fs-1 fw-bold text-primary">₦500 - ₦1,500</span>
                     <span class="text-muted d-block small">/ student / term</span>
                  </div>
                  <p class="text-muted small">Pay-as-you-grow budgeting billed strictly per enrolled pupil per term.</p>
                  <a href="/Demo" class="btn btn-outline-primary w-100 py-2 fw-semibold rounded-pill mt-4">Get Started</a>
               </div>
            </div>
         }
      </div>
   </div>
</div>

<!-- Comparison & Customization Notice -->
<div class="py-5 bg-light border-top border-bottom">
   <div class="container py-4">
      <div class="row align-items-center">
         <div class="col-lg-8" data-aos="fade-right">
            <h3 class="fw-bold">Need a Custom Hybrid Model or Scratch-Card System?</h3>
            <p class="text-muted mb-0">
               Schools can also opt for zero upfront platform fees by enabling our <strong>Digital Scratch Card / Result Checking PIN model</strong> where parents purchase access cards to view termly transcripts and report cards, creating a direct revenue stream for your institution.
            </p>
         </div>
         <div class="col-lg-4 text-lg-end mt-3 mt-lg-0" data-aos="fade-left">
            <a href="/Contact" class="sis-btn-default shadow-none">Discuss Custom Setup <i class="fa-solid fa-arrow-right-long"></i></a>
         </div>
      </div>
   </div>
</div>

<!-- FAQ Accordion for Pricing -->
<div class="py-5">
   <div class="container py-4">
      <div class="text-center mb-5" data-aos="fade-up">
         <span class="badge bg-secondary px-3 py-2 text-uppercase mb-2">Pricing FAQs</span>
         <h2 class="display-6 fw-bold">Common Questions About Billing</h2>
      </div>
      <div class="row justify-content-center">
         <div class="col-lg-8">
            <div class="accordion shadow-sm rounded-3" id="pricingFaq">
               <div class="accordion-item">
                  <h2 class="accordion-header" id="headingOne">
                     <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Can we switch between per-student and per-class models?
                     </button>
                  </h2>
                  <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#pricingFaq">
                     <div class="accordion-body text-muted">
                        Yes! At the start of every academic session or term, your school administration can adjust your billing tier with your assigned account manager.
                     </div>
                  </div>
               </div>
               <div class="accordion-item">
                  <h2 class="accordion-header" id="headingTwo">
                     <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Are data backups and cloud hosting included in the fee?
                     </button>
                  </h2>
                  <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#pricingFaq">
                     <div class="accordion-body text-muted">
                        Absolutely. All plans include 24/7 high-availability cloud database hosting, SSL encryption, daily automated backups, and 99.9% uptime guarantees.
                     </div>
                  </div>
               </div>
               <div class="accordion-item">
                  <h2 class="accordion-header" id="headingThree">
                     <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        How does the Scratch Card / PIN Result checking work?
                     </button>
                  </h2>
                  <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#pricingFaq">
                     <div class="accordion-body text-muted">
                        Exwhyzee SP generates secure scratch cards / e-pins with usage limits (e.g. 5 checks per PIN). Parents and students enter the PIN on your portal to view results and download pdf transcripts.
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
