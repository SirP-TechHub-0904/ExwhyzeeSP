<!DOCTYPE html>
<html lang="zxx">
   <head>
      <!-- Standard Meta Tags -->
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="description" content="@(ViewData["MetaDescription"] ?? "Exwhyzee SP is Nigeria's premier school portal school portal & academic ERP platform with automated report cards, online admissions, CBT exam engines, and school fee reconciliation.")">
      <meta name="keywords" content="school management portal, automated report card, online admissions, cbt exams, school fees billing, student information system, nigerian school portal, exwhyzee sp, exwhyzee technologies">
      <meta name="author" content="Exwhyzee Technologies Ltd">
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
      <link rel="canonical" href="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />

      <!-- Open Graph / Facebook / WhatsApp Meta Tags -->
      <meta property="og:site_name" content="Exwhyzee SP - School Portal &amp; Academic ERP" />
      <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
      <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Exwhyzee SP" : "Exwhyzee SP | Unified Cloud School Portal & Academic ERP")" />
      <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Automate report cards, CBT exams, online student admissions, and school fees payment reconciliation with Exwhyzee School Portal.")" />
      <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
      <meta property="og:image" content="@(Context.Request.Scheme + "://" + Context.Request.Host + "/assets/images/hero-students.jpg")" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Exwhyzee SP Cloud Academic Portal" />
      <meta property="og:locale" content="en_US" />

      <!-- Twitter Card Meta Tags -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:site" content="@@exwhyzee_tech" />
      <meta name="twitter:creator" content="@@exwhyzee_tech" />
      <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Exwhyzee SP" : "Exwhyzee SP | Unified Cloud School Portal & Academic ERP")" />
      <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Automate report cards, CBT exams, online student admissions, and school fees payment reconciliation with Exwhyzee School Portal.")" />
      <meta name="twitter:image" content="@(Context.Request.Scheme + "://" + Context.Request.Host + "/assets/images/hero-students.jpg")" />

      <!-- JSON-LD Structured Data Schema -->
      <script type="application/ld+json">
      {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Exwhyzee School Portal (Exwhyzee SP)",
        "operatingSystem": "Web Browser, iOS, Android",
        "applicationCategory": "EducationalApplication",
        "offers": {
          "@@type": "Offer",
          "price": "0",
          "priceCurrency": "NGN"
        },
        "publisher": {
          "@@type": "Organization",
          "name": "Exwhyzee Technologies Ltd",
          "url": "https://www.exwhyzee.ng",
          "logo": "https://exwhyzee.ng/img/exwhyzeesp-logo.jpg",
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+234-800-EXWHYZEE",
            "contactType": "Customer Support",
            "availableLanguage": ["English"]
          }
        },
        "description": "Enterprise cloud school management ERP with automated terminal report card generation, online admissions, student CBT testing, and fee reconciliation."
      }
      </script>

      @await RenderSectionAsync("MetaTags", required: false)

      <!-- Page Title -->
      <title>@(ViewData["Title"] ?? "Unified School Management Platform") - Exwhyzee SP</title>
      <!-- Favicon Icon -->
      <link rel="shortcut icon" type="image/x-icon" href="/img/icon-exwhyzeesp.jpg?v=2">
      <link rel="icon" type="image/jpeg" href="/img/icon-exwhyzeesp.jpg?v=2">
      <link rel="apple-touch-icon" href="/img/icon-exwhyzeesp.jpg?v=2">
