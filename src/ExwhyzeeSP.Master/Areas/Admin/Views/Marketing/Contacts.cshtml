@model IEnumerable<ExwhyzeeSP.Core.Models.MarketingContact>
@{
    ViewData["Title"] = "Marketing Audience & Contacts";
    Layout = "_AdminLayout";

    var distinctTags = ViewBag.DistinctTags as List<string> ?? new();
    string selectedTag = ViewBag.Tag ?? "All";
    string search = ViewBag.Search ?? "";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<div class="space-y-6">

    <!-- Page Header & Action Toolbar -->
    <div class="w-full flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">Marketing Audience Contacts</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] border border-[var(--color-primary-500)]/20">
                    @totalCount contacts
                </span>
            </div>
            <p class="text-xs sm:text-[13px] text-[var(--text-secondary)] mt-0.5">
                Verified school proprietors, bursars, principals, and decision-makers in your CRM database.
            </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 ms-auto flex-wrap">
            <a asp-action="ExportContacts" asp-route-tag="@selectedTag" class="btn btn-outline border-emerald-500/30 text-emerald-600 hover:bg-emerald-500/10 text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none transition-colors">
                <i class="icon-download text-[14px]"></i>
                <span>Export to Excel</span>
            </a>
            <a asp-action="Import" class="btn btn-outline border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)] text-xs font-semibold px-3 py-2 flex items-center gap-1.5 rounded-xl shadow-sm text-decoration-none transition-colors">
                <i class="icon-upload text-[14px]"></i>
                <span>Import Leads</span>
            </a>
            <button type="button" class="btn btn-primary text-xs font-semibold px-4 py-2 flex items-center gap-1.5 rounded-xl shadow-sm" data-bs-toggle="modal" data-bs-target="#addContactModal">
                <i class="icon-plus text-[14px]"></i>
                <span>Add Contact</span>
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs font-semibold">
                <i class="icon-check-circle text-[18px] shrink-0"></i>
                <div>@Html.Raw(TempData["SuccessMessage"])</div>
            </div>
            <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2.5 text-xs font-semibold">
                <i class="icon-alert-triangle text-[18px] shrink-0"></i>
                <div>@Html.Raw(TempData["ErrorMessage"])</div>
            </div>
            <button type="button" class="text-rose-600 dark:text-rose-400 hover:opacity-75" onclick="this.parentElement.remove();">&times;</button>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="surface-card p-3.5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm">
        <form method="get" asp-action="Contacts" class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
            
            <!-- Search Input -->
            <div class="relative flex-1">
                <span class="absolute start-3.5 top-1/2 -translate-y-1/2 text-[var(--text-tertiary)] pointer-events-none">
                    <i class="icon-search text-[14px]"></i>
                </span>
                <input type="text" name="search" value="@search" class="w-full h-10 ps-10 pe-3 rounded-xl text-xs sm:text-[13px] bg-[var(--surface-sunken)] border border-[var(--border-subtle)] focus:outline-none focus:border-[var(--color-primary-500)] text-[var(--text-primary)] transition-all" placeholder="Search by name, email, school, role, or state..." />
            </div>

            <!-- Tag Segment Filter -->
            <div class="w-full md:w-64">
                <select name="tag" class="w-full h-10 px-3 rounded-xl text-xs sm:text-[13px] bg-[var(--surface-sunken)] border border-[var(--border-subtle)] focus:outline-none focus:border-[var(--color-primary-500)] text-[var(--text-primary)] transition-all" onchange="this.form.submit()">
                    <option value="All" selected="@(selectedTag == "All")">All Audience Segments</option>
                    @foreach (var t in distinctTags)
                    {
                        <option value="@t" selected="@(selectedTag == t)">Tag: @t</option>
                    }
                </select>
            </div>

            <!-- Action Controls -->
            <div class="flex items-center gap-2 shrink-0">
                <button type="submit" class="btn btn-primary text-xs font-semibold h-10 px-4 rounded-xl flex items-center justify-center gap-1.5 shadow-sm">
                    <i class="icon-search text-[13px]"></i>
                    <span>Filter</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(search) || selectedTag != "All")
                {
                    <a asp-action="Contacts" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold h-10 px-3.5 rounded-xl flex items-center justify-center text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-decoration-none transition-colors">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Contacts Table Card -->
    <div class="surface-card rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] shadow-sm overflow-hidden">
        
        <!-- Quick Segment Chips Bar -->
        @if (distinctTags.Any())
        {
            <div class="px-5 py-3 border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)]/40 flex items-center gap-2 overflow-x-auto scroll-thin">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-tertiary)] shrink-0 me-1">Segments:</span>
                <a asp-action="Contacts" asp-route-tag="All" asp-route-search="@search" class="px-3 py-1 rounded-full text-xs font-semibold text-decoration-none transition-all shrink-0 @(selectedTag == "All" ? "bg-[var(--color-primary-600)] text-white shadow-sm" : "bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                    All Contacts
                </a>
                @foreach (var t in distinctTags)
                {
                    <a asp-action="Contacts" asp-route-tag="@t" asp-route-search="@search" class="px-3 py-1 rounded-full text-xs font-semibold text-decoration-none transition-all shrink-0 @(selectedTag == t ? "bg-[var(--color-primary-600)] text-white shadow-sm" : "bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)]")">
                        @t
                    </a>
                }
            </div>
        }

        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs align-middle border-collapse">
                    <thead>
                        <tr class="border-b border-[var(--border-subtle)] bg-[var(--surface-sunken)] text-[var(--text-tertiary)] uppercase font-semibold text-[11px] tracking-wider">
                            <th class="px-4 py-3.5 text-start">Contact &amp; School</th>
                            <th class="px-4 py-3.5 text-start">Email &amp; Phone</th>
                            <th class="px-4 py-3.5 text-start">Role / Title</th>
                            <th class="px-4 py-3.5 text-start">State</th>
                            <th class="px-4 py-3.5 text-start">Audience Tag</th>
                            <th class="px-4 py-3.5 text-start">Status</th>
                            <th class="px-4 py-3.5 text-start">Last Emailed</th>
                            <th class="px-4 py-3.5 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--border-subtle)]">
                        @foreach (var c in Model)
                        {
                            var initial = !string.IsNullOrWhiteSpace(c.FullName) ? c.FullName.Trim().Substring(0, 1).ToUpper() : (!string.IsNullOrWhiteSpace(c.Email) ? c.Email.Substring(0, 1).ToUpper() : "C");
                            <tr class="hover:bg-[var(--surface-sunken)]/50 transition-colors">
                                <!-- Contact & School -->
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="size-8 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 font-bold text-xs grid place-items-center shrink-0 border border-sky-500/20">
                                            @initial
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-bold text-[13px] text-[var(--text-primary)] truncate">
                                                @(string.IsNullOrWhiteSpace(c.FullName) ? "Unspecified Name" : c.FullName)
                                            </div>
                                            <div class="text-[11px] text-[var(--text-tertiary)] flex items-center gap-1 truncate mt-0.5">
                                                <i class="icon-school text-[11px]"></i>
                                                <span>@(string.IsNullOrWhiteSpace(c.SchoolName) ? "Independent Contact" : c.SchoolName)</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Email & Phone -->
                                <td class="px-4 py-3">
                                    <div class="flex flex-col gap-0.5">
                                        <a href="mailto:@c.Email" class="font-medium text-[var(--color-primary-600)] hover:underline flex items-center gap-1.5 text-decoration-none truncate" title="Send Email">
                                            <i class="icon-mail text-[12px] opacity-75"></i>
                                            <span>@c.Email</span>
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(c.PhoneNumber))
                                        {
                                            <span class="text-[11px] text-[var(--text-tertiary)] flex items-center gap-1.5">
                                                <i class="icon-phone text-[11px] opacity-75"></i>
                                                <span>@c.PhoneNumber</span>
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Role / Title -->
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11.5px] font-medium bg-[var(--surface-sunken)] text-[var(--text-secondary)] border border-[var(--border-subtle)]">
                                        <i class="icon-user text-[11px] text-[var(--text-tertiary)]"></i>
                                        <span>@(string.IsNullOrWhiteSpace(c.RoleTitle) ? "Educator" : c.RoleTitle)</span>
                                    </span>
                                </td>

                                <!-- State -->
                                <td class="px-4 py-3 text-[var(--text-secondary)]">
                                    @if (!string.IsNullOrWhiteSpace(c.State))
                                    {
                                        <span class="inline-flex items-center gap-1 text-[11.5px]">
                                            <i class="icon-map-pin text-[11px] text-[var(--text-tertiary)]"></i>
                                            <span>@c.State</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[var(--text-tertiary)]">-</span>
                                    }
                                </td>

                                <!-- Tag -->
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
                                        <i class="icon-tag text-[10px]"></i>
                                        <span>@c.Tag</span>
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="px-4 py-3">
                                    @if (c.IsSubscribed)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                            <span>Subscribed</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                                            <span class="size-1.5 rounded-full bg-rose-500"></span>
                                            <span>Unsubscribed</span>
                                        </span>
                                    }
                                </td>

                                <!-- Last Emailed -->
                                <td class="px-4 py-3 text-[var(--text-tertiary)] text-[11.5px]">
                                    @if (c.LastEmailedUtc.HasValue)
                                    {
                                        <span class="flex items-center gap-1">
                                            <i class="icon-calendar text-[11px]"></i>
                                            <span>@c.LastEmailedUtc.Value.ToString("MMM d, yyyy")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[var(--text-tertiary)] italic">Never</span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="px-4 py-3 text-end">
                                    <div class="inline-flex items-center justify-end gap-1.5">
                                        <!-- Toggle Subscription Button -->
                                        <form method="post" asp-action="ToggleSubscription" asp-route-id="@c.Id" class="inline-block m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="grid place-items-center size-8 rounded-lg @(c.IsSubscribed ? "text-amber-600 hover:bg-amber-500/10" : "text-emerald-600 hover:bg-emerald-500/10") transition-colors border border-[var(--border-subtle)] bg-[var(--surface-raised)]" title="@(c.IsSubscribed ? "Unsubscribe Contact" : "Re-subscribe Contact")">
                                                <i class="@(c.IsSubscribed ? "icon-bell-off" : "icon-bell") text-[14px]"></i>
                                            </button>
                                        </form>

                                        <!-- Delete Contact Button -->
                                        <form method="post" asp-action="DeleteContact" asp-route-id="@c.Id" onsubmit="return confirm('Are you sure you want to permanently delete this contact (@(c.FullName ?? c.Email))?');" class="inline-block m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="grid place-items-center size-8 rounded-lg text-rose-600 hover:bg-rose-500/10 transition-colors border border-[var(--border-subtle)] bg-[var(--surface-raised)]" title="Delete Contact">
                                                <i class="icon-trash-2 text-[14px]"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Table Pagination -->
            @if (totalPages > 1)
            {
                <div class="px-5 py-3.5 border-t border-[var(--border-subtle)] bg-[var(--surface-sunken)]/30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
                    <span class="text-[var(--text-tertiary)]">
                        Showing page <strong class="text-[var(--text-primary)]">@currentPage</strong> of <strong class="text-[var(--text-primary)]">@totalPages</strong> (<strong class="text-[var(--text-primary)]">@totalCount</strong> total contacts)
                    </span>
                    <nav class="flex items-center gap-1" aria-label="Page navigation">
                        <a asp-action="Contacts" asp-route-tag="@selectedTag" asp-route-search="@search" asp-route-page="@(currentPage - 1)" class="px-3 py-1.5 rounded-lg text-decoration-none font-medium border border-[var(--border-subtle)] @(currentPage == 1 ? "opacity-50 pointer-events-none bg-[var(--surface-sunken)] text-[var(--text-tertiary)]" : "bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)]")">
                            Previous
                        </a>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <a asp-action="Contacts" asp-route-tag="@selectedTag" asp-route-search="@search" asp-route-page="@p" class="size-8 rounded-lg text-decoration-none font-semibold grid place-items-center @(currentPage == p ? "bg-[var(--color-primary-600)] text-white shadow-sm" : "bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] hover:bg-[var(--surface-sunken)]")">
                                @p
                            </a>
                        }
                        <a asp-action="Contacts" asp-route-tag="@selectedTag" asp-route-search="@search" asp-route-page="@(currentPage + 1)" class="px-3 py-1.5 rounded-lg text-decoration-none font-medium border border-[var(--border-subtle)] @(currentPage == totalPages ? "opacity-50 pointer-events-none bg-[var(--surface-sunken)] text-[var(--text-tertiary)]" : "bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-sunken)]")">
                            Next
                        </a>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-12 px-4 space-y-3">
                <div class="size-12 rounded-full bg-[var(--surface-sunken)] text-[var(--text-tertiary)] grid place-items-center mx-auto">
                    <i class="icon-users text-[24px]"></i>
                </div>
                <h4 class="text-sm font-bold text-[var(--text-primary)]">No contacts found</h4>
                <p class="text-xs text-[var(--text-secondary)] max-w-sm mx-auto">
                    No matching contacts were found for your current search and segment filters.
                </p>
                <div class="flex items-center justify-center gap-2 pt-2">
                    @if (!string.IsNullOrWhiteSpace(search) || selectedTag != "All")
                    {
                        <a asp-action="Contacts" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-3 py-1.5 rounded-lg text-decoration-none">
                            Clear Filters
                        </a>
                    }
                    <a asp-action="Import" class="btn btn-primary text-xs font-semibold px-3 py-1.5 rounded-lg text-decoration-none">
                        Import Spreadsheet
                    </a>
                </div>
            </div>
        }
    </div>

</div>

<!-- Modal: Add Single Contact -->
<div class="modal fade" id="addContactModal" tabindex="-1" aria-labelledby="addContactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] shadow-2xl rounded-2xl">
            <form method="post" asp-action="AddContact">
                @Html.AntiForgeryToken()
                <div class="modal-header px-5 py-4 border-b border-[var(--border-subtle)] flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="size-8 rounded-lg bg-[var(--color-primary-500)]/10 text-[var(--color-primary-600)] grid place-items-center">
                            <i class="icon-user-plus text-[16px]"></i>
                        </div>
                        <h5 class="modal-title text-base font-bold" id="addContactModalLabel">Add Audience Contact</h5>
                    </div>
                    <button type="button" class="text-[var(--text-tertiary)] hover:text-[var(--text-primary)] text-xl" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body p-5 space-y-4 text-xs">
                    <div>
                        <label class="block font-semibold text-[var(--text-primary)] mb-1">Email Address <span class="text-rose-500">*</span></label>
                        <input type="email" name="Email" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" required placeholder="proprietor@school.edu.ng" />
                    </div>
                    <div>
                        <label class="block font-semibold text-[var(--text-primary)] mb-1">Full Name</label>
                        <input type="text" name="FullName" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" placeholder="e.g. Chief / Dr. / Mrs. Kehinde Adeleke" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-[var(--text-primary)] mb-1">Phone Number</label>
                            <input type="text" name="PhoneNumber" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" placeholder="08012345678" />
                        </div>
                        <div>
                            <label class="block font-semibold text-[var(--text-primary)] mb-1">Role / Title</label>
                            <input type="text" name="RoleTitle" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" placeholder="Proprietor / Principal" />
                        </div>
                    </div>
                    <div>
                        <label class="block font-semibold text-[var(--text-primary)] mb-1">School / Institution Name</label>
                        <input type="text" name="SchoolName" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" placeholder="e.g. Beacon Hill Academy" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-[var(--text-primary)] mb-1">State / City</label>
                            <input type="text" name="State" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" placeholder="Lagos, Abuja, Ogun..." />
                        </div>
                        <div>
                            <label class="block font-semibold text-[var(--text-primary)] mb-1">Audience Tag</label>
                            <input type="text" name="Tag" class="w-full h-10 px-3 rounded-xl bg-[var(--surface-sunken)] border border-[var(--border-subtle)] text-[var(--text-primary)] focus:outline-none focus:border-[var(--color-primary-500)] transition-all" value="Prospects" placeholder="e.g. Prospects" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-5 py-3.5 border-t border-[var(--border-subtle)] flex items-center justify-end gap-2">
                    <button type="button" class="btn btn-outline border-[var(--border-subtle)] text-xs font-semibold px-4 py-2 rounded-xl text-[var(--text-secondary)]" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary text-xs font-semibold px-5 py-2 rounded-xl shadow-sm">Save Contact</button>
                </div>
            </form>
        </div>
    </div>
</div>
